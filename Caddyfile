www.touslesmatchs.com {
    # API proxy — must be checked BEFORE try_files rewrites the path
    handle /api/* {
        uri strip_prefix /api
        reverse_proxy api:3001
    }

    # Frontend statique — try_files only applies here, never touches /api/*
    handle {
        root * /srv
        encode gzip

        @static path *.js *.css *.png *.jpg *.jpeg *.webp *.svg *.ico *.woff2
        header @static Cache-Control "public, max-age=86400"

        @html path / *.html
        header @html Cache-Control "no-store, max-age=0"

        @manifest path /manifest.json
        header @manifest Cache-Control "no-cache, max-age=0"

        try_files {path} {path}.html /index.html
        file_server
    }
}

touslesmatchs.com {
    redir https://www.touslesmatchs.com{uri} permanent
}
