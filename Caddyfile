www.touslesmatchs.com {
    # ── Headers de sécurité (appliqués à toutes les réponses) ────────────────
    # HSTS : force HTTPS pendant 1 an, tous sous-domaines inclus
    # X-Content-Type-Options : empêche le MIME-sniffing (protection XSS)
    # X-Frame-Options : empêche l'inclusion en iframe (protection clickjacking)
    # Referrer-Policy : ne transmet pas l'URL complète aux domaines tiers
    # Permissions-Policy : coupe l'accès aux capteurs sensibles par défaut
    # CSP : whitelist stricte des sources autorisées (à ajuster si besoin)
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options    "nosniff"
        X-Frame-Options           "SAMEORIGIN"
        Referrer-Policy           "strict-origin-when-cross-origin"
        Permissions-Policy        "camera=(), microphone=(), geolocation=(), payment=(self)"
        Content-Security-Policy   "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://js.stripe.com https://www.googletagmanager.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://unpkg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: https: blob:; connect-src 'self' https://api.stripe.com https://www.google-analytics.com; frame-src https://js.stripe.com https://www.tiktok.com https://t.me; base-uri 'self'; form-action 'self' https://checkout.stripe.com"
        # Cache l'entête Server qui divulgue la version Caddy
        -Server
    }

    # API proxy vers le backend
    handle /api/* {
        uri strip_prefix /api
        reverse_proxy api:3001
    }

    # Routes API directes (sans prefixe /api)
    handle /live-matches {
        reverse_proxy api:3001
    }
    handle /current-pick {
        reverse_proxy api:3001
    }
    # Pages SEO dynamiques (pronostics) servies par l'API
    handle /pronostics {
        reverse_proxy api:3001
    }
    handle /signaux-sportifs-ia {
        reverse_proxy api:3001
    }
    handle /pronostic/* {
        reverse_proxy api:3001
    }
    handle /sitemap-pronostics.xml {
        reverse_proxy api:3001
    }
    handle /signal-fort-stats {
        reverse_proxy api:3001
    }
    handle /admin/* {
        reverse_proxy api:3001
    }
    handle /t {
        reverse_proxy api:3001
    }
    # Lien bio TikTok traqué -> redirige vers Telegram gratuit (voir /go/tiktok
    # dans api_server.js). Sans cette route, Caddy servirait le fallback SPA
    # (index.html) au lieu de router vers l'API, et rien ne se tracerait.
    handle /go/* {
        reverse_proxy api:3001
    }
    handle /create-checkout-session {
        reverse_proxy api:3001
    }
    handle /stripe/webhook {
        reverse_proxy api:3001
    }

    # Frontend statique
    handle {
        root * /srv
        try_files {path} {path}.html /index.html
        file_server
        encode gzip
    }
}

touslesmatchs.com {
    redir https://www.touslesmatchs.com{uri} permanent
}
