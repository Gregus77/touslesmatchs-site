www.touslesmatchs.com {
    encode gzip

    handle /api/* {
        reverse_proxy api:3001
    }

    handle /propfirms/api/* {
        uri strip_prefix /propfirms
        reverse_proxy 172.17.0.1:3002
    }

    handle /propfirms* {
        uri strip_prefix /propfirms
        reverse_proxy propfirms-site:80
    }

    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}

touslesmatchs.com {
    redir https://www.touslesmatchs.com{uri} permanent
}
