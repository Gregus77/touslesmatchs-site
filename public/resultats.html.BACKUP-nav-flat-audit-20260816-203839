<style>
:root{
  --bg:#06080f;
  --bg2:#0d1020;
  --bg3:#141828;
  --bg4:#1c2236;
  --b1:rgba(255,255,255,.05);
  --b2:rgba(255,255,255,.09);
  --b3:rgba(255,255,255,.14);
  --text:#eceaf4;
  --muted:#7b82a0;
  --muted2:#a8aec8;
  --indigo:#4f46e5;
  --indigo2:#6366f1;
  --violet:#7c3aed;
  --violet2:#9333ea;
  --cyan:#22d3ee;
  --cyan2:#06b6d4;
  --blue:#3b82f6;
  --green:#10b981;
  --red:#f43f5e;
  --amber:#f59e0b;
  --pink:#ec4899;
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{background:var(--bg);color:var(--text);font-family:'Inter',system-ui,sans-serif;overflow-x:hidden;-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale}

/* Mesh background */
.mesh{position:fixed;inset:0;z-index:0;pointer-events:none;
  background:
    radial-gradient(ellipse 80% 60% at 15% 20%,rgba(79,70,229,.13) 0%,transparent 55%),
    radial-gradient(ellipse 60% 50% at 85% 15%,rgba(34,211,238,.10) 0%,transparent 55%),
    radial-gradient(ellipse 50% 70% at 50% 80%,rgba(124,58,237,.08) 0%,transparent 60%),
    radial-gradient(ellipse 40% 40% at 75% 60%,rgba(99,102,241,.06) 0%,transparent 50%);
  animation:mesh-drift 16s ease-in-out infinite alternate;
}
@keyframes mesh-drift{
  0%{opacity:.8;transform:scale(1)}
  100%{opacity:1;transform:scale(1.03) rotate(.4deg)}
}

/* Nav */
nav{
  position:fixed;top:0;left:0;right:0;z-index:200;
  display:flex;align-items:center;justify-content:space-between;
  padding:0 40px;height:60px;
  background:rgba(6,8,15,.75);
  border-bottom:1px solid var(--b1);
  backdrop-filter:blur(20px) saturate(180%);
  -webkit-backdrop-filter:blur(20px) saturate(180%);
}
.nav-brand{
  font-size:16px;font-weight:800;letter-spacing:-.02em;
  background:linear-gradient(135deg,#fff 40%,var(--cyan) 100%);
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;
  background-clip:text;text-decoration:none;
}
.nav-center{display:flex;align-items:center;gap:6px}
.nav-center a{
  font-size:13px;color:var(--muted2);text-decoration:none;
  padding:6px 16px;border-radius:8px;font-weight:500;
  transition:all .15s;
}
.nav-center a:hover{color:var(--text);background:rgba(255,255,255,.06)}
.nav-center a.active{color:var(--text);background:rgba(99,102,241,.12);color:var(--indigo2)}
.nav-right{display:flex;align-items:center;gap:10px}
.nav-cta{
  font-size:13px;font-weight:700;
  padding:8px 20px;border-radius:9px;
  background:linear-gradient(135deg,var(--indigo),var(--violet));
  color:#fff;border:none;cursor:pointer;
  text-decoration:none;display:inline-block;
  box-shadow:0 4px 20px rgba(79,70,229,.3);
  transition:all .2s;
}
.nav-cta:hover{box-shadow:0 6px 28px rgba(79,70,229,.5);transform:translateY(-1px)}
.nav-live-pill{
  display:flex;align-items:center;gap:7px;
  font-size:12px;font-weight:600;
  background:rgba(244,63,94,.1);
  border:1px solid rgba(244,63,94,.25);
  color:#fb7185;
  padding:6px 14px;border-radius:20px;
  text-decoration:none;transition:all .2s;
}
.nav-live-pill:hover{background:rgba(244,63,94,.18);border-color:rgba(244,63,94,.4)}
.nav-live-dot{width:6px;height:6px;background:#f43f5e;border-radius:50%;animation:pulse-red 1.2s infinite}
@keyframes pulse-red{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.4;transform:scale(.8)}}

/* Main */
main{position:relative;z-index:1;max-width:1200px;margin:0 auto;padding:90px 30px 60px}

.page-header{margin-bottom:36px}
.page-header h1{font-size:28px;font-weight:800;letter-spacing:-.03em;margin-bottom:8px}
.page-header p{color:var(--muted2);font-size:14px;line-height:1.6}
.page-header .breadcrumb{display:flex;gap:8px;font-size:12px;color:var(--muted);margin-bottom:16px}
.page-header .breadcrumb a{color:var(--indigo2);text-decoration:none}
.page-header .breadcrumb a:hover{text-decoration:underline}

/* Stats bar */
.stats-bar{display:flex;gap:24px;flex-wrap:wrap;margin-bottom:28px;padding:20px 24px;
  background:var(--bg2);border:1px solid var(--b1);border-radius:12px}
.stat-item{text-align:center;flex:1;min-width:80px}
.stat-value{font-size:24px;font-weight:800;color:var(--text)}
.stat-value.green{color:var(--green)}
.stat-value.red{color:var(--red)}
.stat-value.amber{color:var(--amber)}
.stat-label{font-size:11px;color:var(--muted);letter-spacing:.05em;margin-top:2px}

/* Filters */
.filters-bar{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:20px;align-items:center}
.filter-group{display:flex;gap:6px;flex-wrap:wrap;align-items:center}
.filter-label{font-size:11px;color:var(--muted);font-weight:600;letter-spacing:.05em;margin-right:4px}
.filter-btn{
  font-size:12px;padding:6px 14px;border-radius:8px;
  background:transparent;border:1px solid var(--b1);color:var(--muted2);
  cursor:pointer;font-family:'Inter',system-ui,sans-serif;font-weight:500;
  transition:all .15s;
}
.filter-btn:hover{border-color:var(--b2);color:var(--text)}
.filter-btn.active{background:rgba(99,102,241,.12);border-color:rgba(99,102,241,.3);color:var(--indigo2)}
.filter-btn.win.active{background:rgba(16,185,129,.12);border-color:rgba(16,185,129,.3);color:var(--green)}
.filter-btn.loss.active{background:rgba(244,63,94,.12);border-color:rgba(244,63,94,.3);color:var(--red)}

/* Chart */
.chart-container{background:var(--bg2);border:1px solid var(--b1);border-radius:12px;padding:20px;margin-bottom:28px}
.chart-container h3{font-size:13px;color:var(--muted);font-weight:600;margin-bottom:14px;letter-spacing:.05em}
.chart-wrapper{position:relative;height:220px}

/* Table */
.table-container{overflow-x:auto;margin-bottom:40px}
.day-group{margin-bottom:16px}
.day-header{
  display:flex;justify-content:space-between;align-items:center;
  padding:10px 14px;background:var(--bg2);border:1px solid var(--b1);
  border-radius:8px 8px 0 0;font-size:13px;font-weight:600;color:var(--muted2)
}
.day-header .day-total{font-size:12px;color:var(--muted)}
.day-header .day-total .w{color:var(--green)}
.day-header .day-total .l{color:var(--red)}
.match-table{width:100%;border-collapse:collapse;font-size:13px;background:rgba(13,16,32,.5);border:1px solid var(--b1);border-top:none}
.match-table th{
  text-align:left;padding:10px 14px;font-size:10px;color:var(--muted);
  letter-spacing:.08em;font-weight:600;text-transform:uppercase;
  border-bottom:1px solid var(--b1);background:rgba(255,255,255,.02)
}
.match-table td{padding:10px 14px;border-bottom:1px solid rgba(255,255,255,.03);vertical-align:middle}
.match-table tr:last-child td{border-bottom:none}
.match-table tr:hover{background:rgba(255,255,255,.02)}
.match-link{color:var(--indigo2);text-decoration:none;font-weight:500}
.match-link:hover{text-decoration:underline}
.result-badge{
  display:inline-block;padding:3px 10px;border-radius:6px;font-size:11px;font-weight:700;
}
.result-win{background:rgba(16,185,129,.12);color:var(--green);border:1px solid rgba(16,185,129,.2)}
.result-loss{background:rgba(244,63,94,.12);color:var(--red);border:1px solid rgba(244,63,94,.2)}
.result-pending{background:rgba(245,158,11,.1);color:var(--amber);border:1px solid rgba(245,158,11,.2)}
.competition-tag{font-size:11px;color:var(--muted);background:rgba(255,255,255,.04);padding:2px 8px;border-radius:4px}
.gain-pos{color:var(--green);font-weight:700}
.gain-neg{color:var(--red);font-weight:700}

/* Loading / Empty */
.loading-state,.empty-state{
  text-align:center;padding:60px 20px;color:var(--muted);font-size:14px
}
.loading-spinner{display:inline-block;width:32px;height:32px;border:3px solid var(--b2);border-top-color:var(--indigo2);border-radius:50%;animation:spin .8s linear infinite;margin-bottom:12px}
@keyframes spin{to{transform:rotate(360deg)}}

/* Load more */
.load-more-wrap{text-align:center;padding:20px 0}
.load-more-btn{
  padding:10px 28px;border-radius:9px;font-size:13px;font-weight:600;
  background:rgba(99,102,241,.1);border:1px solid rgba(99,102,241,.2);
  color:var(--indigo2);cursor:pointer;font-family:'Inter',system-ui,sans-serif;
  transition:all .15s;
}
.load-more-btn:hover{background:rgba(99,102,241,.18);border-color:rgba(99,102,241,.3)}
.load-more-btn:disabled{opacity:.4;cursor:default}

/* Footer */
footer{
  position:relative;z-index:1;border-top:1px solid var(--b1);
  padding:28px 30px;text-align:center;max-width:1200px;margin:0 auto
}
.footer-links{display:flex;justify-content:center;gap:20px;flex-wrap:wrap;margin-bottom:12px}
.footer-links a{color:var(--muted);font-size:12px;text-decoration:none}
.footer-links a:hover{color:var(--text)}
.footer-copy{font-size:11px;color:var(--muted2);opacity:.5}

/* Mobile */
@media(max-width:768px){
  nav{padding:0 16px;height:54px}
  .nav-center{display:none}
  .nav-cta{padding:7px 14px;font-size:12px}
  main{padding:74px 16px 40px}
  .page-header h1{font-size:22px}
  .stats-bar{gap:12px;padding:14px 16px}
  .stat-value{font-size:18px}
  .match-table{font-size:12px}
  .match-table th,.match-table td{padding:8px 10px}
  .chart-wrapper{height:160px}
  .day-header{font-size:12px;padding:8px 12px}
  .filters-bar{gap:6px}
}

/* Scrollbar */
::-webkit-scrollbar{width:6px;height:6px}
::-webkit-scrollbar-track{background:var(--bg)}
::-webkit-scrollbar-thumb{background:var(--b2);border-radius:3px}
::-webkit-scrollbar-thumb:hover{background:var(--b3)}
