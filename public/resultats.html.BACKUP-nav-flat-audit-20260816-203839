<script>
// ── State ──────────────────────────────────────────────────────────────────────
const state = {
  allAnalyses: [],
  filtered: [],
  limit: 100,
  offset: 0,
  filterResult: 'all',
  filterLeague: 'all',
  leagues: new Set(),
  chart: null
};

// ── Helpers ────────────────────────────────────────────────────────────────────
function sportEmoji(s) {
  if (!s) return '⚽ ';
  s = s.toLowerCase();
  if (s.includes('foot') || s.includes('soccer')) return '⚽ ';
  if (s.includes('hockey')) return '🏒 ';
  if (s.includes('basket')) return '🏀 ';
  if (s.includes('baseball')) return '⚾ ';
  if (s.includes('tennis')) return '🎾 ';
  return '🎯 ';
}

function formatDate(d) {
  if (!d) return '';
  const dt = new Date(d + (d.includes('T') ? '' : 'T00:00:00'));
  return dt.toLocaleDateString('fr-FR', { day: '2-digit', month: 'short', year: 'numeric' });
}

function formatDateShort(d) {
  if (!d) return '';
  const dt = new Date(d + (d.includes('T') ? '' : 'T00:00:00'));
  return dt.toLocaleDateString('fr-FR', { day: '2-digit', month: 'short' });
}

function getDateKey(d) {
  if (!d) return '';
  return (d || '').slice(0, 10);
}

function estimateGain(outcome, cote) {
  if (outcome === 'win') return cote ? (cote - 1).toFixed(2) : '1.00';
  if (outcome === 'loss') return '-1.00';
  return '—';
}

function getResultLabel(outcome) {
  if (outcome === 'win') return '<span class="result-badge result-win">✅ Gagné</span>';
  if (outcome === 'loss') return '<span class="result-badge result-loss">❌ Perdu</span>';
  return '<span class="result-badge result-pending">⏳ En cours</span>';
}

// ── Data loading ──────────────────────────────────────────────────────────────
async function loadData() {
  const container = document.getElementById('table-container');
  try {
    const res = await fetch('/api/analysis-history?limit=200&offset=0');
    const data = await res.json();
    if (!data.ok) throw new Error('API error');

    state.allAnalyses = data.analyses || [];
    state.totalCount = data.total || 0;

    // Collect unique leagues
    state.allAnalyses.forEach(a => {
      if (a.competition) state.leagues.add(a.competition);
    });

    // Render stats
    renderStats(data.stats);

    // Render league filter buttons
    renderLeagueFilters();

    // Apply filters and render
    applyFilters();

    // Build chart
    buildChart();

    // Show load more if needed
    document.getElementById('load-more-wrap').style.display = state.allAnalyses.length < state.totalCount ? 'block' : 'none';

  } catch (e) {
    container.innerHTML = '<div class="empty-state">❌ Erreur lors du chargement des données. Réessayez plus tard.</div>';
    console.error('[resultats] load error:', e);
  }
}

function renderStats(stats) {
  if (!stats) return;
  document.getElementById('stat-total').textContent = stats.total || 0;
  document.getElementById('stat-wins').textContent = stats.wins || 0;
  document.getElementById('stat-losses').textContent = stats.losses || 0;
  document.getElementById('stat-winrate').textContent = (stats.winrate || 0) + '%';
  
  // Estimate ROI: wins give (odd-1), losses give -1
  let totalInvested = 0;
  let totalReturn = 0;
  state.allAnalyses.forEach(a => {
    if (a.outcome === 'win' && a.cote) {
      totalInvested++;
      totalReturn += a.cote;
    } else if (a.outcome === 'loss') {
      totalInvested++;
    }
  });
  const roi = totalInvested > 0 ? (((totalReturn - totalInvested) / totalInvested) * 100).toFixed(1) : '0.0';
  document.getElementById('stat-roi').textContent = roi + '%';
}

function renderLeagueFilters() {
  const container = document.getElementById('league-filters');
  const sorted = Array.from(state.leagues).sort();
  
  // Limit to top 15 leagues + others
  const topLeagues = sorted.slice(0, 15);
  
  topLeagues.forEach(league => {
    const btn = document.createElement('button');
    btn.className = 'filter-btn';
    btn.textContent = league;
    btn.dataset.league = league;
    btn.onclick = function() { applyFilterLeague(this, league); };
    container.appendChild(btn);
  });
  
  if (sorted.length > 15) {
    const btn = document.createElement('button');
    btn.className = 'filter-btn';
    btn.textContent = 'Autres…';
    btn.dataset.league = 'other';
    btn.onclick = function() { applyFilterLeague(this, 'other'); };
    container.appendChild(btn);
  }
}

// ── Filtering ─────────────────────────────────────────────────────────────────
let currentResultFilter = 'all';
let currentLeagueFilter = 'all';

function applyFilters() {
  let filtered = state.allAnalyses;

  if (currentResultFilter !== 'all') {
    filtered = filtered.filter(a => a.outcome === currentResultFilter);
  }

  if (currentLeagueFilter === 'other') {
    const sorted = Array.from(state.leagues).sort();
    const top15 = new Set(sorted.slice(0, 15));
    filtered = filtered.filter(a => !top15.has(a.competition));
  } else if (currentLeagueFilter !== 'all') {
    filtered = filtered.filter(a => a.competition === currentLeagueFilter);
  }

  state.filtered = filtered;
  renderTable();
}

function applyFilterResult(btn, val) {
  currentResultFilter = (currentResultFilter === val) ? 'all' : val;
  document.querySelectorAll('[data-result]').forEach(b => b.classList.remove('active'));
  if (currentResultFilter !== 'all') btn.classList.add('active');
  else document.querySelector('[data-filter="all"]').classList.add('active');
  applyFilters();
}

function applyFilterLeague(btn, val) {
  currentLeagueFilter = (currentLeagueFilter === val) ? 'all' : val;
  document.querySelectorAll('[data-league]').forEach(b => b.classList.remove('active'));
  if (currentLeagueFilter !== 'all') btn.classList.add('active');
  else document.querySelector('[data-league="all"]').classList.add('active');
  applyFilters();
}

// ── Table rendering ───────────────────────────────────────────────────────────
function renderTable() {
  const container = document.getElementById('table-container');
  const items = state.filtered;

  if (!items.length) {
    container.innerHTML = '<div class="empty-state">Aucun résultat trouvé avec les filtres actuels.</div>';
    return;
  }

  // Group by day
  const groups = {};
  items.forEach(a => {
    const key = getDateKey(a.analysed_at);
    if (!groups[key]) groups[key] = { date: key, items: [], wins: 0, losses: 0 };
    groups[key].items.push(a);
    if (a.outcome === 'win') groups[key].wins++;
    else if (a.outcome === 'loss') groups[key].losses++;
  });

  // Sort days DESC
  const days = Object.keys(groups).sort().reverse();

  let html = '';
  days.forEach(day => {
    const g = groups[day];
    const winIcon = g.wins > 0 ? `<span class="w">✅ ${g.wins}</span>` : '';
    const lossIcon = g.losses > 0 ? `<span class="l">❌ ${g.losses}</span>` : '';
    const sep = g.wins > 0 && g.losses > 0 ? ' · ' : '';
    
    html += '<div class="day-group">';
    html += `<div class="day-header">
      <span>${formatDate(day)}</span>
      <span class="day-total">${winIcon}${sep}${lossIcon} · ${g.items.length} match${g.items.length > 1 ? 's' : ''}</span>
    </div>`;
    html += '<table class="match-table"><thead><tr>';
    html += '<th>Match</th><th>Compétition</th><th>Pronostic</th><th>Cote</th><th>Score</th><th>Résultat</th><th>Gain/Perte</th>';
    html += '</tr></thead><tbody>';

    g.items.forEach(a => {
      const matchName = `${a.home} vs ${a.away}`;
      const score = a.final_score || a.score || '—';
      const gain = estimateGain(a.outcome, a.cote);
      const gainClass = a.outcome === 'win' ? 'gain-pos' : (a.outcome === 'loss' ? 'gain-neg' : '');
      
      html += '<tr>';
      html += `<td><a href="/match/${a.id}" class="match-link">${sportEmoji(a.sport)}${matchName}</a></td>`;
      html += `<td><span class="competition-tag">${a.competition || '—'}</span></td>`;
      html += `<td style="color:var(--muted2)">${a.bet || '—'}</td>`;
      html += `<td style="color:var(--amber);font-weight:600">${a.cote ? a.cote.toFixed(2) : '—'}</td>`;
      html += `<td style="color:var(--muted)">${score}</td>`;
      html += `<td>${getResultLabel(a.outcome)}</td>`;
      html += `<td class="${gainClass}">${gain}</td>`;
      html += '</tr>';
    });

    html += '</tbody></table></div>';
  });

  container.innerHTML = html;
}

// ── Chart ─────────────────────────────────────────────────────────────────────
function buildChart() {
  const analyzed = state.allAnalyses.filter(a => a.outcome === 'win' || a.outcome === 'loss');
  
  // Sort by date ASC for cumulative
  const sorted = [...analyzed].sort((a, b) => {
    return (a.analysed_at || '').localeCompare(b.analysed_at || '');
  });

  const labels = [];
  const data = [];
  let cumul = 0;

  sorted.forEach((a, i) => {
    const label = formatDateShort(a.analysed_at);
    if (a.outcome === 'win') {
      cumul += (a.cote || 1) - 1;
    } else if (a.outcome === 'loss') {
      cumul -= 1;
    }
    labels.push(label + ' #' + (i+1));
    data.push(Math.round(cumul * 100) / 100);
  });

  if (!labels.length) {
    document.querySelector('.chart-wrapper').innerHTML = '<div style="text-align:center;padding:60px 0;color:var(--muted)">Pas assez de données pour afficher la courbe.</div>';
    return;
  }

  const ctx = document.getElementById('progressChart').getContext('2d');
  
  if (state.chart) {
    state.chart.destroy();
  }

  state.chart = new Chart(ctx, {
    type: 'line',
    data: {
      labels: labels,
      datasets: [{
        label: 'Unités cumulées',
        data: data,
        borderColor: '#4f46e5',
        backgroundColor: (ctx) => {
          const g = ctx.chart.ctx.createLinearGradient(0, 0, 0, 220);
          g.addColorStop(0, 'rgba(79,70,229,.25)');
          g.addColorStop(1, 'rgba(79,70,229,0)');
          return g;
        },
        fill: true,
        tension: 0.3,
        pointRadius: 2,
        pointHoverRadius: 5,
        borderWidth: 2
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: { display: false },
        tooltip: {
          backgroundColor: '#0d1020',
          borderColor: 'rgba(255,255,255,.1)',
          borderWidth: 1,
          titleColor: '#eceaf4',
          bodyColor: '#a8aec8',
          callbacks: {
            label: function(ctx) {
              const val = ctx.parsed.y;
              return val >= 0 ? '+' + val.toFixed(2) + ' unités' : val.toFixed(2) + ' unités';
            }
          }
        }
      },
      scales: {
        x: {
          display: false,
          grid: { display: false }
        },
        y: {
          grid: { color: 'rgba(255,255,255,.04)' },
          ticks: { color: '#7b82a0', font: { size: 10 } }
        }
      }
    }
  });
}

