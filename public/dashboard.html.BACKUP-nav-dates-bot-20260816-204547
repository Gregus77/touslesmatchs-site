<script id="tlm-navbar-safe-logo-js">
(function(){
  function addLogo(){
    if(document.querySelector('.tlm-brand-nav-logo')) return;
    var items=[].slice.call(document.querySelectorAll('a,div,span,strong,h1,h2'));
    var brand=items.find(function(el){
      if(!el || !el.textContent) return false;
      if(el.closest('script,style,head,title,meta')) return false;
      var text=el.textContent.replace(/\s+/g,'').toLowerCase();
      var box=el.getBoundingClientRect();
      return text.includes('touslesmatchs') && box.width>40 && box.height>8 && box.top>=0 && box.top<160;
    });
    if(brand){
      brand.insertAdjacentHTML('afterbegin','<img class="tlm-brand-nav-logo" src="/assets/brand/logo192.png?v=1786907124471" alt="TousLesMatchs">');
    }
  }
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',addLogo); else addLogo();
  setTimeout(addLogo,500);
})();
</script>
<script id="tlm-paid-analysis-gate-js">
(function(){
  if(window.__tlmPaidAnalysisGate)return; window.__tlmPaidAnalysisGate=1;
  function plan(){try{return String(localStorage.getItem("tlm_plan")||"").toLowerCase();}catch(e){return "";}}
  function token(){try{return localStorage.getItem("tlm_token")||localStorage.getItem("tlm_session")||"";}catch(e){return "";}}
  function hasAccess(){var p=plan();return !!token() && /(standard|premium|elite|vip|founder|fondateur|beta|goal05|admin)/i.test(p);}
  function ensureModal(){
    if(document.getElementById("tlm-paid-gate-modal"))return;
    var div=document.createElement("div");
    div.id="tlm-paid-gate-modal";
    div.innerHTML='<div class="tlm-paid-gate-card"><div class="tlm-paid-gate-badge">Analyse réservée</div><div class="tlm-paid-gate-title">Connexion requise</div><p class="tlm-paid-gate-text">Tu peux voir les matchs en direct. Pour ouvrir l’analyse, le pourcentage et la décision, il faut un accès actif TousLesMatchs.</p><div class="tlm-paid-gate-actions"><button class="tlm-paid-gate-login" type="button" id="tlm-gate-login">Se connecter</button><a class="tlm-paid-gate-pay" href="/#plans">Voir les abonnements</a></div><button type="button" id="tlm-gate-close" style="margin-top:10px;width:100%;background:transparent;border:none;color:#9ca3cf;font-weight:800">Fermer</button></div>';
    document.body.appendChild(div);
    document.getElementById("tlm-gate-close").onclick=function(){div.classList.remove("on");};
    document.getElementById("tlm-gate-login").onclick=function(){div.classList.remove("on");location.href="/app.html?tab=me";};
  }
  function showGate(){ensureModal();document.getElementById("tlm-paid-gate-modal").classList.add("on");}
  function target(el){return el&&el.closest&&el.closest("details.goal05-live-match,details[data-fixture],#live-box .item,#live-box details,.live-match,.match-card,.analysis-card,.prediction-card,[data-analysis],[data-signal],[data-match-id]");}
  document.addEventListener("click",function(e){
    var t=target(e.target);
    if(!t||hasAccess()||t.closest("#tlm-paid-gate-modal"))return;
    e.preventDefault();e.stopPropagation();e.stopImmediatePropagation();
    if(t.tagName==="DETAILS")t.open=false;
    showGate();
  },true);
  document.addEventListener("toggle",function(e){
    var d=e.target;
    if(d&&d.matches&&d.matches("details.goal05-live-match,details[data-fixture]")&&d.open&&!hasAccess()){
      d.open=false;showGate();
    }
  },true);
})();
</script>
