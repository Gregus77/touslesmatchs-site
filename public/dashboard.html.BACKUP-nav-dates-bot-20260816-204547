<style>
:root{
  --bg:#12152a;--bg2:#171b34;--bg3:#1e2340;--bg4:#262c4d;
  --b1:rgba(255,255,255,.11);--b2:rgba(255,255,255,.18);--b3:rgba(255,255,255,.24);
  --text:#f6f7ff;--muted:#949bc4;--muted2:#c4c9e6;
  --indigo:#4f46e5;--indigo2:#6366f1;--violet:#7c3aed;
  --cyan:#22d3ee;--green:#10b981;--red:#f43f5e;--amber:#f59e0b;
}
*{margin:0;padding:0;box-sizing:border-box}
html{-webkit-text-size-adjust:100%;text-size-adjust:100%}
body{background:var(--bg);color:var(--text);font-family:'Inter',system-ui,sans-serif;-webkit-font-smoothing:antialiased}

nav{position:fixed;top:0;left:0;right:0;z-index:200;display:flex;align-items:center;justify-content:space-between;padding:0 40px;height:60px;background:rgba(6,8,15,.75);border-bottom:1px solid var(--b1);backdrop-filter:blur(20px) saturate(180%)}
.nav-brand{font-size:16px;font-weight:800;letter-spacing:-.02em;color:var(--text);text-decoration:none}
.nav-links{display:flex;align-items:center;gap:6px}
.nav-links a{font-size:13px;color:#c4c9e6;text-decoration:none;padding:6px 16px;border-radius:8px;font-weight:500;transition:all .15s;display:inline-flex;align-items:center}
.nav-live-dot{display:inline-block;width:7px;height:7px;border-radius:50%;background:#f43f5e;margin-right:6px;animation:navPulseDot 1.5s infinite}
.nav-live-link{color:#22d3ee !important}
@keyframes navPulseDot{0%,100%{opacity:1;box-shadow:0 0 0 0 rgba(244,63,94,.6)}50%{opacity:.7;box-shadow:0 0 0 5px rgba(244,63,94,0)}}
.nav-links a:hover{color:#f6f7ff;background:rgba(255,255,255,.11)}
.nav-logout{font-size:13px;color:var(--muted);background:none;border:1px solid var(--b2);padding:6px 16px;border-radius:8px;cursor:pointer;transition:all .15s}
.nav-logout:hover{color:var(--red);border-color:rgba(244,63,94,.3)}

.page{max-width:960px;margin:0 auto;padding:100px 24px 60px}

/* Auth forms */
.auth-box{max-width:400px;margin:0 auto;padding-top:60px}
.auth-title{font-size:28px;font-weight:900;letter-spacing:-.03em;margin-bottom:8px;text-align:center}
.auth-sub{font-size:14px;color:var(--muted2);text-align:center;margin-bottom:32px}
.auth-card{background:var(--bg2);border:1px solid var(--b2);border-radius:18px;padding:28px;box-shadow:0 20px 60px rgba(0,0,0,.4)}
.auth-label{font-size:11px;font-weight:600;letter-spacing:.09em;text-transform:uppercase;color:var(--indigo2);margin-bottom:6px;display:block}
.auth-input{width:100%;background:rgba(255,255,255,.11);border:1px solid var(--b2);border-radius:9px;padding:12px 14px;color:var(--text);font-size:14px;font-family:inherit;margin-bottom:14px;box-sizing:border-box;transition:border-color .15s}
.auth-input:focus{outline:none;border-color:rgba(99,102,241,.5)}
.auth-btn{width:100%;padding:13px;border-radius:10px;font-size:14px;font-weight:700;background:linear-gradient(135deg,var(--indigo),var(--violet));color:#fff;border:none;cursor:pointer;box-shadow:0 6px 24px rgba(79,70,229,.3);transition:all .2s;margin-bottom:12px}
.auth-btn:hover{box-shadow:0 8px 32px rgba(79,70,229,.5);transform:translateY(-1px)}
.auth-btn:disabled{opacity:.5;cursor:not-allowed;transform:none}
.auth-err{font-size:12px;color:var(--red);margin-bottom:10px;display:none;text-align:center}
.auth-switch{font-size:13px;color:var(--muted2);text-align:center;margin-top:16px}
.auth-switch a{color:var(--cyan);cursor:pointer;text-decoration:none}

/* Dashboard */
.dash-header{margin-bottom:40px}
.dash-welcome{font-size:clamp(24px,3.5vw,36px);font-weight:900;letter-spacing:-.03em;margin-bottom:4px}
.dash-email{font-size:14px;color:var(--muted2)}
.dash-plan{display:inline-block;font-size:11px;font-weight:700;padding:4px 12px;border-radius:6px;margin-left:8px;text-transform:uppercase;letter-spacing:.06em}
.dash-plan.free{background:rgba(120,120,140,.1);color:var(--muted2);border:1px solid rgba(120,120,140,.2)}
.dash-plan.premium{background:rgba(99,102,241,.1);color:var(--indigo2);border:1px solid rgba(99,102,241,.25)}
.dash-plan.elite{background:rgba(124,58,237,.1);color:#c084fc;border:1px solid rgba(124,58,237,.25)}
.dash-status{display:inline-block;font-size:11px;font-weight:700;padding:4px 12px;border-radius:6px;margin-left:8px;text-transform:uppercase;letter-spacing:.06em}
.dash-status.active{background:rgba(16,185,129,.1);color:var(--green);border:1px solid rgba(16,185,129,.25)}
.dash-status.expired,.dash-status.cancelled{background:rgba(244,63,94,.1);color:var(--red);border:1px solid rgba(244,63,94,.25)}
.dash-renewal{font-size:12.5px;color:var(--muted);margin-top:8px}
.dash-actions{display:flex;gap:10px;flex-wrap:wrap;margin:20px 0 36px}
.dash-action-btn{background:var(--bg2);border:1px solid var(--b2);color:var(--text);font-family:inherit;font-size:13px;font-weight:700;padding:10px 16px;border-radius:10px;cursor:pointer;text-decoration:none;display:inline-flex;align-items:center;gap:6px;transition:border-color .15s}
.dash-action-btn:hover{border-color:rgba(99,102,241,.4)}

.kpi-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-bottom:40px}
.kpi{background:var(--bg2);border:1px solid var(--b2);border-radius:16px;padding:22px;text-align:center}
.kpi-val{font-size:32px;font-weight:900;letter-spacing:-.03em;line-height:1;margin-bottom:4px}
.kpi-lbl{font-size:11px;font-weight:600;color:var(--muted);letter-spacing:.07em;text-transform:uppercase}

.section-title{font-size:20px;font-weight:800;letter-spacing:-.02em;margin-bottom:16px}

.history-list{display:flex;flex-direction:column;gap:6px}
.h-item{display:grid;grid-template-columns:1fr auto;align-items:center;gap:12px;background:var(--bg2);border:1px solid var(--b2);border-radius:12px;padding:14px 18px}
.h-match{min-width:0}
.h-teams{font-size:14px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.h-meta{font-size:11px;color:var(--muted)}
.h-date{font-size:11px;color:var(--muted);white-space:nowrap}

.upgrade-box{background:linear-gradient(135deg,rgba(79,70,229,.1),rgba(34,211,238,.06));border:1px solid rgba(99,102,241,.25);border-radius:16px;padding:28px;text-align:center;margin-top:40px}
.upgrade-box h3{font-size:18px;font-weight:800;margin-bottom:8px}
.upgrade-box p{font-size:13px;color:var(--muted2);margin-bottom:18px}
.upgrade-btn{display:inline-flex;align-items:center;gap:8px;background:linear-gradient(135deg,var(--indigo),var(--violet));color:#fff;font-size:14px;font-weight:700;padding:12px 28px;border-radius:10px;text-decoration:none;box-shadow:0 4px 20px rgba(79,70,229,.3);transition:all .2s}
.upgrade-btn:hover{transform:translateY(-2px);box-shadow:0 8px 32px rgba(79,70,229,.5)}

.empty-state{text-align:center;color:var(--muted);padding:40px;font-size:14px}

/* Stats par palier */
.tier-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
.tc{background:var(--bg2);border:1px solid var(--b2);border-radius:16px;padding:20px;position:relative;overflow:hidden}
.tc.standard{border-color:rgba(16,185,129,.28)}
.tc.premium{border-color:rgba(99,102,241,.28)}
.tc.elite{border-color:rgba(124,58,237,.28)}
.tc-name{font-size:13px;font-weight:800;margin-bottom:14px;display:flex;align-items:center;gap:6px}
.tc-kpis{display:flex;gap:12px}
.tc-k{flex:1}
.tc-k .v{font-size:22px;font-weight:900;line-height:1;letter-spacing:-.02em}
.tc-k .l{font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:.05em;margin-top:4px}
.tc-body{transition:filter .2s}
.tc.locked .tc-body{filter:blur(7px);opacity:.45;pointer-events:none;user-select:none}
.tc-lock{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;background:rgba(6,8,15,.6);backdrop-filter:blur(1px);text-align:center;padding:16px}
.tc-lock .ico{font-size:20px}
.tc-lock .txt{font-size:12px;font-weight:700;color:var(--text);line-height:1.35}
.tc-lock a{margin-top:2px;font-size:11px;font-weight:700;color:#fff;background:linear-gradient(135deg,var(--indigo),var(--violet));padding:7px 16px;border-radius:8px;text-decoration:none}
.tier-note{font-size:12px;color:var(--muted);margin-top:12px;line-height:1.5}
@media(max-width:768px){.tier-cards{grid-template-columns:1fr}}

footer{border-top:1px solid var(--b1);padding:40px 32px;text-align:center;margin-top:60px}
.foot-text{font-size:12px;color:var(--muted);line-height:1.9;max-width:500px;margin:0 auto}

@media(max-width:768px){nav{padding:0 16px}.kpi-grid{grid-template-columns:1fr 1fr}}
@media(max-width:480px){.nav-links{display:none}.kpi-grid{grid-template-columns:1fr}}
</style>
