<body class="tlm-wow tlm-page-dashboard">

<nav>
  <a href="/" class="nav-brand">TousLesMatchs</a>
  <div class="nav-links">
    <a href="/">Accueil</a>
    <a href="/live-ia" class="nav-live-link"><span class="nav-live-dot"></span>Live IA</a>
    <a href="/performances">Performances</a>
    <a href="/dashboard" style="color:var(--text)">Mon espace</a>
  </div>
  <button class="nav-logout" id="nav-logout" style="display:none" onclick="logout()">Déconnexion</button>
</nav>

<div class="page">
  <!-- Auth (shown when not logged in) — email + code temporaire (OTP) -->
  <div id="auth-section" class="auth-box" style="display:none">
    <div class="auth-title">Mon espace</div>
    <div class="auth-sub" id="auth-sub">Entre ton email pour recevoir un code de connexion</div>
    <div class="auth-card">
      <div class="auth-err" id="auth-err"></div>
      <div class="auth-ok" id="auth-ok" style="font-size:12px;color:var(--green);margin-bottom:10px;display:none;text-align:center"></div>

      <div id="auth-step-email">
        <label class="auth-label">Email</label>
        <input class="auth-input" type="email" id="auth-email" placeholder="ton@email.com" autocomplete="email">
        <button class="auth-btn" id="auth-request-btn" onclick="requestOtp()">Recevoir mon code →</button>
      </div>

      <div id="auth-step-code" style="display:none">
        <label class="auth-label">Code reçu par email</label>
        <input class="auth-input" type="text" id="auth-code" placeholder="123456" autocomplete="one-time-code" inputmode="numeric" style="letter-spacing:.3em;text-align:center;font-size:20px;font-weight:800">
        <button class="auth-btn" id="auth-verify-btn" onclick="verifyOtp()">Se connecter →</button>
        <div class="auth-switch"><a onclick="backToEmailStep()">← Changer d'email / renvoyer un code</a></div>
      </div>
    </div>
  </div>

  <!-- Dashboard (shown when logged in) -->
  <div id="dash-section" style="display:none">
    <div class="dash-header">
      <div class="dash-welcome" id="dash-welcome">Mon espace</div>
      <div><span class="dash-email" id="dash-email"></span><span class="dash-plan" id="dash-plan"></span><span class="dash-status" id="dash-status"></span></div>
      <div class="dash-renewal" id="dash-renewal" style="display:none"></div>
    </div>

    <div class="dash-actions" id="dash-actions" style="display:none">
      <button class="dash-action-btn" id="telegram-btn" onclick="openTelegram()">📩 Rejoindre le canal Telegram</button>
      <button class="dash-action-btn" id="billing-btn" onclick="openBillingPortal()">⚙️ Gérer / résilier mon abonnement</button>
      <a class="dash-action-btn" href="/#plans">↗️ Changer d'offre</a>
    </div>

    <div class="kpi-grid">
      <div class="kpi"><div class="kpi-val" id="d-tokens" style="color:var(--cyan)">—</div><div class="kpi-lbl">Analyses restantes / jour</div></div>
      <div class="kpi"><div class="kpi-val" id="d-used" style="color:var(--indigo2)">—</div><div class="kpi-lbl">Analyses utilisées / jour</div></div>
      <div class="kpi"><div class="kpi-val" id="d-since" style="color:var(--green)">—</div><div class="kpi-lbl">Membre depuis</div></div>
    </div>

    <div class="section-title" style="margin-top:40px">Parraine un ami</div>
    <div style="background:var(--bg2);border:1px solid var(--b2);border-radius:16px;padding:22px">
      <div style="font-size:14px;color:var(--muted2);margin-bottom:14px">Chaque ami qui s'abonne grâce à ton lien vous offre <b style="color:var(--text)">30 jours gratuits à chacun</b>.</div>
      <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
        <input id="ref-link-input" readonly value="Chargement..." style="flex:1;min-width:200px;background:var(--bg);border:1px solid var(--b2);color:var(--text);padding:11px 14px;border-radius:9px;font-size:13px">
        <button class="dash-action-btn" id="ref-copy-btn" onclick="copyRefLink()">📋 Copier</button>
      </div>
      <div id="ref-stats" style="font-size:12px;color:var(--muted);margin-top:10px"></div>
    </div>

    <div class="section-title" style="margin-top:40px">Performance par palier</div>
    <div id="tier-cards" class="tier-cards">
      <div class="empty-state">Chargement...</div>
    </div>
    <div class="tier-note" id="tier-note"></div>

    <div class="section-title" style="margin-top:40px">Mes derniers résultats</div>
    <div id="recent-results" class="history-list">
      <div class="empty-state">Chargement...</div>
    </div>

    <div class="upgrade-box" id="upgrade-box" style="display:none">
      <h3>Passe au niveau supérieur</h3>
      <p id="upgrade-text">Débloque plus d'analyses par jour et les alertes Signal Fort.</p>
      <a href="/#plans" class="upgrade-btn">Voir les abonnements</a>
    </div>
  </div>
</div>

<footer>
  <div class="foot-text">
    <a href="/" style="color:var(--muted);text-decoration:none">TousLesMatchs</a> · Analyse sportive assistée par IA<br>
    <span style="opacity:.75;font-size:11px;margin-top:8px;display:block">18+ · Jeu responsable · <a href="https://www.joueurs-info-service.fr" target="_blank" style="color:var(--muted)">joueurs-info-service.fr</a></span>
  </div>
</footer>

<script>
// Connexion unifiée email + code temporaire (OTP) — même système que le
// reste du site (voir /auth/request-otp, /auth/verify-otp). L'ancien
// formulaire email + mot de passe (JWT, table `users`) est retiré : il
// n'était connecté à rien de réel (ni Brevo, ni Telegram, ni aux droits
// clients) — confirmé avant modification, cf. audit Phase 1.
var token = localStorage.getItem('tlm_session_token');
var pendingEmail = '';

function esc(s) {
  return String(s || '').replace(/[&<>"']/g, function(c) {
    return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];
  });
}

function showErr(msg) {
  document.getElementById('auth-ok').style.display = 'none';
  var el = document.getElementById('auth-err');
  el.textContent = msg;
  el.style.display = 'block';
}
function showOk(msg) {
  document.getElementById('auth-err').style.display = 'none';
  var el = document.getElementById('auth-ok');
  el.textContent = msg;
  el.style.display = 'block';
}

function requestOtp() {
  var email = document.getElementById('auth-email').value.trim().toLowerCase();
  if (!email || email.indexOf('@') === -1) return showErr('Entre une adresse email valide.');
  var btn = document.getElementById('auth-request-btn');
  btn.disabled = true; btn.textContent = 'Envoi...';
  fetch('/api/auth/request-otp', {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ email: email })
  }).then(function(r) { return r.json(); }).then(function(d) {
    btn.disabled = false; btn.textContent = 'Recevoir mon code →';
    if (!d.ok) return showErr(d.error || 'Erreur, réessaie.');
    pendingEmail = email;
    showOk('Code envoyé — vérifie ta boîte mail.');
    document.getElementById('auth-step-email').style.display = 'none';
    document.getElementById('auth-step-code').style.display = 'block';
    document.getElementById('auth-code').focus();
  }).catch(function() {
    btn.disabled = false; btn.textContent = 'Recevoir mon code →';
    showErr('Erreur réseau.');
  });
}

function backToEmailStep() {
  document.getElementById('auth-step-code').style.display = 'none';
  document.getElementById('auth-step-email').style.display = 'block';
  document.getElementById('auth-err').style.display = 'none';
  document.getElementById('auth-ok').style.display = 'none';
}

function verifyOtp() {
  var code = document.getElementById('auth-code').value.trim();
  if (!code) return showErr('Entre le code reçu par email.');
  var btn = document.getElementById('auth-verify-btn');
  btn.disabled = true; btn.textContent = 'Vérification...';
  fetch('/api/auth/verify-otp', {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ email: pendingEmail, code: code })
  }).then(function(r) { return r.json(); }).then(function(d) {
    btn.disabled = false; btn.textContent = 'Se connecter →';
    if (!d.ok) return showErr(d.error || 'Code invalide.');
    localStorage.setItem('tlm_session_token', d.token);
    token = d.token;
    loadDashboard();
  }).catch(function() {
    btn.disabled = false; btn.textContent = 'Se connecter →';
    showErr('Erreur réseau.');
  });
}

function logout() {
  var t = token;
  localStorage.removeItem('tlm_session_token');
  token = null;
  document.getElementById('dash-section').style.display = 'none';
  document.getElementById('auth-section').style.display = 'block';
  document.getElementById('nav-logout').style.display = 'none';
  backToEmailStep();
  if (t) fetch('/api/auth/logout', { method: 'POST', headers: { 'Authorization': 'Bearer ' + t } }).catch(function(){});
}

document.getElementById('auth-code').addEventListener('keydown', function(e) {
  if (e.key === 'Enter') verifyOtp();
});
document.getElementById('auth-email').addEventListener('keydown', function(e) {
  if (e.key === 'Enter') requestOtp();
});

function fmtDate(d) {
  if (!d) return '';
  try {
    var dt = new Date(d.replace(' ', 'T'));
    if (isNaN(dt)) return d;
    return dt.toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' });
  } catch(e) { return d; }
}

var STATUS_LABELS = { active: 'Actif', expired: 'Expiré', cancelled: 'Résilié', free: '' };

function loadDashboard() {
  document.getElementById('auth-section').style.display = 'none';
  document.getElementById('dash-section').style.display = 'block';
  document.getElementById('nav-logout').style.display = 'block';

  fetch('/api/auth/dashboard-data', { headers: { 'Authorization': 'Bearer ' + token } })
  .then(function(r) { return r.json(); })
  .then(function(d) {
    if (!d.ok) { logout(); return; }
    document.getElementById('dash-email').textContent = d.email;
    var plan = d.plan || 'free';
    var status = d.status || 'free';
    var isElite = plan === 'elite' || plan === 'vip';
    var isPaidActive = plan !== 'free' && status === 'active';

    var planEl = document.getElementById('dash-plan');
    var planLabel = isElite ? 'Elite/VIP' : plan === 'premium' ? 'Premium' : plan === 'standard' ? 'Standard' : 'Gratuit';
    planEl.textContent = planLabel;
    planEl.className = 'dash-plan ' + (isElite ? 'elite' : plan === 'premium' ? 'premium' : 'standard');

    var statusEl = document.getElementById('dash-status');
    if (STATUS_LABELS[status]) {
      statusEl.textContent = STATUS_LABELS[status];
      statusEl.className = 'dash-status ' + status;
      statusEl.style.display = 'inline-block';
    } else {
      statusEl.style.display = 'none';
    }

    var renewalEl = document.getElementById('dash-renewal');
    if (d.expires_at) {
      renewalEl.textContent = (status === 'active' ? 'Prochain renouvellement : ' : 'Accès jusqu\'au : ') + fmtDate(d.expires_at);
      renewalEl.style.display = 'block';
    } else {
      renewalEl.style.display = 'none';
    }

    document.getElementById('dash-actions').style.display = isPaidActive ? 'flex' : 'none';

    var used = d.credits_used || 0;
    var max = d.credits_max;
    document.getElementById('d-tokens').textContent = (max != null && max > 0) ? Math.max(0, max - used) + '/' + max : '—';
    document.getElementById('d-used').textContent = max != null ? used : '—';
    document.getElementById('d-since').textContent = fmtDate(d.created_at);

    if (plan === 'free') {
      document.getElementById('upgrade-box').style.display = 'block';
      document.getElementById('upgrade-text').textContent = 'Passe Standard dès 4,90€/mois pour débloquer les analyses Live IA.';
    } else if (plan === 'standard') {
      document.getElementById('upgrade-box').style.display = 'block';
      document.getElementById('upgrade-text').textContent = 'Passe Premium pour 10 analyses/jour et une sélection élargie.';
    } else if (plan === 'premium') {
      document.getElementById('upgrade-box').style.display = 'block';
      document.getElementById('upgrade-text').textContent = 'Passe à Elite pour 30 analyses/jour et les alertes Signal Fort.';
    } else {
      document.getElementById('upgrade-box').style.display = 'none';
    }

    renderTierStats(plan);
    renderRecentResults(d.recent || [], isPaidActive);
    loadReferralLink();
  })
  .catch(function() { logout(); });
}

function loadReferralLink() {
  fetch('/api/auth/referral-link', { headers: { 'Authorization': 'Bearer ' + token } })
  .then(function(r) { return r.json(); })
  .then(function(d) {
    if (!d.ok) return;
    document.getElementById('ref-link-input').value = d.link;
    var stats = document.getElementById('ref-stats');
    stats.textContent = d.referrals > 0
      ? d.referrals + ' ami' + (d.referrals > 1 ? 's' : '') + ' parrainé' + (d.referrals > 1 ? 's' : '') + ' — ' + d.monthsEarned + ' mois gagnés au total'
      : 'Aucun parrainage pour le moment.';
  })
  .catch(function() {});
}

function copyRefLink() {
  var input = document.getElementById('ref-link-input');
  input.select();
  input.setSelectionRange(0, 99999);
  navigator.clipboard.writeText(input.value).then(function() {
    var btn = document.getElementById('ref-copy-btn');
    var original = btn.textContent;
    btn.textContent = '✅ Copié !';
    setTimeout(function() { btn.textContent = original; }, 2000);
  }).catch(function() {});
}

function renderRecentResults(recent, isPaidActive) {
  var el = document.getElementById('recent-results');
  if (!isPaidActive) {
    el.innerHTML = '<div class="empty-state" style="text-align:left;padding:20px 0">Réservé aux abonnés actifs. Tous les résultats — gagnés et perdus, sans exception — restent publics sur <a href="/performances" style="color:var(--cyan)">la page Performances</a>.</div>';
    return;
  }
  if (!recent.length) {
    el.innerHTML = '<div class="empty-state">Aucun résultat pour le moment.</div>';
    return;
  }
  el.innerHTML = recent.map(function(a) {
    var win = a.outcome === 'win';
    return '<div class="h-item">' +
      '<div class="h-match">' +
        '<div class="h-teams">' + esc(a.home) + ' — ' + esc(a.away) + (a.score ? ' (' + esc(a.score) + ')' : '') + '</div>' +
        '<div class="h-meta">' + esc(a.bet) + ' · ' + esc(a.confidence) + '/100</div>' +
      '</div>' +
      '<div class="h-date" style="color:' + (win ? 'var(--green)' : 'var(--red)') + '">' + (win ? '✓ Gagné' : '✗ Perdu') + '</div>' +
    '</div>';
  }).join('');
}

function openTelegram() {
  var btn = document.getElementById('telegram-btn');
  btn.disabled = true; btn.textContent = 'Génération du lien...';
  fetch('/api/auth/telegram-link', { headers: { 'Authorization': 'Bearer ' + token } })
  .then(function(r) { return r.json(); })
  .then(function(d) {
    btn.disabled = false; btn.textContent = '📩 Rejoindre le canal Telegram';
    if (!d.ok) { alert(d.error || 'Lien indisponible.'); return; }
    window.open(d.link, '_blank');
  })
  .catch(function() {
    btn.disabled = false; btn.textContent = '📩 Rejoindre le canal Telegram';
    alert('Erreur réseau.');
  });
}

function openBillingPortal() {
  var btn = document.getElementById('billing-btn');
  btn.disabled = true; btn.textContent = 'Ouverture...';
  fetch('/api/auth/billing-portal', { method: 'POST', headers: { 'Authorization': 'Bearer ' + token } })
  .then(function(r) { return r.json(); })
  .then(function(d) {
    btn.disabled = false; btn.textContent = '⚙️ Gérer / résilier mon abonnement';
    if (!d.ok) { alert(d.error || 'Portail indisponible.'); return; }
    window.location.href = d.url;
  })
  .catch(function() {
    btn.disabled = false; btn.textContent = '⚙️ Gérer / résilier mon abonnement';
    alert('Erreur réseau.');
  });
}

// Quels paliers un plan débloque : le palier Standard sert de vitrine/preuve
// et reste visible même sans abonnement (comme sur le reste du site) ;
// Premium et Elite restent verrouillés tant qu'on n'est pas abonné au moins
// au palier correspondant.
function tiersForPlan(plan) {
  if (plan === 'elite' || plan === 'vip') return { standard: true, premium: true, elite: true };
  if (plan === 'premium') return { standard: true, premium: true, elite: false };
  return { standard: true, premium: false, elite: false };
}

// Affiche les 3 paliers : débloqués selon le plan, verrouillés (floutés + CTA) sinon.
function renderTierStats(status) {
  var allowed = tiersForPlan(status);
  var META = {
    standard: { label: '🟢 Standard' },
    premium:  { label: '🟣 Premium' },
    elite:    { label: '🟠 Elite' }
  };
  var UPSELL = { premium: 'Réservé aux membres Pro et Elite', elite: 'Réservé aux membres Elite' };
  var container = document.getElementById('tier-cards');
  var note = document.getElementById('tier-note');
  if (!container) return;
  fetch('/api/tier-stats').then(function(r) { return r.json(); }).then(function(d) {
    if (!d || !d.ok || !d.tiers) { container.innerHTML = '<div class="empty-state">Statistiques indisponibles pour le moment.</div>'; return; }
    var order = ['standard', 'premium', 'elite'];
    container.innerHTML = order.map(function(k) {
      var s = d.tiers[k] || { total: 0, winrate: 0, roi: 0 };
      var unlocked = allowed[k];
      var body = '<div class="tc-body">' +
        '<div class="tc-name">' + META[k].label + '</div>' +
        '<div class="tc-kpis">' +
          '<div class="tc-k"><div class="v" style="color:var(--green)">' + (s.winrate || 0) + '%</div><div class="l">Réussite</div></div>' +
          '<div class="tc-k"><div class="v">' + (s.total || 0) + '</div><div class="l">Analyses</div></div>' +
          '<div class="tc-k"><div class="v" style="color:var(--cyan)">' + ((s.roi >= 0 ? '+' : '') + (s.roi || 0)) + '€</div><div class="l">Profit 10€/pick</div></div>' +
        '</div></div>';
      var lock = unlocked ? '' :
        '<div class="tc-lock"><div class="ico">🔒</div><div class="txt">' + (UPSELL[k] || '') + '</div><a href="/#plans">Débloquer</a></div>';
      return '<div class="tc ' + k + (unlocked ? '' : ' locked') + '">' + body + lock + '</div>';
    }).join('');
    if (note) {
      if (status === 'elite' || status === 'vip') note.textContent = 'Accès complet aux 3 paliers, matchs « IA seulement » inclus.';
      else if (status === 'premium') note.textContent = 'Tu vois Standard + Premium. Elite débloque tout le volume, y compris les analyses « IA seulement ».';
      else if (status === 'standard') note.textContent = 'Tu vois le palier Standard. Premium et Elite débloquent plus de volume d\'analyses.';
      else note.textContent = 'Palier Standard visible en aperçu. Abonne-toi pour débloquer les analyses en direct.';
    }
  }).catch(function() { container.innerHTML = '<div class="empty-state">Erreur de chargement des paliers</div>'; });
}

// Auto-login if token exists
if (token) {
  loadDashboard();
} else {
  document.getElementById('auth-section').style.display = 'block';
}

// Enter key support
document.getElementById('auth-pass').addEventListener('keydown', function(e) {
  if (e.key === 'Enter') submitAuth();
});
</script>
