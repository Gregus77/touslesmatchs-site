// ── Utils ──
function escHtml(s) { var d = document.createElement("div"); d.textContent = s || ""; return d.innerHTML; }
// Les URLs de logos viennent d'API externes (api-sports, TheSportsDB) et
// etaient injectees brutes dans src="..." : une valeur piegee du type
// " onerror="... sortait de l'attribut et executait du script (audit du
// 05/08/2026). On n'autorise que http(s) et on neutralise les guillemets ;
// toute autre valeur (javascript:, data:, relative douteuse) rend une chaine
// vide, ce qui affiche simplement l'image cassee au lieu d'executer du code.
function safeImgUrl(u) {
  var raw = String(u || "").trim();
  if (!/^https?:\/\//i.test(raw)) return "";
  return raw.replace(/"/g, "&quot;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
}
function escAttr(s) { return String(s || "").replace(/'/g, "\\'").replace(/"/g, "&quot;"); }
function initials(name) {
  return String(name || "?").split(/\s+/).filter(Boolean).slice(0,2).map(function(p){ return p.charAt(0); }).join("").toUpperCase() || "?";
}
function splitCompetition(raw) {
  var parts = String(raw || "").split(/\s+[·•]\s+/);
  var league = parts[0] || "";
  var country = parts.length > 1 ? parts[parts.length - 1] : "";
  return { league: league, country: country };
}
function countryFlag(country) {
  return COUNTRY_FLAGS[country] || "";
}

