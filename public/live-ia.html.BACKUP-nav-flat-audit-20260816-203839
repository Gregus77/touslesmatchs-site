<style>
*{margin:0;padding:0;box-sizing:border-box}
html{-webkit-text-size-adjust:100%;text-size-adjust:100%}
:root{
  --bg:#12152a;--bg2:#171b34;--bg3:#1e2340;--bg4:#262c4d;
  --text:#f7f8ff;--muted:#949bc4;--muted2:#c4c9e6;
  --green:#1cc98f;--red:#f6546b;--cyan:#33dcf5;--indigo:#7275ff;--indigo2:#8f92ff;
  --violet:#8b4bf0;--amber:#f7a91e;--pink:#f050a0;
  --b1:rgba(255,255,255,.11);--b2:rgba(255,255,255,.18);
}
body{background:var(--bg);color:var(--text);font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;min-height:100vh}

/* NAV */
.nav{position:sticky;top:0;z-index:200;background:rgba(18,21,42,.92);backdrop-filter:blur(16px);border-bottom:1px solid var(--b1);padding:0 24px;height:56px;display:flex;align-items:center;justify-content:space-between;gap:20px}
.nav-logo{font-size:18px;font-weight:800;color:var(--text);text-decoration:none;letter-spacing:-.02em;flex:0 0 auto}
.nav-logo span{color:var(--indigo2)}
.nav-center{display:flex;gap:20px;align-items:center;flex-wrap:wrap;justify-content:center;flex:1}
.nav-center a{color:var(--muted2);text-decoration:none;font-size:13px;font-weight:600;transition:color .2s;display:flex;align-items:center}
.nav-center a:hover{color:var(--text)}
.nav-center a.active{color:var(--cyan)}
.nav-right{display:flex;align-items:center;gap:10px;flex:0 0 auto}
.nav-cta{background:linear-gradient(135deg,var(--indigo),var(--violet));color:#fff;text-decoration:none;padding:8px 16px;border-radius:10px;font-size:13px;font-weight:700;white-space:nowrap;transition:all .2s}
.nav-cta:hover{transform:translateY(-1px);box-shadow:0 4px 16px rgba(99,102,241,.3)}
.nav-login-btn{background:transparent;border:1px solid rgba(255,255,255,.16);color:var(--text);padding:7px 15px;border-radius:9px;font-size:13px;font-weight:700;cursor:pointer;white-space:nowrap}
.nav-login-btn:hover{border-color:var(--violet)}
@media(max-width:560px){ .nav-cta{display:none} }
.nav-hamburger{display:none;background:none;border:1px solid var(--b2);border-radius:8px;color:var(--text);width:34px;height:34px;font-size:16px;cursor:pointer}
@media(max-width:900px){ .nav-center{display:none} .nav-hamburger{display:block} }
.mmenu{display:none;position:fixed;inset:0;z-index:199;background:rgba(18,21,42,.98);padding:90px 24px 24px;flex-direction:column;gap:18px}
.mmenu.open{display:flex}
.mmenu a{font-size:18px;font-weight:700;color:var(--text);text-decoration:none;padding:10px 0;border-bottom:1px solid var(--b1)}

/* HEADER */
.page-header{text-align:center;padding:40px 24px 20px}
.page-title{font-size:clamp(28px,4vw,44px);font-weight:900;letter-spacing:-.035em;margin-bottom:8px}
.page-sub{font-size:14px;color:var(--muted2);line-height:1.6;max-width:600px;margin:0 auto}
.live-dot{display:inline-block;width:8px;height:8px;border-radius:50%;background:var(--red);margin-right:8px;animation:pulse-dot 1.5s infinite}
@keyframes pulse-dot{0%,100%{opacity:1;box-shadow:0 0 0 0 rgba(244,63,94,.6)}50%{opacity:.7;box-shadow:0 0 0 6px rgba(244,63,94,0)}}
@keyframes popupPulse{0%,100%{box-shadow:0 12px 40px rgba(0,0,0,.5),0 0 0 rgba(255,214,10,.4)}50%{box-shadow:0 12px 40px rgba(0,0,0,.5),0 0 24px rgba(255,214,10,.7)}}

/* FILTERS */
.filters{display:flex;gap:8px;justify-content:center;flex-wrap:wrap;padding:12px 24px 24px}
.filter-btn{background:var(--bg3);border:1px solid var(--b1);color:var(--muted2);padding:8px 16px;border-radius:10px;font-size:12px;font-weight:700;cursor:pointer;transition:all .2s}
.filter-btn:hover,.filter-btn.active{background:rgba(99,102,241,.12);border-color:rgba(99,102,241,.3);color:var(--indigo2)}

/* ADVANCED FILTERS (curseurs multi-criteres) */
.adv-filters-toggle{max-width:900px;margin:0 auto;padding:0 16px}
.adv-filters-panel{max-width:900px;margin:10px auto 0;padding:18px 20px;background:var(--bg3);border:1px solid var(--b1);border-radius:14px}
.adv-filters-panel .af-title{font-weight:800;font-size:14px;margin-bottom:12px;color:var(--indigo2, #7c5cff)}
.af-row{display:flex;align-items:center;gap:12px;margin-bottom:14px}
.af-row label{flex:0 0 220px;font-size:12px;color:var(--muted2);font-weight:600}
.af-row input[type=range]{flex:1;accent-color:#7c5cff}
.af-row .af-val{flex:0 0 48px;text-align:right;font-size:12px;font-weight:700;color:#fff}
.af-actions{display:flex;gap:10px;margin-top:6px}
.af-actions button{border:none;border-radius:9px;padding:9px 16px;font-size:12px;font-weight:700;cursor:pointer}
.af-apply{background:linear-gradient(135deg,#7c5cff,#5b3ff5);color:#fff}
.af-reset{background:var(--bg2, #1e2340);color:var(--muted2);border:1px solid var(--b1)!important}
.af-count{font-size:11px;color:var(--muted2);margin-left:auto;align-self:center}
.af-highlight-btn{background:linear-gradient(135deg,#ff3b5c,#7c5cff);color:#fff;border:none;padding:12px 22px;border-radius:12px;font-size:14px;font-weight:800;cursor:pointer;box-shadow:0 0 0 rgba(255,59,92,.5);animation:afPulse 1.8s infinite}
.af-highlight-btn.active{animation:none;box-shadow:none}
@keyframes afPulse{0%,100%{box-shadow:0 0 0 0 rgba(255,59,92,.55)}50%{box-shadow:0 0 0 10px rgba(255,59,92,0)}}

/* MATCH GRID */
.matches-wrap{max-width:900px;margin:0 auto;padding:0 16px 60px}
.match-card{background:var(--bg3);border:1px solid var(--b1);border-radius:16px;padding:20px;margin-bottom:12px;transition:all .25s;cursor:default}
.match-card:hover{border-color:rgba(99,102,241,.25);transform:translateY(-1px)}
.match-card.finished{opacity:.7}
.match-card.finished:hover{opacity:.9}

/* Match header */
.mc-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px}
.mc-sport{display:flex;align-items:center;gap:6px}
.mc-sport-icon{width:28px;height:28px;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;background:rgba(255,255,255,.06);font-size:16px;box-shadow:inset 0 0 0 1px rgba(255,255,255,.08)}
.mc-comp{font-size:11px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.06em}
.mc-country{display:inline-flex;align-items:center;gap:5px;margin-left:8px;color:var(--muted2);letter-spacing:0;text-transform:none}
.mc-status{display:flex;align-items:center;gap:6px;font-size:12px;font-weight:700;border-radius:8px;padding:4px 10px}
.mc-status.live{background:rgba(244,63,94,.1);color:var(--red);border:1px solid rgba(244,63,94,.2)}
.mc-status.finished{background:rgba(123,130,160,.08);color:var(--muted);border:1px solid var(--b1)}
.mc-status.scheduled{background:rgba(34,211,238,.08);color:var(--cyan);border:1px solid rgba(34,211,238,.2)}
.mc-status .st-dot{width:6px;height:6px;border-radius:50%;background:currentColor;animation:pulse-dot 1.5s infinite}

/* Match body — teams + score */
.mc-body{display:flex;align-items:center;justify-content:space-between;gap:12px}
.mc-team{flex:1;display:flex;align-items:center;gap:10px}
.mc-team.away{flex-direction:row-reverse;text-align:right}
.mc-logo{width:38px;height:38px;border-radius:9px;background:var(--bg4);display:flex;align-items:center;justify-content:center;font-size:20px;font-weight:900;color:var(--text);flex-shrink:0;overflow:hidden;border:1px solid rgba(255,255,255,.08)}
.mc-logo img{width:100%;height:100%;object-fit:contain}
.mc-name{font-size:15px;font-weight:700;line-height:1.3}
.mc-score-col{display:flex;flex-direction:column;align-items:center;gap:4px;min-width:70px}
.mc-score{font-size:28px;font-weight:900;letter-spacing:.02em;font-variant-numeric:tabular-nums}
.mc-minute{font-size:11px;font-weight:700;color:var(--red);background:rgba(244,63,94,.08);padding:2px 8px;border-radius:6px}
.mc-minute.done{color:var(--muted);background:rgba(123,130,160,.08)}

/* CTA analyse */
.mc-cta{margin-top:14px;display:flex;gap:8px;flex-wrap:wrap}
.mc-analyse-btn{flex:1;background:linear-gradient(135deg,rgba(99,102,241,.15),rgba(124,58,237,.12));border:1px solid rgba(99,102,241,.25);color:var(--indigo2);padding:10px 16px;border-radius:10px;font-size:13px;font-weight:700;cursor:pointer;transition:all .2s;text-align:center}
.mc-analyse-btn:hover{background:linear-gradient(135deg,rgba(99,102,241,.25),rgba(124,58,237,.2));transform:translateY(-1px)}
.mc-analyse-btn:disabled{opacity:.5;cursor:not-allowed;transform:none}
.mc-not-playable{flex:1;background:rgba(255,255,255,.03);border:1px solid var(--b1);color:var(--muted2);padding:10px 16px;border-radius:10px;font-size:12.5px;text-align:center}

/* Analysis result */
.mc-analysis{margin-top:14px;background:rgba(99,102,241,.06);border:1px solid rgba(99,102,241,.15);border-radius:12px;padding:16px;display:none}
.mc-analysis.visible{display:block}
.mc-analysis-title{font-size:13px;font-weight:700;color:var(--indigo2);margin-bottom:8px}
.mc-analysis-text{font-size:13px;color:var(--muted2);line-height:1.7}
.mc-analysis-bet{display:inline-block;background:rgba(16,185,129,.1);border:1px solid rgba(16,185,129,.2);color:var(--green);padding:4px 12px;border-radius:8px;font-size:12px;font-weight:700;margin-top:8px}
.conf-dot{display:inline-block;width:14px;height:14px;border-radius:50%;margin-right:8px;vertical-align:middle;border:2px solid rgba(255,255,255,.35);flex-shrink:0}
.conf-dot.green{background:var(--green);box-shadow:0 0 10px rgba(16,185,129,.9)}
.conf-dot.yellow{background:#facc15;box-shadow:0 0 10px rgba(250,204,21,.9)}
.conf-dot.orange{background:#f97316;box-shadow:0 0 10px rgba(249,115,22,.9)}
.conf-dot.red{background:var(--red);box-shadow:0 0 10px rgba(244,63,94,.9)}
.conf-badge{display:inline-flex;align-items:center;padding:4px 12px;border-radius:8px;font-size:12px;font-weight:700;margin-top:8px;margin-right:6px}
.conf-badge.green{background:rgba(16,185,129,.1);border:1px solid rgba(16,185,129,.25);color:var(--green)}
.conf-badge.yellow{background:rgba(250,204,21,.1);border:1px solid rgba(250,204,21,.3);color:#facc15}
.conf-badge.orange{background:rgba(249,115,22,.1);border:1px solid rgba(249,115,22,.3);color:#f97316}
.conf-badge.red{background:rgba(244,63,94,.1);border:1px solid rgba(244,63,94,.25);color:var(--red)}
@keyframes blinkNoPlay{0%,100%{opacity:1}50%{opacity:.35}}
.blink-badge{animation:blinkNoPlay 1s ease-in-out infinite}

/* Empty state */
.empty-state{text-align:center;padding:80px 24px}
.empty-icon{font-size:48px;margin-bottom:16px}
.empty-title{font-size:20px;font-weight:800;margin-bottom:8px}
.empty-sub{font-size:14px;color:var(--muted2);line-height:1.6;max-width:400px;margin:0 auto}

/* Loading */
.loading{text-align:center;padding:60px 24px}
.spinner{width:32px;height:32px;border:3px solid var(--b2);border-top-color:var(--indigo2);border-radius:50%;animation:spin .8s linear infinite;margin:0 auto 16px}
@keyframes spin{to{transform:rotate(360deg)}}

/* Auth bar */
.auth-bar{max-width:900px;margin:0 auto;padding:0 16px 16px;display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}
.auth-info{font-size:12px;color:var(--muted2)}
.auth-info strong{color:var(--green)}
.auth-login-btn{background:linear-gradient(135deg,var(--indigo),var(--violet));color:#fff;border:none;padding:8px 20px;border-radius:10px;font-size:13px;font-weight:700;cursor:pointer;transition:all .2s}
.auth-login-btn:hover{transform:translateY(-1px);box-shadow:0 4px 16px rgba(99,102,241,.3)}

/* Login modal */
.modal-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.7);z-index:200;align-items:center;justify-content:center}
.modal-overlay.open{display:flex}
.modal-box{background:var(--bg2);border:1px solid var(--b2);border-radius:20px;padding:32px;width:90%;max-width:400px}
.modal-title{font-size:20px;font-weight:800;margin-bottom:6px}
.modal-sub{font-size:13px;color:var(--muted2);margin-bottom:20px;line-height:1.6}
.modal-label{font-size:12px;font-weight:700;color:var(--muted2);display:block;margin-bottom:4px}
.modal-input{width:100%;background:var(--bg3);border:1px solid var(--b2);color:var(--text);padding:10px 14px;border-radius:10px;font-size:14px;margin-bottom:12px}
.modal-input:focus{outline:none;border-color:var(--indigo2)}
.modal-btn{width:100%;background:linear-gradient(135deg,var(--indigo),var(--violet));color:#fff;border:none;padding:12px;border-radius:10px;font-size:14px;font-weight:700;cursor:pointer}
.modal-close{position:absolute;top:12px;right:16px;font-size:20px;color:var(--muted);cursor:pointer;background:none;border:none}
.modal-error{color:var(--red);font-size:12px;margin-top:8px;display:none}

/* Refresh bar */
.refresh-bar{text-align:center;padding:8px;font-size:11px;color:var(--muted)}
.refresh-bar button{background:none;border:none;color:var(--cyan);cursor:pointer;font-size:11px;font-weight:700;margin-left:6px}

/* Search */
.search-bar{max-width:900px;margin:0 auto;padding:0 16px 12px}
.search-input{width:100%;background:var(--bg3);border:1px solid var(--b2);color:var(--text);padding:11px 16px;border-radius:12px;font-size:14px}
.search-input:focus{outline:none;border-color:var(--indigo2)}
.search-input::placeholder{color:var(--muted)}

/* Legende confiance — pense-bete toujours visible */
.conf-legend{max-width:900px;margin:0 auto;padding:0 16px 16px;display:flex;gap:8px;flex-wrap:wrap;justify-content:center}
.conf-legend-item{display:inline-flex;align-items:center;gap:6px;font-size:11px;font-weight:700;padding:5px 11px;border-radius:20px;background:var(--bg3);border:1px solid var(--b1)}
.conf-legend-item .conf-dot{width:11px;height:11px;margin-right:0}

/* Sport popup */

/* History section */
.history-section{max-width:900px;margin:0 auto;padding:0 16px 40px}
.history-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;padding-top:48px;border-top:1px solid var(--b1)}
.history-title{font-size:clamp(20px,3vw,28px);font-weight:800;letter-spacing:-.02em}
.history-stats{display:flex;gap:16px;flex-wrap:wrap}
.h-stat{background:var(--bg3);border:1px solid var(--b1);border-radius:12px;padding:10px 16px;text-align:center;min-width:80px}
.h-stat-val{font-size:20px;font-weight:900;font-variant-numeric:tabular-nums}
.h-stat-val.green{color:var(--green)}.h-stat-val.red{color:var(--red)}.h-stat-val.cyan{color:var(--cyan)}
.h-stat-label{font-size:10px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;margin-top:2px}
.h-card{background:var(--bg3);border:1px solid var(--b1);border-radius:14px;padding:16px 20px;margin-bottom:10px;transition:border-color .2s}
.h-card:hover{border-color:rgba(99,102,241,.2)}
.h-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;gap:8px}
.h-comp{font-size:11px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.06em}
.h-time{font-size:11px;color:var(--muted)}
.h-teams{display:flex;align-items:center;gap:10px;margin-bottom:10px}
.h-logo{width:28px;height:28px;border-radius:6px;background:var(--bg4);display:flex;align-items:center;justify-content:center;overflow:hidden;flex-shrink:0}
.h-logo img{width:100%;height:100%;object-fit:contain}
.h-vs{font-size:12px;color:var(--muted);font-weight:700}
.h-team-name{font-size:14px;font-weight:700}
.h-bottom{display:flex;align-items:center;justify-content:space-between;gap:8px;flex-wrap:wrap}
.h-bet{font-size:12px;font-weight:700;padding:4px 12px;border-radius:8px;background:rgba(99,102,241,.1);border:1px solid rgba(99,102,241,.2);color:var(--indigo2)}
.h-conf{font-size:12px;font-weight:700;color:var(--amber)}
.h-outcome{font-size:12px;font-weight:800;padding:3px 10px;border-radius:6px}
.h-outcome.win{background:rgba(16,185,129,.12);color:var(--green);border:1px solid rgba(16,185,129,.25)}
.h-outcome.loss{background:rgba(244,63,94,.1);color:var(--red);border:1px solid rgba(244,63,94,.2)}
.h-outcome.pending{background:rgba(245,158,11,.08);color:var(--amber);border:1px solid rgba(245,158,11,.2)}
.h-score{font-size:13px;font-weight:800;color:var(--text)}
.h-reasoning{font-size:12px;color:var(--muted2);line-height:1.6;margin-top:8px;padding-top:8px;border-top:1px solid var(--b1)}
.h-load-more{display:block;width:100%;background:var(--bg3);border:1px solid var(--b2);color:var(--indigo2);padding:12px;border-radius:12px;font-size:13px;font-weight:700;cursor:pointer;text-align:center;margin-top:16px;transition:all .2s}
.h-load-more:hover{background:rgba(99,102,241,.08);border-color:rgba(99,102,241,.3)}
.h-empty{text-align:center;padding:48px 24px;color:var(--muted2)}
.h-empty-icon{font-size:40px;margin-bottom:12px}
.h-empty-title{font-size:18px;font-weight:800;color:var(--text);margin-bottom:6px}

/* Tab bar */
.tab-bar{display:flex;gap:0;max-width:900px;margin:0 auto 20px;padding:0 16px}
.tab-btn{flex:1;background:var(--bg3);border:1px solid var(--b1);color:var(--muted2);padding:14px 16px;font-size:14px;font-weight:700;cursor:pointer;transition:all .2s;text-align:center;border-bottom:3px solid transparent}
.tab-btn:first-child{border-radius:12px 0 0 12px}
.tab-btn:last-child{border-radius:0 12px 12px 0}
.tab-btn.active{background:rgba(99,102,241,.1);border-color:rgba(99,102,241,.2);border-bottom-color:var(--indigo2);color:var(--indigo2)}
.tab-btn:hover:not(.active){background:var(--bg4)}
.tab-content{display:none}
.tab-content.active{display:block}

/* Footer */
.footer{text-align:center;padding:32px 16px;border-top:1px solid var(--b1);font-size:11px;color:var(--muted);line-height:1.8}
.footer a{color:var(--muted);text-decoration:none}

/* Responsive */
@media(max-width:600px){
  .mc-body{flex-direction:column;gap:8px}
  .mc-team,.mc-team.away{flex-direction:row;text-align:left;justify-content:flex-start}
  .mc-score{font-size:22px}
  .mc-name{font-size:14px}
  .filters{padding:8px 12px 16px}
  .filter-btn{padding:6px 12px;font-size:11px}
  .tab-btn{font-size:13px;padding:12px 10px}
}
</style>
