// ── Surveillance des matchs déjà analysés (jeton dépensé) ──────────────────
// Objectif : un client qui a payé un jeton sur un match ne doit pas rater une
// évolution du vote Concile juste parce qu'il regarde un autre match parmi les
// 30 ouverts. On revérifie périodiquement (voir checkWatchedForUpdates) et un
// popup alerte en cas de changement — demande du fondateur le 03/08/2026.
var WATCH_KEY = "tlm_watched_matches";
function loadWatched() {
  try { return JSON.parse(localStorage.getItem(WATCH_KEY) || "{}"); } catch (e) { return {}; }
}
function saveWatched(obj) {
  try { localStorage.setItem(WATCH_KEY, JSON.stringify(obj)); } catch (e) {}
}
function watchMatch(matchId, home, away, voteLabel, betText, confText, resumeText) {
  var w = loadWatched();
  w[matchId] = { home: home, away: away, voteLabel: voteLabel || "", betText: betText || "", confText: confText || "", resumeText: resumeText || "", ts: Date.now() };
  saveWatched(w);
}
function unwatchMatch(matchId) {
  var w = loadWatched();
  delete w[matchId];
  saveWatched(w);
}

function checkWatchedForUpdates() {
  if (!userAuth) return;
  var w = loadWatched();
  var ids = Object.keys(w);
  if (!ids.length) return;
  ids.forEach(function (matchId) {
    var entry = w[matchId];
    var match = allMatches.find(function (m) { return (m.id || m.home + "_" + m.away) === matchId; });
    if (!match) {
      // Plus en direct (match termine/disparu de l'API) : on arrete de le
      // surveiller, mais on garde le panneau visible s'il l'etait deja —
      // c'est la preuve/derniere analyse, utile meme apres la fin du match.
      unwatchMatch(matchId);
      return;
    }
    fetch("/api/concile-analysis", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        email: userAuth.email, code: userAuth.code,
        match: { id: match.id, home: match.home, away: match.away, score_home: match.score_home, score_away: match.score_away, minute: match.minute, competition: match.competition }
      })
    }).then(function (r) { return r.json(); }).then(function (d) {
      if (!d.ok) return;
      var built = buildAnalysisHtml(d);
      if (built.voteLabel && built.voteLabel !== entry.voteLabel) {
        showUpdatePopup(match.home, match.away, built.voteLabel, built.betText, built.confText, built.resumeText);
      }
      watchMatch(matchId, match.home, match.away, built.voteLabel, built.betText, built.confText, built.resumeText);
      // Le panneau deja ouvert (ou retrouve au chargement via le cache
      // persistant) doit refleter le dernier avis du Concile, meme si le
      // client ne l'a pas rouvert manuellement — sinon le popup annonce un
      // changement que la carte elle-meme ne montre pas encore.
      analysisCache[matchId] = built.html;
      saveAnalysisCache();
      var domEl = document.getElementById("analysis-" + matchId);
      if (domEl) { domEl.innerHTML = built.html; domEl.classList.add("visible"); }
      if (userAuth && d.credits_left !== undefined) { userAuth.credits_left = d.credits_left; updateAuthBar(); }
    }).catch(function () {});
  });
}
