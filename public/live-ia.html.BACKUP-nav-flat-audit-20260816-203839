function requestAnalysis(btn, matchId, home, away) {
  if (!userAuth) {
    openLoginModal();
    return;
  }
  btn.disabled = true;
  btn.innerHTML = '<div class="spinner" style="width:16px;height:16px;border-width:2px;display:inline-block;vertical-align:middle;margin-right:6px"></div> Analyse en cours...';

  var match = allMatches.find(function(m) { return (m.id || m.home + "_" + m.away) === matchId; });
  var analysisTimer = null;
  var controller = window.AbortController ? new AbortController() : null;
  if (controller) {
    analysisTimer = setTimeout(function(){ controller.abort(); }, 45000);
  }

  fetch("/api/concile-analysis", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    signal: controller ? controller.signal : undefined,
    body: JSON.stringify({
      email: userAuth.email,
      code: userAuth.code,
      match: {
        id: match ? match.id : matchId,
        home: home,
        away: away,
        score_home: match ? match.score_home : null,
        score_away: match ? match.score_away : null,
        minute: match ? match.minute : null,
        competition: match ? match.competition : ""
      }
    })
  }).then(function(r){ return r.json(); }).then(function(d) {
    if (analysisTimer) clearTimeout(analysisTimer);
    var el = document.getElementById("analysis-" + matchId);
    if (d.ok) {
      var built = buildAnalysisHtml(d);
      el.innerHTML = built.html;
      el.classList.add("visible");
      btn.innerHTML = "✅ Analyse terminée";
      // Persistée en localStorage (pas juste en mémoire JS) : le panneau doit
      // rester ouvert tant que le match n'est pas fini, MEME apres un
      // rechargement de page ou une revisite plus tard — demande du fondateur le
      // 03/08/2026 ("l'analyse doit rester ouverte en permanence a partir du
      // moment ou j'ai paye mon jeton et pendant tout le match").
      analysisCache[matchId] = el.innerHTML;
      saveAnalysisCache();
      // Un jeton vient d'être dépensé sur ce match : on le surveille désormais
      // en arrière-plan (voir watchMatch/checkWatchedForUpdates) pour prévenir
      // si le vote du Concile évolue, même si le client a 30 onglets ouverts et
      // ne regarde plus cette carte. Demande du fondateur le 03/08/2026.
      watchMatch(matchId, home, away, built.voteLabel, built.betText, built.confText, built.resumeText);
      // Met à jour le compteur de la barre du haut
      if (userAuth && d.credits_left !== undefined) {
        userAuth.credits_left = d.credits_left;
        if (d.credits_max !== undefined) userAuth.credits_max = d.credits_max;
        updateAuthBar();
      }
    } else if (d.error === "CREDITS_EXHAUSTED") {
      if (userAuth) { userAuth.credits_left = 0; updateAuthBar(); }
      el.innerHTML = '<div style="background:rgba(212,175,55,.08);border:1px solid rgba(212,175,55,.3);border-radius:10px;padding:14px;font-size:13px;color:#eee">'
        + '<div style="font-weight:700;margin-bottom:6px">⏳ Quota de jetons atteint pour aujourd\'hui</div>'
        + '<div style="color:#ccc;margin-bottom:10px">Reprise à minuit (00h00), ou débloque une analyse tout de suite :</div>'
        + '<button onclick="buyCarteToken()" style="background:linear-gradient(135deg,#d4af37,#f5c842);color:#111;border:none;padding:10px 18px;border-radius:8px;font-weight:700;font-size:13px;cursor:pointer">Débloquer 1 analyse — 1€</button>'
        + '</div>';
      el.classList.add("visible");
      btn.disabled = false;
      btn.innerHTML = "🧠 Réessayer";
    } else {
      el.innerHTML = '<div style="color:var(--red);font-size:13px;padding:8px">⚠️ ' + escHtml(d.error || "Erreur d'analyse") + '</div>';
      el.classList.add("visible");
      btn.disabled = false;
      btn.innerHTML = "🧠 Réessayer";
    }
  }).catch(function() {
    if (analysisTimer) clearTimeout(analysisTimer);
    var el = document.getElementById("analysis-" + matchId);
    if (el) {
