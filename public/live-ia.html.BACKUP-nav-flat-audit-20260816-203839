<script>
// ── Tab switching ──
function switchTab(tab) {
  document.querySelectorAll('.tab-btn').forEach(function(b,i){ b.classList.toggle('active', i === (tab === 'live' ? 0 : 1)); });
  document.getElementById('tab-live').classList.toggle('active', tab === 'live');
  document.getElementById('tab-stats').classList.toggle('active', tab !== 'live');
  if (tab === 'stats') loadHistory();
}
if (location.hash === '#historique' || location.hash === '#stats') { setTimeout(function(){ switchTab('stats'); }, 100); }

// ── Sport config ──
const SPORT_ICONS = {
  Football: "⚽", Basketball: "🏀", Hockey: "🏒",
  Rugby: "🏉"
};

const COUNTRY_FLAGS = {
  "Argentina":"🇦🇷","Australia":"🇦🇺","Austria":"🇦🇹","Belgium":"🇧🇪","Brazil":"🇧🇷","Canada":"🇨🇦",
  "Chile":"🇨🇱","China":"🇨🇳","Colombia":"🇨🇴","Croatia":"🇭🇷","Czech Republic":"🇨🇿","Denmark":"🇩🇰",
  "England":"🏴","Finland":"🇫🇮","France":"🇫🇷","Germany":"🇩🇪","Greece":"🇬🇷","Italy":"🇮🇹",
  "Japan":"🇯🇵","Mexico":"🇲🇽","Netherlands":"🇳🇱","Norway":"🇳🇴","Poland":"🇵🇱","Portugal":"🇵🇹",
  "Scotland":"🏴󠁧󠁢󠁳󠁣󠁴󠁿","Spain":"🇪🇸","Sweden":"🇸🇪","Switzerland":"🇨🇭","Turkey":"🇹🇷",
  "USA":"🇺🇸","United States":"🇺🇸","World":"🌍"
};

// ── State ──
let allMatches = [];
let currentFilter = "Football"; // le foot est affiché par défaut ; les autres sports se choisissent via les filtres
let searchTerm = "";
// Filtres avances (curseurs) : 100% gratuit et cote client, aucun jeton
// depense tant que l'utilisateur ne clique pas sur "Analyser" un match.
// maxGoalDiff=5 et minMinute=0 = valeurs neutres (pas de filtre applique).
let advFilters = { btts: 0, ht: 0, under25: 0, maxGoalDiff: 5, minMinute: 0, active: false };

function toggleAdvFilters() {
  var p = document.getElementById("adv-filters-panel");
  p.style.display = (p.style.display === "none") ? "block" : "none";
}
function syncAdvLabel(id, suffix) {
  document.getElementById(id + "-val").textContent = document.getElementById(id).value + (suffix || "");
}
function applyAdvFilters() {
  advFilters.btts = Number(document.getElementById("af-btts").value) || 0;
  advFilters.ht = Number(document.getElementById("af-ht").value) || 0;
  advFilters.under25 = Number(document.getElementById("af-under25").value) || 0;
  advFilters.maxGoalDiff = Number(document.getElementById("af-goaldiff").value);
  advFilters.minMinute = Number(document.getElementById("af-minute").value) || 0;
  advFilters.active = advFilters.btts > 0 || advFilters.ht > 0 || advFilters.under25 > 0 || advFilters.maxGoalDiff < 5 || advFilters.minMinute > 0;
  document.getElementById("adv-filters-btn").classList.toggle("active", advFilters.active);
  renderMatches();
}
// Certains navigateurs mobiles (Safari iOS, webview TikTok/Instagram) ne
// repositionnent pas visuellement le curseur quand on change .value en JS
// sans forcer un reflow — le curseur reste affiche a son ancienne position
// meme si applyAdvFilters() utilise deja la bonne valeur. Constate le
// 04/08/2026 : le rond restait a droite apres "Reinitialiser" malgre un
// filtre reellement remis a 0. Le forcage de reflow (lecture offsetHeight
// apres un display:none/'') corrige l'affichage sur tous les navigateurs testes.
function setRangeValue(id, val) {
  var el = document.getElementById(id);
  el.value = val;
  el.style.display = "none";
  void el.offsetHeight;
  el.style.display = "";
  el.dispatchEvent(new Event("input", { bubbles: true }));
}
function resetAdvFilters() {
  ["af-btts", "af-ht", "af-under25"].forEach(function(id) { setRangeValue(id, 0); syncAdvLabel(id, "%"); });
  setRangeValue("af-goaldiff", 5); syncAdvLabel("af-goaldiff", "");
  setRangeValue("af-minute", 0); syncAdvLabel("af-minute", "'");
  applyAdvFilters();
}
function matchPassesAdvFilters(m) {
  if (!advFilters.active) return true;
  // Un match deja analyse (jeton depense) ne doit jamais disparaitre a cause
  // d'un curseur de filtre — sinon le client perd de vue une analyse qu'il a
  // payee des qu'il ajuste un critere. Constate le 04/08/2026.
  var matchId = m.id || (m.home + "_" + m.away).replace(/\s+/g, "_");
  if (analysisCache[matchId] || loadWatched()[matchId]) return true;
  var h2h = m.h2h_markets;
  if (advFilters.btts > 0 && (!h2h || h2h.btts_pct == null || h2h.btts_pct < advFilters.btts)) return false;
  if (advFilters.ht > 0 && (!h2h || h2h.first_half_goal_pct == null || h2h.first_half_goal_pct < advFilters.ht)) return false;
  if (advFilters.under25 > 0 && (!h2h || h2h.under25_pct == null || h2h.under25_pct < advFilters.under25)) return false;
  if (advFilters.maxGoalDiff < 5) {
    var gd = (m.score_home != null && m.score_away != null) ? Math.abs(m.score_home - m.score_away) : null;
    if (gd == null || gd > advFilters.maxGoalDiff) return false;
  }
  if (advFilters.minMinute > 0) {
    var min = parseInt(m.minute, 10);
    if (isNaN(min) || min < advFilters.minMinute) return false;
  }
  return true;
}
let userAuth = null;
// Analyses déjà obtenues, gardées en mémoire le temps de la session. loadMatches()
// tourne toutes les 60s et reconstruit tout le HTML des cartes (scores en direct) —
// sans ce cache, une analyse tout juste ouverte se refermait et redevenait un
// simple bouton "Analyser" à chaque rafraîchissement.
// Persisté en localStorage (pas juste en mémoire) : un jeton payé doit rester
// visible même après un rechargement de page ou une revisite plus tard dans
// le match, pas seulement pendant la session en cours. Demande du fondateur le
// 03/08/2026. Purge les entrées de plus de 12h (matchs forcément terminés).
var ANALYSIS_CACHE_KEY = "tlm_analysis_cache";
function loadAnalysisCache() {
  try {
    var raw = JSON.parse(localStorage.getItem(ANALYSIS_CACHE_KEY) || "{}");
    var now = Date.now(), fresh = {};
    Object.keys(raw).forEach(function (k) {
      var entry = raw[k];
      if (entry && entry.ts && (now - entry.ts) < 12 * 3600 * 1000) fresh[k] = entry.html;
    });
    return fresh;
  } catch (e) { return {}; }
}
function saveAnalysisCache() {
  try {
    var out = {};
    Object.keys(analysisCache).forEach(function (k) { out[k] = { html: analysisCache[k], ts: Date.now() }; });
    localStorage.setItem(ANALYSIS_CACHE_KEY, JSON.stringify(out));
  } catch (e) {}
}
let analysisCache = loadAnalysisCache();

// ── Minute affichée : traduit les codes bruts de l'API en français clair.
// "0" est un chiffre valide (coup d'envoi) mais falsy en JS — sans check
// explicite typeof === "number", la minute disparaissait a la 0e minute.
// Les autres codes (P, BT, HT, ET...) viennent tels quels des sources
// sportives (API-Sports/football-data) : les afficher bruts ("P", "BT")
// est incomprehensible pour un client, d'ou la table de traduction.
var STATUS_CODE_LABELS = {
  HT: "Mi-temps", "1H": "1ère mi-temps", "2H": "2nde mi-temps",
  ET: "Prolongation", AET: "Fin des prolongations",
  BT: "Pause (avant tirs au but)", P: "Tirs au but", PEN: "Tirs au but",
  INT: "Interrompu", SUSP: "Suspendu", ABD: "Match arrêté",
  TBD: "Horaire à confirmer", NS: "Pas encore commencé",
};
// Quart-temps (basket) / periodes (hockey) — codes bruts renvoyes par
// API-Sports (status.short). Sans traduction, le client voit juste un
// chrono ("9'") sans savoir a quel quart-temps il correspond (signale
// par le fondateur le 01/08/2026).
var PERIOD_LABELS = {
  Q1: "1er quart-temps", Q2: "2e quart-temps", Q3: "3e quart-temps", Q4: "4e quart-temps",
  OT: "Prolongation", BT: "Pause",
  P1: "1ère période", P2: "2e période", P3: "3e période", SO: "Tirs au but",
};
function minuteLabel(m) {
  if (m.status === "HT") return "Mi-temps";
  var periodLbl = m.period ? (PERIOD_LABELS[String(m.period).toUpperCase()] || "") : "";
  var clock = "";
  if (typeof m.minute === "number") clock = m.minute + "'";
  else {
    var raw = String(m.minute || "").trim();
    if (raw && /^\d+\+?\d*$/.test(raw)) clock = raw + "'"; // "45+2" etc.
  }
  if (periodLbl) return clock ? periodLbl + " · " + clock : periodLbl;
  if (clock) return clock;
  var raw2 = String(m.minute || "").trim();
  if (!raw2) return "En direct";
  return STATUS_CODE_LABELS[raw2.toUpperCase()] || "En direct";
}

// ── Confiance : couleur/label selon le pourcentage (même échelle que Telegram) ──
function confMeta(conf) {
  var c = Number(conf) || 0;
  if (c >= 85) return { cls: "green",  emoji: "🟢", label: "Fiable" };
  if (c >= 75) return { cls: "yellow", emoji: "🟡", label: "Bon" };
  if (c >= 65) return { cls: "orange", emoji: "🟠", label: "Risqué" };
  return { cls: "red", emoji: "🔴", label: "Prudence" };
}

// ── Init ──
(function init() {
  const email = localStorage.getItem("tlm_email");
  const code = localStorage.getItem("tlm_code");
  const plan = localStorage.getItem("tlm_plan");
  if (email && code && plan) {
    userAuth = { email, code, plan };
    updateAuthBar();
    refreshCredits();   // récupère le compteur de jetons à jour au chargement
  }
  loadMatches();
  setInterval(function(){ loadMatches(); refreshCredits(); }, 60000);
  setTimeout(checkWatchedForUpdates, 8000);

  document.getElementById("filters").addEventListener("click", function(e) {
    var btn = e.target.closest(".filter-btn");
    if (!btn) return;
    document.querySelectorAll(".filter-btn").forEach(function(b){ b.classList.remove("active"); });
    btn.classList.add("active");
    currentFilter = btn.dataset.filter;
    renderMatches();
  });

})();

function onSearchInput(v) {
  searchTerm = String(v || "").trim().toLowerCase();
  renderMatches();
}

// Récupère le compteur de jetons à jour depuis le serveur (au chargement).
function refreshCredits() {
  if (!userAuth || !userAuth.email || !userAuth.code) return;
  fetch("/api/verify-code", {
    method: "POST", headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ email: userAuth.email, code: userAuth.code })
  }).then(function(r){ return r.json(); }).then(function(d) {
    if (d.valid) {
      userAuth.credits_left = d.credits_left;
      userAuth.credits_max = d.credits_max;
      userAuth.plan = d.plan;
      updateAuthBar();
    }
  }).catch(function(){});
}

function updateAuthBar() {
  var info = document.getElementById("auth-info");
  var btn = document.getElementById("auth-btn");
  var navCta = document.getElementById("nav-cta-top");
  var navLogin = document.getElementById("nav-se-connecter");
  // Inutile de proposer "Creer un compte" ou "Se connecter" a quelqu'un deja abonne.
  if (navCta) navCta.style.display = userAuth ? "none" : "";
  if (navLogin) navLogin.style.display = userAuth ? "none" : "";
  if (userAuth) {
    var isElite = userAuth.plan === "elite";
    var planName = userAuth.plan.charAt(0).toUpperCase() + userAuth.plan.slice(1);
    var tokens = "";
    if ((userAuth.plan === "premium" || userAuth.plan === "elite")
        && userAuth.credits_max != null && userAuth.credits_left != null) {
      var left = userAuth.credits_left, max = userAuth.credits_max;
      var col = left === 0 ? "#f43f5e" : (left <= 2 ? "#f59e0b" : "#34d399");
      tokens = '<div id="token-counter" style="display:inline-flex;align-items:center;gap:8px;margin-top:8px;padding:8px 18px;border-radius:14px;'
        + 'background:rgba(124,58,237,.14);border:1.5px solid rgba(124,58,237,.4);">'
        + '<span style="font-size:22px">🎟️</span>'
        + '<span style="font-size:26px;font-weight:900;line-height:1;color:' + col + '">' + left + '<span style="font-size:16px;color:var(--muted2);font-weight:700">/' + max + '</span></span>'
        + '<span style="font-size:13px;color:var(--muted2);font-weight:600">analyses<br>aujourd\'hui</span>'
        + '</div>';
    }
    info.innerHTML = (isElite ? "👑" : "⚡") + " <strong>" + planName + "</strong> — " + userAuth.email + tokens;
    btn.textContent = "Déconnexion";
    btn.onclick = doLogout;
  } else {
    info.textContent = "Connecte-toi pour analyser les matchs";
    btn.textContent = "Connexion";
    btn.onclick = openLoginModal;
  }
}

// ── Load matches ──
function loadMatches(force) {
  var url = "/api/live-matches" + (force ? "?force=1" : "");
  fetch(url).then(function(r){ return r.json(); }).then(function(d) {
    if (d.ok && d.matches) {
      allMatches = d.matches;
      renderMatches();
      document.getElementById("last-update").textContent = new Date().toLocaleTimeString("fr-FR", { hour: "2-digit", minute: "2-digit" });
      preselectFromFixtureParam();
    } else {
      showEmpty();
    }
    document.getElementById("loading").style.display = "none";
  }).catch(function() {
    document.getElementById("loading").style.display = "none";
    showEmpty();
  });
}

// Présélection depuis /live-ia?fixture=ID (lien "Ouvrir dans Live IA" de la
// page d'accueil) : fait défiler jusqu'à la carte du match réel identifié par
// l'API et la met en surbrillance. N'ouvre PAS automatiquement l'analyse —
// ça reste un geste explicite de l'utilisateur, pas une dépense de crédit
// déclenchée par un simple clic depuis l'accueil.
var _fixturePreselectDone = false;
function preselectFromFixtureParam() {
  if (_fixturePreselectDone) return;
  var fixture = new URLSearchParams(location.search).get("fixture");
  if (!fixture) return;
  var target = allMatches.find(function(m) {
    var id = m.id || (m.home + "_" + m.away).replace(/\s+/g, "_");
    return id === fixture || String(m.id) === fixture;
  });
  if (!target) return;
  _fixturePreselectDone = true;
  // Le filtre par defaut est "Football" — un match d'un autre sport ouvert
  // depuis "Voir" sur l'accueil ne se rendait jamais dans le DOM, donc le
  // scrollIntoView ne trouvait rien (signalé par le fondateur le 01/08/2026). On
  // bascule sur "Tous les sports" pour garantir que le match cible est visible
  // quel que soit son sport.
  if (currentFilter !== "all" && target.sport && target.sport !== currentFilter) {
    currentFilter = "all";
    document.querySelectorAll(".filter-btn").forEach(function(b){ b.classList.toggle("active", b.dataset.filter === "all"); });
    renderMatches();
  }
  var matchId = target.id || (target.home + "_" + target.away).replace(/\s+/g, "_");
  setTimeout(function() {
    var card = document.querySelector('[data-id="' + CSS.escape(matchId) + '"]');
    if (!card) return;
    card.scrollIntoView({ behavior: "smooth", block: "center" });
    card.style.outline = "2px solid var(--violet, #7c5cff)";
    card.style.outlineOffset = "3px";
    setTimeout(function() { card.style.outline = ""; }, 3000);
  }, 150);
}

function showEmpty() {
  var wrap = document.getElementById("matches-wrap");
  wrap.innerHTML = '<div class="empty-state"><div class="empty-icon">🏟️</div><div class="empty-title">Aucun match en direct</div><div class="empty-sub">Il n\'y a pas de match en cours pour le moment. Reviens plus tard ou consulte l\'historique des analyses.</div></div>';
}

// ── Render ──
function renderMatches() {
  var wrap = document.getElementById("matches-wrap");
  // Tous les matchs live restent affichés, jouables ou non (voir /live-matches) —
  // ça montre que le site suit vraiment l'activité en direct, même quand rien
  // n'est encore assez fort pour être analysé (demande du fondateur le 01/08/2026).
  var filtered = currentFilter === "all" ? allMatches : allMatches.filter(function(m){ return m.sport === currentFilter; });
  if (searchTerm) {
    filtered = filtered.filter(function(m) {
      return (m.home || "").toLowerCase().indexOf(searchTerm) !== -1
        || (m.away || "").toLowerCase().indexOf(searchTerm) !== -1
        || (m.competition || "").toLowerCase().indexOf(searchTerm) !== -1;
    });
  }
  if (advFilters.active) {
    filtered = filtered.filter(matchPassesAdvFilters);
  }
  var afCountEl = document.getElementById("af-count");
  if (afCountEl) afCountEl.textContent = advFilters.active ? (filtered.length + " match" + (filtered.length !== 1 ? "s" : "") + " trouvé" + (filtered.length !== 1 ? "s" : "")) : "";

  if (!filtered.length) {
    if (advFilters.active) {
      wrap.innerHTML = '<div class="empty-state"><div class="empty-icon">🎚️</div><div class="empty-title">Aucun match ne correspond à tes critères</div><div class="empty-sub">Essaie d\'assouplir un curseur, ou reviens dans quelques minutes — de nouveaux matchs évoluent en permanence.</div></div>';
    } else if (searchTerm) {
      wrap.innerHTML = '<div class="empty-state"><div class="empty-icon">🔍</div><div class="empty-title">Aucun résultat pour "' + escHtml(searchTerm) + '"</div><div class="empty-sub">Vérifie l\'orthographe ou essaie un autre sport dans les filtres.</div></div>';
    } else if (currentFilter !== "all") {
      wrap.innerHTML = '<div class="empty-state"><div class="empty-icon">' + (SPORT_ICONS[currentFilter] || "🏟️") + '</div><div class="empty-title">Aucun match ' + currentFilter + ' en direct</div><div class="empty-sub">Aucun match de ' + currentFilter + ' en cours. Essaie un autre sport ou reviens plus tard.</div></div>';
    } else {
      showEmpty();
    }
    return;
  }

  // Tri : en direct d'abord (des matchs les plus avancés vers les débuts de
  // match), puis à venir, puis terminés — pour remonter en haut les matchs
  // les plus proches de leur fin, où l'analyse a le plus de valeur immédiate.
  var order = { IN_PLAY: 0, PINNED_SIGNAL: 0, HT: 1, SCHEDULED: 2, TIMED: 2, FINISHED: 3 };
  function minuteOf(m) {
    var n = parseInt(m.minute, 10);
    return isNaN(n) ? -1 : n;
  }
  filtered.sort(function(a, b) {
    var oa = order[a.status] || 1, ob = order[b.status] || 1;
    if (oa !== ob) return oa - ob;
    if (oa === 0) return minuteOf(b) - minuteOf(a); // tri secondaire : minute décroissante pour les matchs en direct
    return 0;
  });

  var html = "";
  filtered.forEach(function(m) {
    var isLive = m.status === "IN_PLAY" || m.status === "HT" || m.status === "PINNED_SIGNAL";
    var isDone = m.status === "FINISHED";
    var sportIcon = SPORT_ICONS[m.sport] || "⚽";
    var scoreH = m.score_home !== null && m.score_home !== undefined ? m.score_home : "-";
    var scoreA = m.score_away !== null && m.score_away !== undefined ? m.score_away : "-";
    var comp = splitCompetition(m.competition || m.sport);
    var flag = countryFlag(comp.country);
    var countryHtml = comp.country ? '<span class="mc-country">' + (flag ? '<span>' + flag + '</span>' : '') + escHtml(comp.country) + '</span>' : '';

    var statusClass = isLive ? "live" : (isDone ? "finished" : "scheduled");
    var statusLabel = isLive ? (m.status === "HT" ? "Mi-temps" : "En direct") : (isDone ? "Terminé" : "À venir");
    var dotHtml = isLive ? '<span class="st-dot"></span>' : "";

    var minuteHtml = "";
    if (isLive) {
      minuteHtml = '<div class="mc-minute">' + escHtml(minuteLabel(m)) + '</div>';
    } else if (isDone) {
      minuteHtml = '<div class="mc-minute done">FT</div>';
    }

    var homeLogo = m.home_logo ? '<img src="' + safeImgUrl(m.home_logo) + '" alt="" loading="lazy">' : escHtml(initials(m.home));
    var awayLogo = m.away_logo ? '<img src="' + safeImgUrl(m.away_logo) + '" alt="" loading="lazy">' : escHtml(initials(m.away));

    var matchId = m.id || (m.home + "_" + m.away).replace(/\s+/g, "_");

    html += '<div class="match-card' + (isDone ? " finished" : "") + '" data-id="' + matchId + '">';
    html += '<div class="mc-header">';
    html += '  <div class="mc-sport"><span class="mc-sport-icon">' + sportIcon + '</span><span class="mc-comp">' + escHtml(comp.league || m.sport) + countryHtml + '</span></div>';
    html += '  <div class="mc-status ' + statusClass + '">' + dotHtml + statusLabel + '</div>';
    html += '</div>';
    html += '<div class="mc-body">';
    html += '  <div class="mc-team home"><div class="mc-logo">' + homeLogo + '</div><div class="mc-name">' + escHtml(m.home) + '</div></div>';
    html += '  <div class="mc-score-col"><div class="mc-score">' + scoreH + ' — ' + scoreA + '</div>' + minuteHtml + '</div>';
    html += '  <div class="mc-team away"><div class="mc-name">' + escHtml(m.away) + '</div><div class="mc-logo">' + awayLogo + '</div></div>';
    html += '</div>';

    if (m.pinnedSignal) {
      html += '<div class="mc-analysis visible">';
      html += '  <div class="mc-analysis-title">📡 Signal Fort — Analyse épinglée</div>';
      html += '  <div class="mc-analysis-text">' + escHtml(m.pinnedReason || "") + '</div>';
      if (m.pinnedBet) {
        var pcm = confMeta(m.pinnedConfidence);
        html += '<div class="conf-badge ' + pcm.cls + '"><span class="conf-dot ' + pcm.cls + '"></span>🎯 ' + escHtml(m.pinnedBet) + (m.pinnedConfidence ? " · " + m.pinnedConfidence + "/100 · " + pcm.label : "") + '</div>';
      }
      html += '</div>';
    }

    // Bouton d'analyse si le match est jouable maintenant ; sinon, étiquette
    // expliquant pourquoi (au lieu de faire disparaître le match — demande
    // du fondateur le 01/08/2026, ça montre que le site suit le match).
    // Les signaux épinglés sont exclus : leur analyse est déjà affichée au-dessus.
    if (isLive && !isDone && !m.pinnedSignal) {
      if (m.analysable === false) {
        html += '<div class="mc-cta"><div class="mc-not-playable">⏳ ' + escHtml(m.block_reason || "Pas encore de signal exploitable sur ce match.") + '</div></div>';
      } else {
        var cached = analysisCache[matchId];
        html += '<div class="mc-cta">';
        html += '  <button class="mc-analyse-btn" onclick="requestAnalysis(this,\'' + escAttr(matchId) + '\',\'' + escAttr(m.home) + '\',\'' + escAttr(m.away) + '\')"' + (!userAuth ? " title=\"Connecte-toi ou abonne-toi pour analyser\"" : "") + (cached ? " disabled" : "") + '>';
        html += (cached ? '✅ Analyse terminée' : (userAuth ? '🧠 Analyser ce match' : '🔓 Débloquer l\'analyse'));
        html += '  </button>';
        html += '</div>';
        html += '<div class="mc-analysis' + (cached ? ' visible' : '') + '" id="analysis-' + escAttr(matchId) + '">' + (cached ? cached : '') + '</div>';
      }
    }

    html += '</div>';
  });

  wrap.innerHTML = html;
}

// ── Analysis ──
// Construction du HTML du verdict — partagee entre le clic manuel
// (requestAnalysis) et la revérification silencieuse en arrière-plan
// (checkWatchedForUpdates), pour que les deux affichent exactement la même
// chose et que le panneau déjà ouvert se mette à jour tout seul.
function buildAnalysisHtml(d) {
  var synthese = d.agents ? d.agents[d.agents.length - 1] : null;
  var resumeText = d.resume || (synthese ? synthese.raison : "Analyse terminée");
  var betText = d.value_bet ? d.value_bet.marche : (synthese ? synthese.bet : "");
  var confText = d.value_bet ? d.value_bet.prob : (synthese ? synthese.confidence : "");
  var vote = d.vote_summary || {};
  var voteLabel = vote.vote_label || (d.consensus_votes && d.total_agents ? (d.consensus_votes + "/" + d.total_agents) : "");
  var voteStatus = vote.vote_status === "elite" ? "Signal Elite"
    : vote.vote_status === "strong" ? "Signal Fort"
    : vote.vote_status === "trend" ? "Tendance IA"
    : "Aucun signal validé";
  if (vote.vote_status === "none") betText = "";

  var agentsHtml = '<div style="font-size:12px;color:var(--muted2);margin-top:10px;padding:10px 12px;border-top:1px solid var(--b1);background:rgba(255,255,255,.03);border-radius:10px">'
    + '5 IA indépendantes votent sans émotion — Perplexity, DeepSeek, Mistral, Cohere et Qwen — à partir des statistiques live, de l\'historique, de la dynamique et des probabilités.'
    + '</div>';

  var cm = confMeta(confText);
  var noSignalHtml = !betText
    ? '<div class="conf-badge red blink-badge"><span class="conf-dot red"></span>🚫 Aucun signal fiable · Ne pas jouer ce match</div>' : "";
  var coteHtml = (betText && d.cote && Number(d.cote) > 1)
    ? '<div class="conf-badge" style="background:rgba(16,185,129,.08);border-color:rgba(16,185,129,.25);color:var(--green)">💰 Cote : ' + Number(d.cote).toFixed(2) + (d.cote_source && !/estimation/i.test(String(d.cote_source)) ? ' (' + escHtml(d.cote_source) + ')' : ' (estimation marché)') + '</div>' : "";
  // Depuis le 04/08/2026, "Cote" EST deja la moyenne ARJEL quand elle est
  // disponible (voir computeBestOdd cote serveur) — cet encart ne doit
  // s'afficher que si la cote principale vient d'un bookmaker isole (cote_source
  // ne commence pas par "moyenne ARJEL"), sinon on duplique le meme chiffre.
  var arjelHtml = (betText && d.arjel_avg_odd && d.arjel_bookmakers_count >= 2 && !/^moyenne ARJEL/i.test(String(d.cote_source || "")))
    ? '<div class="conf-badge" style="background:rgba(34,211,238,.08);border-color:rgba(34,211,238,.2);color:var(--cyan)">💰 Cote moyenne ANJ : ' + Number(d.arjel_avg_odd).toFixed(2) + ' (' + d.arjel_bookmakers_count + ' bookmakers)</div>' : "";
  // Marches secondaires (H2H reel) — demande du fondateur le 03/08/2026 : montrer
  // plusieurs marches sous l'analyse (BTTS%, 1ere mi-temps%, vainqueur%...),
  // pas juste le pick principal. Base sur le meme H2H que l'analyse IA, jamais
  // un chiffre invente. n<3 confrontations = trop peu fiable, on n'affiche pas.
  var marketsHtml = "";
  if (d.h2h_markets) {
    var hm = d.h2h_markets;
    var mkRow = function(label, pct) {
      return '<div style="display:flex;justify-content:space-between;align-items:center;padding:6px 0;border-top:1px solid var(--b1)">'
        + '<span style="color:var(--muted2);font-size:12.5px">' + label + '</span>'
        + '<span style="font-weight:800;font-size:13px">' + pct + '%</span></div>';
    };
    marketsHtml = '<div style="margin-top:10px;padding:10px 12px;background:rgba(255,255,255,.03);border-radius:10px">'
      + '<div style="font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.05em;font-weight:700">Autres marches — ' + hm.n + ' confrontations directes</div>'
      + mkRow('BTTS (les 2 marquent)', hm.btts_pct)
      + mkRow('But en 1ère mi-temps', hm.first_half_goal_pct)
      + mkRow('Victoire domicile', hm.home_win_pct)
      + mkRow('Victoire extérieur', hm.away_win_pct)
      + mkRow('Under 2.5 buts', hm.under25_pct)
      + '</div>';
  }
  // Score de confiance du Concile par marche (pas juste le pick principal) —
  // demande du fondateur le 04/08/2026 : "victoire domicile 86/100, en dessous
  // BTTS 80/100, en dessous under 2.5 60/100...". Vient de market_scores
  // (deja calcule cote serveur a partir des votes reels des agents, zero appel
  // IA supplementaire). Different de marketsHtml ci-dessus : ici c'est la
  // confiance du Concile, pas un pourcentage historique H2H.
  var scoresHtml = "";
  if (Array.isArray(d.market_scores) && d.market_scores.length) {
    var scoreRow = function(item) {
      var cm2 = confMeta(item.confidence);
      return '<div style="display:flex;justify-content:space-between;align-items:center;padding:6px 0;border-top:1px solid var(--b1)">'
        + '<span style="color:var(--muted2);font-size:12.5px">' + escHtml(item.market) + '</span>'
        + '<span class="conf-badge ' + cm2.cls + '" style="margin:0;padding:2px 9px;font-size:12px">' + item.confidence + '/100</span></div>';
    };
    scoresHtml = '<div style="margin-top:10px;padding:10px 12px;background:rgba(255,255,255,.03);border-radius:10px">'
      + '<div style="font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.05em;font-weight:700">Score du Concile par marché</div>'
      + d.market_scores.map(scoreRow).join("")
      + '</div>';
  }
  var voteReportHtml = voteLabel ? '<div class="mc-analysis-bet" style="background:rgba(34,211,238,.1);border-color:rgba(34,211,238,.22);color:var(--cyan)">Vote IA : ' + escHtml(voteLabel) + ' · ' + escHtml(voteStatus) + '</div>' : "";
  var html = '<div class="mc-analysis-title">🧠 Verdict du Concile IA</div>'
    + noSignalHtml
    + '<div class="mc-analysis-text">' + escHtml(resumeText) + '</div>'
    + (betText ? '<div class="conf-badge ' + cm.cls + '"><span class="conf-dot ' + cm.cls + '"></span>🎯 ' + escHtml(betText) + (confText ? " · " + confText + "/100 · " + cm.label : "") + '</div>' : "")
    + coteHtml
    + arjelHtml
    + marketsHtml
    + scoresHtml
    + agentsHtml
    + voteReportHtml
    + (d.credits_left !== undefined ? '<div style="font-size:11px;color:var(--muted);margin-top:8px">🎟️ Jetons restants aujourd\'hui : ' + d.credits_left + (d.credits_max ? '/' + d.credits_max : '') + '</div>' : "");
  return { html: html, voteLabel: voteLabel, betText: betText, confText: confText, resumeText: resumeText };
}

