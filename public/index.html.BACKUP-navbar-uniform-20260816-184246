/* ══ PICK GRATUIT DU JOUR ══ */
async function loadPick(){
  var box=document.getElementById('pick-body');
  var loggedIn=!!(localStorage.getItem('tlm_email')&&localStorage.getItem('tlm_plan'));
  try{
    var r=await fetch('/api/current-pick?t='+Date.now());
    var d=await r.json();
    var p=d.pick&&d.pick.currentPick?d.pick.currentPick:d.pick;
    // /current-pick passe toujours par normalizeCurrentPick() cote serveur,
    // qui renvoie teamA/teamB/marketLabel (partage avec d'autres consommateurs,
    // ex. generateur d'image Telegram) — jamais home/away/best_bet. Ce code
    // lisait les mauvais champs : un pick valide avec confiance s'affichait
    // comme "aucun pick disponible" (constate le 30/07/2026).
    var homeName=p&&(p.teamA&&p.teamA.name||p.home);
    var awayName=p&&(p.teamB&&p.teamB.name||p.away);
    if(!p||!homeName){
      box.innerHTML='<div class="empty-note">Aucun pick gratuit n\'est disponible actuellement.<br>Le Concile n\'a identifié aucune sélection correspondant aux critères du compte gratuit.</div>';
      return;
    }
    // Le pick affiché peut retomber sur le meilleur résultat des 7 derniers
    // jours quand rien n'est encore résolu aujourd'hui (voir refreshDailyPickFromDB
    // côté serveur). Affichait avant un match vieux de plusieurs jours comme
    // s'il était du jour même (constaté par le fondateur le 04/08/2026 : Instituto
    // Cordoba-Platense du 30/07). Un premier correctif a ajouté la date, mais
    // Le fondateur préfère un état vide plutôt qu'un match ancien même daté — donc on
    // n'affiche plus DU TOUT un pick qui n'est pas d'aujourd'hui.
    var isOldPick=false;
    if(p.matchTime){
      try{
        var _d=new Date(p.matchTime);
        if(!isNaN(_d.getTime())) isOldPick=(_d.toDateString()!==new Date().toDateString());
      }catch(e){}
    }
    if(isOldPick){
      box.innerHTML='<div class="empty-note">Aucun pick gratuit disponible pour l\'instant aujourd\'hui.<br>Le Concile n\'a pas encore identifié de sélection correspondant à nos critères — reviens plus tard dans la journée.</div>';
      return;
    }
    var betLabel=p.marketLabel||p.marketType||p.best_bet||'';
    var homeLogo=p.home_logo||(p.teamA&&p.teamA.logo)||null;
    var awayLogo=p.away_logo||(p.teamB&&p.teamB.logo)||null;
    var comp=splitComp(p.competition||p.sport||'');
    var flag=COUNTRY_FLAGS[comp.country]||'';
    var sportIco=SPORT_ICO[p.sport]||'🏟️';
    // Heure locale du visiteur : le navigateur convertit automatiquement
    // matchTime (UTC) dans SON fuseau, quel que soit le pays de connexion —
    // pas besoin de geolocaliser l'IP. Demande du fondateur le 31/07/2026.
    var timeHtml='';
    if(p.matchTime){
      try{
        var _d=new Date(p.matchTime);
        if(!isNaN(_d.getTime())){
          timeHtml='<span class="pick-time">🕐 '+_d.toLocaleTimeString(undefined,{hour:'2-digit',minute:'2-digit'})+'</span>';
        }
      }catch(e){}
    }
    // Match termine (win/loss) : le score final et le pari conseille
    // deviennent une preuve historique, plus une info a proteger — on les
    // affiche a tout le monde, meme sans compte. Demande du fondateur le
    // 31/07/2026 : mettre a jour le pick avec le score des que le match
    // est fini, montrer le nouveau pick + pari conseille le lendemain.
    var resolved=(p.status==='win'||p.status==='loss');
    var showBet=loggedIn||resolved;
    var scoreHtml=(resolved&&p.scoreA!=null&&p.scoreB!=null)
      ? '<div class="pick-score-badge '+(p.status==='win'?'win':'loss')+'">'+esc(p.scoreA)+' - '+esc(p.scoreB)+' · '+(p.status==='win'?'✓ Gagné':'✗ Perdu')+'</div>'
      : '';
    var lockHtml=showBet?'':(
      '<div class="pick-lock">'+
        '<div class="pick-lock-title">🔒 Sélection et raisonnement masqués</div>'+
        '<div class="pick-lock-sub">Pour voir la sélection recommandée du Concile, entre juste ton email (+ un mot de passe) — c\'est gratuit, sans carte bancaire, ça prend 20 secondes.</div>'+
        '<a href="/dashboard" class="pick-lock-btn">Débloquer avec mon email →</a>'+
      '</div>'
    );
    box.innerHTML='<div class="pick-comp">'+sportIco+' '+(flag?'<span class="flag">'+flag+'</span>':'')+esc(comp.league)+(comp.country?' · '+esc(comp.country):'')+timeHtml+'</div>'+
      '<div class="pick-match">'+
        '<div class="pick-team"><div class="pick-team-logo">'+logo(homeLogo,homeName)+'</div><div class="pick-team-name">'+esc(homeName)+'</div></div>'+
        '<div class="pick-vs">VS</div>'+
        '<div class="pick-team"><div class="pick-team-logo">'+logo(awayLogo,awayName)+'</div><div class="pick-team-name">'+esc(awayName)+'</div></div>'+
      '</div>'+
      scoreHtml+
      '<div class="pick-bet">'+(showBet?esc(betLabel):'Sélection réservée aux membres')+'</div>'+
      '<div class="pick-conf">'+esc(p.confidence)+'/100</div>'+
      lockHtml+
      '<button type="button" class="pick-email-btn" onclick="openModal()">📩 Recevoir le pick du jour par email</button>';
  } catch(e){
    box.innerHTML='<div class="empty-note">Aucun pick gratuit n\'est disponible actuellement.</div>';
  }
}
