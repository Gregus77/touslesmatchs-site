    // rester pertinent (le reste de la liste, au-dela, s'affiche quand meme
    // en dessous si dispo, juste pas dans le grand encart mis en avant).
    var in24h=allPicks.filter(function(p){
      var kd=new Date(p.kickoff);
      if(isNaN(kd.getTime())) return true;
      return (kd.getTime()-Date.now()) <= 24*3600*1000;
