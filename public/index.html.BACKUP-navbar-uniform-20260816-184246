<script>
(function(){
  function norm(s){return String(s||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase();}
  function fmt(n){return Number(n||0).toLocaleString('fr-FR');}
  var mois={janvier:'01',fevrier:'02',mars:'03',avril:'04',mai:'05',juin:'06',juillet:'07',aout:'08',septembre:'09',octobre:'10',novembre:'11',decembre:'12'};
  function isoFromText(t){
    var x=norm(t);
    var m=x.match(/(lundi|mardi|mercredi|jeudi|vendredi|samedi|dimanche)\s+(\d{1,2})\s+([a-z]+)/);
    if(!m||!mois[m[3]]) return null;
    return '2026-'+mois[m[3]]+'-'+String(m[2]).padStart(2,'0');
  }
  function applyDailyStats(d){
    if(!d||!d.ok) return;
    var concile={}, agent={};
    (d.daily_concile||[]).forEach(function(r){concile[r.jour]=r;});
    (d.daily_agent||[]).forEach(function(r){agent[r.jour]=r;});

    document.querySelectorAll('summary, .day-row, .history-day, details, div').forEach(function(el){
      var txt=el.textContent||'';
      if(!/selection retenue|sélection retenue/i.test(txt)) return;
      var iso=isoFromText(txt);
      if(!iso) return;
      var c=concile[iso]||{};
      var a=agent[iso]||{};
      if(!c.analyses && !a.matches) return;
      var msg=fmt(c.analyses||0)+' analyses Concile · '+fmt(a.matches||0)+' matchs IA · '+fmt(a.predictions||0)+' prédictions';
      el.querySelectorAll('*').forEach(function(child){
        if(/selection retenue|sélection retenue/i.test(child.textContent||'')) child.textContent=msg;
      });
      if(/selection retenue|sélection retenue/i.test(el.textContent||'') && el.children.length===0) el.textContent=el.textContent.replace(/0\s+s[ée]lection retenue/i,msg);
    });
  }
  fetch('/api/public-analysis-stats?t='+Date.now()).then(function(r){return r.json();}).then(applyDailyStats).catch(function(){});
})();
</script>
