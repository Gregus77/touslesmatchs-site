<style>
:root{
  --bg:#12152a; --panel:#171b34; --panel2:#1e2340;
  --b1:rgba(255,255,255,.11); --b2:rgba(255,255,255,.18);
  --tx:#f6f7ff; --tx2:#c4c9e6; --muted:#949bc4;
  --violet:#8a68ff; --violet2:#a688ff; --blue:#4b7bff; --cyan:#4fd6f2;
  --standard:#6a9bff; --premium:#a688ff; --elite:#eab24a;
  --green:#3ddb96; --red:#f16e80;
  --r-sm:8px; --r-md:12px; --r-lg:16px;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%;text-size-adjust:100%}
body{margin:0;background:var(--bg);color:var(--tx);font-family:'Inter',system-ui,sans-serif;-webkit-font-smoothing:antialiased;line-height:1.45;font-size:16px;overflow-x:hidden}
img{max-width:100%;display:block}
a{color:inherit}
.wrap{max-width:1360px;margin:0 auto;padding:0 24px}
h1,h2,h3{margin:0;font-weight:800;letter-spacing:-.02em}
.card{background:var(--panel);border:1px solid var(--b1);border-radius:var(--r-md);transition:transform .22s ease,box-shadow .22s ease,border-color .22s ease}
.card:hover{transform:translateY(-3px);box-shadow:0 14px 32px -12px rgba(124,92,255,.35);border-color:rgba(155,123,255,.3)}
.acc-green{border-top:3px solid var(--green)}
.acc-blue{border-top:3px solid var(--standard)}
.acc-violet{border-top:3px solid var(--violet)}
.acc-cyan{border-top:3px solid var(--cyan)}
.live-panel{border-top:3px solid var(--red)}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;padding:10px 18px;border-radius:9px;font-weight:700;font-size:15px;text-decoration:none;border:1px solid transparent;cursor:pointer;white-space:nowrap}
.btn-prim{background-color:var(--violet);background-image:linear-gradient(135deg,var(--violet),var(--blue));border-color:var(--violet);color:#fff}
.btn-prim:hover{opacity:.92}
.btn-ghost{background:transparent;border-color:var(--b2);color:var(--tx)}
.btn-ghost:hover{border-color:var(--violet2)}
.btn-block{width:100%;white-space:normal;line-height:1.3;padding:10px 12px;text-align:center}
.btn-sm{padding:7px 13px;font-size:14px}

/* ── NAV ── */
nav{position:sticky;top:0;z-index:200;display:flex;align-items:center;justify-content:space-between;gap:20px;padding:14px 24px;background:rgba(18,21,42,.9);backdrop-filter:blur(14px);border-bottom:1px solid var(--b1)}
.nav-brand{font-weight:900;font-size:18.5px;flex:0 0 auto}
.nav-brand b{color:var(--violet2)}
.nav-center{display:flex;gap:6px;flex-wrap:wrap;justify-content:center;flex:1}
.nav-center a{font-size:13px;font-weight:500;color:#a8aec8;text-decoration:none;padding:6px 16px;border-radius:8px;transition:all .15s;display:inline-flex;align-items:center}
.nav-center a:hover{color:#eceaf4;background:rgba(255,255,255,.06)}
.nav-live-dot{display:inline-block;width:7px;height:7px;border-radius:50%;background:#f43f5e;margin-right:6px;animation:navPulseDot 1.5s infinite}
.nav-live-link{color:#22d3ee !important}
@keyframes navPulseDot{0%,100%{opacity:1;box-shadow:0 0 0 0 rgba(244,63,94,.6)}50%{opacity:.7;box-shadow:0 0 0 5px rgba(244,63,94,0)}}
.nav-right{display:flex;align-items:center;gap:10px;flex:0 0 auto}
.nav-hamburger{display:none;background:none;border:1px solid var(--b2);border-radius:8px;color:var(--tx);width:36px;height:36px;font-size:17px;cursor:pointer}
.nav-plan-badge{font-size:12.5px;font-weight:800;padding:5px 10px;border-radius:999px;background:rgba(124,92,255,.15);color:var(--violet2);border:1px solid rgba(124,92,255,.3)}
.nav-plan-badge.elite{background:rgba(224,166,60,.14);color:var(--elite);border-color:rgba(224,166,60,.32)}
.nav-user{display:flex;align-items:center;gap:8px}
.nav-logout{background:none;border:1px solid var(--b2);color:var(--tx2);border-radius:8px;width:28px;height:28px;cursor:pointer;font-size:14px}
@media(max-width:900px){ .nav-center{display:none} .nav-hamburger{display:block} }
/* Sous ~480px, badge Elite + bouton deconnexion + CTA "Creer mon compte
   gratuit" + hamburger ne tenaient plus sur une ligne : nav-right refusait
   de retrecir (flex:0 0 auto), la barre debordait horizontalement et le
   mobile zoomait toute la page pour compenser (tout apparaissait
   retreci a gauche avec du vide a droite — constate le 30/07/2026 sur
   Android). Le CTA est redondant une fois connecte : on le masque alors,
   et on retrecit le reste en dernier recours. */
#nav-auth:has(.nav-user) ~ .btn-prim{ display:none }
@media(max-width:480px){
  nav{padding:12px 14px;gap:10px}
  .nav-right{gap:6px}
  .nav-right > a.btn-prim{padding:8px 12px;font-size:12.5px}
}
/* Sous ~560px (ex: Galaxy Z Fold — écran de couverture ~344px CSS), le trio
   marque + "Se connecter" + "Créer mon compte gratuit" + hamburger ne tient
   plus sur une ligne malgré le retrecissement ci-dessus : la barre debordait
   horizontalement et il fallait faire glisser la nav pour atteindre "Se
   connecter" (constate le 31/07/2026). Le CTA est deja disponible dans le
   menu hamburger (.mmenu) donc on le retire sans rien perdre. */
@media(max-width:560px){
  .nav-right > a.btn-prim{display:none}
  .nav-brand{font-size:16px}
}
@media(max-width:360px){
  .nav-brand{font-size:14px}
  .nav-right #nav-auth .btn{padding:8px 12px;font-size:13px}
}
.mmenu{display:none;position:fixed;inset:0;z-index:199;background:rgba(18,21,42,.98);padding:90px 24px 24px;flex-direction:column;gap:18px}
.mmenu.open{display:flex}
.mmenu a{font-size:18.5px;font-weight:700;color:var(--tx);text-decoration:none;padding:10px 0;border-bottom:1px solid var(--b1)}

.dash{padding:24px 0 60px}
.row{display:grid;gap:16px;margin-bottom:16px}

/* ── HERO WOW — capture validée + animation des ondes ── */
.row-hero{grid-template-columns:1fr}
.hero-exact-card{
  position:relative;overflow:hidden;padding:0!important;min-height:0;
  border-radius:18px;border:1px solid rgba(117,91,255,.46);
  background:#080b20;
  box-shadow:0 22px 60px rgba(0,0,0,.34),0 0 28px rgba(101,70,255,.14)
}
.hero-exact-wrap{position:relative;width:100%;aspect-ratio:815/611;overflow:hidden;border-radius:17px}
.hero-exact-img{display:block;width:100%;height:100%;object-fit:cover}
.hero-wave-overlay{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;overflow:visible}
.hero-wave-overlay .energy-path{fill:none;stroke-width:5;stroke-linecap:round;stroke-dasharray:14 24;opacity:.38;animation:waveTravel 1.35s linear infinite}
.hero-wave-overlay .energy-path.deep{stroke:#5da6ff;filter:url(#glowBlue)}
.hero-wave-overlay .energy-path.mistral{stroke:#ff9d3e;filter:url(#glowOrange)}
.hero-wave-overlay .energy-path.cohere{stroke:#ff65bd;filter:url(#glowPink)}
.hero-wave-overlay .energy-path.perplexity{stroke:#38e8ee;filter:url(#glowCyan)}
.hero-wave-overlay .energy-path.qwen{stroke:#a878ff;filter:url(#glowPurple)}
@keyframes waveTravel{to{stroke-dashoffset:-76}}
.hero-wave-overlay .core-pulse{fill:none;stroke:#d6c6ff;stroke-width:2;opacity:0;filter:url(#glowCore);transform-origin:584px 312px;animation:corePulse 2.6s ease-out infinite}
.hero-wave-overlay .core-pulse.p2{animation-delay:1.25s}
@keyframes corePulse{0%{transform:scale(.72);opacity:0}20%{opacity:.68}100%{transform:scale(1.32);opacity:0}}
.hero-wave-dot{filter:url(#glowCore)}
.hero-exact-hotspot{position:absolute;z-index:4;display:block;text-indent:-9999px;overflow:hidden;background:transparent;border-radius:12px}
.hero-exact-hotspot.live{left:4.3%;top:65.4%;width:36.7%;height:8.8%}
.hero-exact-hotspot.account{left:4.3%;top:75.3%;width:36.7%;height:7.5%}
.hero-exact-hotspot:focus-visible{outline:2px solid #8be7ff;box-shadow:0 0 0 4px rgba(67,205,255,.24)}
.hero-seo-copy{position:absolute!important;left:-10000px!important;width:1px!important;height:1px!important;overflow:hidden!important}
.hero-mobile-fallback{display:none;padding:28px 20px;background:linear-gradient(135deg,#090d24,#0c1230)}
.hero-mobile-fallback .hero-badge{display:inline-block;font-size:11.5px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:var(--violet2);background:rgba(124,92,255,.1);border:1px solid rgba(124,92,255,.25);padding:5px 12px;border-radius:999px;margin-bottom:16px}
.hero-mobile-fallback h1{font-size:34px;line-height:1.12}.hero-mobile-fallback h1 .grad{background:linear-gradient(105deg,#56c8ff,#a46cff,#f06cf7);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.hero-mobile-fallback .hero-sub{font-size:15px;color:var(--tx2);margin-top:14px;line-height:1.6}
.hero-mobile-fallback .hero-cta{display:grid;gap:10px;margin-top:20px}.hero-mobile-fallback .hero-reassure{display:flex;gap:8px;flex-wrap:wrap;margin-top:16px;font-size:12px;color:var(--muted)}
@media(max-width:760px){.hero-exact-wrap{display:none}.hero-mobile-fallback{display:block}}
@media(prefers-reduced-motion:reduce){.hero-wave-overlay .energy-path,.hero-wave-overlay .core-pulse{animation:none!important}.hero-wave-dot{display:none}}

/* ── LIVE PANEL ── */
.live-panel{padding:20px;display:flex;flex-direction:column;gap:10px}
.live-panel-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:2px}
.live-panel-title{font-size:15px;font-weight:800}
.live-panel-title .dot{width:7px;height:7px;border-radius:50%;background:var(--red);display:inline-block;margin-right:7px;animation:pulse 1.6s infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.3}}
.live-panel-link{font-size:12.5px;font-weight:700;color:var(--violet2);text-decoration:none}
.upcoming-sep{display:flex;align-items:center;gap:10px;font-size:13.5px;font-weight:800;color:#fff;margin:16px 0 12px;padding:11px 15px;border-radius:11px;background:linear-gradient(135deg,rgba(62,201,232,.22),rgba(99,102,241,.22));border:1px solid rgba(62,201,232,.4)}
.upcoming-sep .dot.up{width:9px;height:9px;border-radius:50%;background:#3ec9e8;display:inline-block;box-shadow:0 0 8px #3ec9e8;animation:pulse 1.6s infinite}
.upcoming-conf-100{animation:blink100 1s infinite;box-shadow:0 0 0 rgba(255,214,10,.6)}
@keyframes blink100{0%,100%{background:rgba(255,214,10,.22);color:#ffd60a;box-shadow:0 0 10px rgba(255,214,10,.5)}50%{background:rgba(255,214,10,.55);color:#fff;box-shadow:0 0 18px rgba(255,214,10,.9)}}
.upcoming-item{display:flex;align-items:center;gap:12px;padding:14px 16px;border:1px solid var(--b1);border-radius:14px;margin-bottom:10px;background:linear-gradient(135deg,rgba(99,102,241,.07),rgba(124,58,237,.03));transition:transform .15s ease,box-shadow .15s ease,border-color .15s ease}
.upcoming-item:last-child{margin-bottom:0}
.upcoming-item[onclick]:hover{transform:translateY(-2px);box-shadow:0 10px 28px rgba(99,102,241,.2);border-color:var(--violet)}
.upcoming-info{flex:1;min-width:0}
.upcoming-teams{font-size:14px;font-weight:800}
.upcoming-comp{font-size:11.5px;color:var(--muted);margin-top:3px}
.upcoming-conf{font-size:12.5px;font-weight:800;color:#3ec9e8;white-space:nowrap;background:rgba(62,201,232,.12);padding:6px 11px;border-radius:9px;display:inline-block}
.upcoming-odd{background:rgba(124,58,237,.16);padding:2px 8px;border-radius:7px}
.upcoming-lock-btn{font-size:11.5px;font-weight:700;color:#fff;background:linear-gradient(135deg,var(--indigo),var(--violet));padding:6px 12px;border-radius:8px;border:none;cursor:pointer;white-space:nowrap}

/* ── PANNEAU MATCHS A VENIR (encart distinct, separe de "en cours") ── */
.upcoming-panel{border-top:3px solid #3ec9e8;padding:20px;display:flex;flex-direction:column;gap:10px}
.live-panel-title .dot.up{background:#3ec9e8;box-shadow:0 0 8px #3ec9e8}
.upcoming-highlight{display:flex;align-items:center;gap:14px;padding:16px 18px;border-radius:14px;margin-bottom:4px;background:linear-gradient(135deg,rgba(62,201,232,.18),rgba(99,102,241,.14));border:1.5px solid rgba(62,201,232,.45)}
.upcoming-highlight-badge{font-size:10.5px;font-weight:800;letter-spacing:.03em;text-transform:uppercase;color:#3ec9e8;background:rgba(62,201,232,.14);padding:4px 9px;border-radius:7px;white-space:nowrap}
.upcoming-highlight-teams{font-size:17px;font-weight:900}
.upcoming-highlight-sub{font-size:12.5px;color:var(--muted);margin-top:4px}
.upcoming-highlight-bet{font-size:13.5px;font-weight:800;color:#3ec9e8;white-space:nowrap;margin-left:auto}
@media(max-width:700px){
  .upcoming-highlight{flex-direction:column;align-items:flex-start;gap:8px}
  .upcoming-highlight-bet{margin-left:0}
}
.day-acc-item{border:1px solid var(--b1);border-radius:12px;margin-bottom:8px;overflow:hidden}
.day-acc-item:last-child{margin-bottom:0}
.day-acc-head{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:13px 15px;cursor:pointer;background:rgba(255,255,255,.02);transition:background .15s}
.day-acc-head:hover{background:rgba(124,92,255,.06)}
.day-acc-date{font-size:13.5px;font-weight:800;display:flex;align-items:center;gap:8px}
.day-acc-caret{transition:transform .2s;color:var(--muted);font-size:12px}
.day-acc-item.open .day-acc-caret{transform:rotate(90deg)}
.day-acc-summary{font-size:12.5px;font-weight:700;white-space:nowrap}
.day-acc-body{max-height:0;overflow:hidden;transition:max-height .25s ease}
.day-acc-item.open .day-acc-body{max-height:600px}
.day-acc-row{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:10px 15px;border-top:1px solid var(--b1);font-size:12.5px}
.day-acc-row-teams{font-weight:700;flex:1;min-width:0}
.day-acc-row-bet{color:var(--tx2);font-size:11.5px;margin-top:2px}
.day-acc-row-badge{font-weight:800;white-space:nowrap;padding:4px 9px;border-radius:7px;font-size:11.5px}
.live-row{display:flex;align-items:center;gap:10px;padding:9px 0;border-top:1px solid var(--b1)}
.live-row:first-of-type{border-top:none}
.live-comp{width:46px;flex:0 0 auto}
.live-comp-name{font-size:11.5px;font-weight:700;color:var(--tx2)}
.live-comp-min{font-size:11.5px;font-weight:800;color:var(--cyan)}
.live-logo{width:22px;height:22px;border-radius:6px;background:var(--panel2);flex:0 0 auto;display:flex;align-items:center;justify-content:center;font-size:10.5px;font-weight:800;overflow:hidden}
.live-team-name{font-size:14px;font-weight:700;flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.live-score{font-size:15px;font-weight:900;padding:3px 8px;border-radius:6px;background:linear-gradient(135deg,rgba(124,92,255,.22),rgba(59,109,255,.22));box-shadow:inset 0 0 0 1px rgba(155,123,255,.3);flex:0 0 auto}
.empty-note{text-align:center;color:var(--muted);font-size:14px;padding:24px 8px}

/* ── PREUVES (rangee 2) ── */
.proof-bar{display:grid;grid-template-columns:repeat(6,1fr)}
.proof-cell{padding:18px 14px;display:flex;align-items:center;gap:12px;border-right:1px solid var(--b1)}
.proof-cell:last-child{border-right:none}
.proof-ico{width:38px;height:38px;border-radius:11px;display:flex;align-items:center;justify-content:center;flex:0 0 auto}
.proof-num{font-size:22px;font-weight:900;line-height:1.1}
.proof-lbl{font-size:12px;color:var(--muted);font-weight:600;margin-top:1px}
.proof-note{text-align:center;font-size:12px;color:var(--muted);padding:10px 16px}
@media(max-width:900px){.proof-bar{grid-template-columns:repeat(3,1fr)}.proof-cell{border-bottom:1px solid var(--b1)}}
@media(max-width:520px){.proof-bar{grid-template-columns:repeat(2,1fr)}}

/* ── RANGEE 3 : pick / standard-hier / methode / resultats (4 colonnes) ── */
.row-4{grid-template-columns:repeat(4,1fr)}
.pcard{padding:16px;display:flex;flex-direction:column;min-height:0}
.pcard-title{font-size:13px;font-weight:800;margin-bottom:10px;display:flex;justify-content:space-between;align-items:center}
.pcard-title .badge{font-size:10.5px;font-weight:800;letter-spacing:.05em;text-transform:uppercase;background:rgba(51,196,129,.14);color:var(--green);border:1px solid rgba(51,196,129,.3);padding:3px 8px;border-radius:999px}
.pick-comp{font-size:12px;color:var(--muted);display:flex;align-items:center;gap:6px;font-weight:700;text-transform:uppercase;letter-spacing:.03em}
.pick-time{margin-left:auto;color:var(--tx2);font-weight:800}
.pick-comp .flag{font-size:14px}
.pick-match{display:flex;align-items:center;justify-content:center;gap:14px;margin:14px 0 10px}
