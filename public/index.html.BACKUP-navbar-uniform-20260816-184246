(function(){
  function fmt(n){ return Number(n||0).toLocaleString('fr-FR'); }
  function replaceText(root, d){
    var msg = fmt(d.matches_tracked) + " matchs analysés par IA · " + fmt(d.predictions_tracked) + " prédictions · " + fmt(d.predictions_resolved) + " résolues";
    var walker = document.createTreeWalker(root || document.body, NodeFilter.SHOW_TEXT);
    var nodes = [];
    while(walker.nextNode()) nodes.push(walker.currentNode);
    nodes.forEach(function(n){
      var t = n.nodeValue || "";
      if (/\b\d+\s+analyses?\s+de\s+matchs?\b/i.test(t) || /\b\d+\s+analyses?\b/i.test(t)) {
        n.nodeValue = t.replace(/\b\d+\s+analyses?\s+de\s+matchs?\b/i, msg).replace(/\b\d+\s+analyses?\b/i, msg);
      }
    });
    var meta = document.getElementById("agent-meta");
    if(meta && !meta.textContent.trim()){
      meta.textContent = msg;
    }
  }
  fetch('/api/public-analysis-stats?t=' + Date.now())
    .then(function(r){ return r.json(); })
    .then(function(d){ if(d && d.ok) replaceText(document.body, d); })
    .catch(function(){});
})();
