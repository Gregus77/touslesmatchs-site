      if(!byDay[day]) byDay[day]=[];
      byDay[day].push(a);
    });
    // Calendrier CONTINU sur 14 jours plutot que la seule liste des jours ayant
    // produit un verdict : un jour absent laissait croire a un trou dans le
    // suivi, alors qu'il signifie « aucune selection n'a passe les filtres ».
    // Un jour vide est une information, pas une donnee manquante.
    var order=[];
    for(var k=0;k<14;k++){
      var dt=new Date(); dt.setDate(dt.getDate()-k);
      order.push(dt.getFullYear()+'-'+String(dt.getMonth()+1).padStart(2,'0')+'-'+String(dt.getDate()).padStart(2,'0'));
    }
    // Bandeau saisonnier : affiche jusqu'a la reprise des championnats, il
    // explique le faible volume au lieu de laisser le visiteur conclure que le
    // service ne tourne pas. Se retire tout seul le 15 aout, sans intervention.
    var REPRISE=new Date('2026-08-15T00:00:00Z');
    var banniere='';
    if(Date.now()<REPRISE.getTime()){
      var joursRestants=Math.max(0,Math.ceil((REPRISE.getTime()-Date.now())/864e5));
      banniere='<div class="saison-note">'
        + '<span class="saison-dot"></span>'
        + '<div><div class="saison-t">Trêve estivale — reprise des championnats le 15 août'
        +   (joursRestants>0?' (J-'+joursRestants+')':'')+'</div>'
        +   '<div class="saison-x">Les grands championnats sont à l\'arrêt : peu de rencontres se '
        +   'qualifient en ce moment, et le Concile ne baisse pas ses critères pour en afficher davantage. '
        +   '<a href="#pick">Crée ton compte gratuit</a> dès maintenant pour recevoir la sélection du jour '
        +   'dès la reprise.</div></div></div>';
    }
    if(!rows.length && !banniere){ box.innerHTML='<div class="empty-note">Aucun verdict résolu pour l\'instant.</div>'; return; }
    var TIER_META={
      standard:{ico:'🥇',nom:'Telegram Standard', court:'Standard', c:'var(--standard)'},
      premium :{ico:'🥈',nom:'Telegram Premium',  court:'Premium',  c:'var(--premium)'},
      elite   :{ico:'🥉',nom:'Telegram Elite-VIP',court:'Elite',    c:'var(--elite)'}
    };
    var TIER_ORDRE=['standard','premium','elite'];
    box.innerHTML=banniere+order.map(function(day,idx){
      var list=byDay[day]||[];
      if(!list.length){
        return '<div class="day-acc-item vide" data-day-idx="'+idx+'">'
          + '<div class="day-acc-head" onclick="toggleDayAcc('+idx+')">'
          +   '<div class="day-acc-date"><span class="day-acc-caret">▶</span>'+esc(fmtDayLabel(day))+'</div>'
          +   '<div class="day-acc-summary" style="color:var(--muted)">0 sélection retenue</div>'
          + '</div>'
          + '<div class="day-acc-body"><div class="day-vide-note">Aucune rencontre n\'a satisfait '
          + 'les critères du Concile ce jour-là : championnat non fiable, accord des IA insuffisant '
          + 'ou cote hors de la fenêtre retenue. Une journée sans sélection est un choix, pas une absence de suivi.</div></div>'
          + '</div>';
      }
      var wins=list.filter(function(a){ return a.outcome==='win'; }).length;
      var profit=0;
      list.forEach(function(a){
        var cote=Number(a.cote)>1?Number(a.cote):0;
        profit += a.outcome==='win' ? (cote?cote*10-10:0) : -10;
      });
      var rowsHtml=list.map(function(a){
        var win=a.outcome==='win';
        var badgeStyle=win?'background:rgba(51,196,129,.14);color:var(--green)':'background:rgba(239,90,111,.14);color:var(--red)';
        var cote=(a.cote!=null && a.cote>1)?'@'+Number(a.cote).toFixed(2):'';
        // On lit la diffusion REELLE (champ sent, alimente par sig_sent_*) et non
        // le palier theorique : une analyse peut remplir les criteres d'un palier
        // sans avoir ete envoyee (plafond journalier, cote sortie de la fenetre
        // ARJEL au moment de l'envoi...). Afficher le palier theorique en
        // pretendant montrer la diffusion trompait le visiteur.
        // Cumulatif : un signal parti sur Standard part aussi sur Premium et Elite.
        var envoye=a.sent||{};
        var canaux=TIER_ORDRE.filter(function(t){ return envoye[t]; });
        var tierBadge='';
        if(canaux.length){
          tierBadge='<span class="tier-recu">Reçu par '
            + canaux.map(function(t){
                var m=TIER_META[t];
                return '<span class="tier-chip" style="color:'+m.c+'">'+m.ico+' '+m.nom+'</span>';
              }).join('')
            + '</span>';
        } else {
          // Non envoye : on donne le MOTIF plutot qu'un constat sec. Le visiteur
          // comprend que la selection est filtree, pas que le systeme a rate
          // quelque chose — c'est meme un argument de serieux.
          var motif=a.diffusion_block||'';
          var lisible=motif
            ? (/confiance/i.test(motif)      ? 'confiance sous le seuil de diffusion'
             : /ARJEL|cote/i.test(motif)      ? 'cote hors fenêtre ARJEL'
             : /votes/i.test(motif)           ? 'accord des IA insuffisant'
             : /qualite|qualité/i.test(motif) ? 'écartée par le filtre qualité'
             : /deja|déjà/i.test(motif)       ? 'signal déjà envoyé ce jour-là'
             : /feminin|féminin/i.test(motif) ? 'match féminin (exclu)'
             : /ligue/i.test(motif)           ? 'ligue non fiable'
             : 'critères de diffusion non atteints')
            : 'critères de diffusion non atteints';
          tierBadge='<span class="tier-recu tier-none">Observation publique du moteur — '+esc(lisible)+'</span>';
        }
        return '<div class="day-acc-row">'
          + '<div class="day-acc-row-teams">'+esc(a.home)+' — '+esc(a.away)+'<div class="day-acc-row-bet">'+esc(a.bet||'')+(cote?' · '+cote:'')+'</div>'+tierBadge+'</div>'
          + '<div class="day-acc-row-badge" style="'+badgeStyle+'">'+(win?'✓ Gagné':'✗ Perdu')+'</div>'
          + '</div>';
      }).join('');
      return '<div class="day-acc-item" data-day-idx="'+idx+'">'
        + '<div class="day-acc-head" onclick="toggleDayAcc('+idx+')">'
        +   '<div class="day-acc-date"><span class="day-acc-caret">▶</span>'+esc(fmtDayLabel(day))+'</div>'
        +   '<div class="day-acc-summary" style="color:'+(profit>=0?'var(--green)':'var(--red)')+'">'+wins+'/'+list.length+' gagnés · '+fmtSignedEur(profit)+'</div>'
        + '</div>'
        + '<div class="day-acc-body">'+rowsHtml+'</div>'
        + '</div>';
    }).join('');
  }catch(e){ box.innerHTML='<div class="empty-note">Impossible de charger les verdicts pour le moment.</div>'; }
}
