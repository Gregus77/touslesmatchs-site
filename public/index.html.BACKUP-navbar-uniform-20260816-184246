/* ══ CONNEXION BIOMETRIQUE (Face ID / empreinte, mobile) ══ */
function isMobileDevice(){ return /Android|iPhone|iPad|iPod|Mobile/i.test(navigator.userAgent); }
async function biometricSupported(){
  try{
    return isMobileDevice() && window.PublicKeyCredential && typeof SimpleWebAuthnBrowser!=='undefined' && await PublicKeyCredential.isUserVerifyingPlatformAuthenticatorAvailable();
  }catch(e){ return false; }
}
async function maybeOfferBiometric(email,code){
  if(!(await biometricSupported())) return;
  if(localStorage.getItem('tlm_webauthn_email')===email) return;
  if(localStorage.getItem('tlm_webauthn_declined_'+email)==='1') return;
  if(!confirm('Activer la connexion par Face ID / empreinte sur ce téléphone pour la prochaine fois ?')){
    localStorage.setItem('tlm_webauthn_declined_'+email,'1');
    return;
  }
  try{
    var r1=await fetch('/api/webauthn/register-options',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({email:email,code:code})});
    var d1=await r1.json();
    if(!d1.ok) throw new Error(d1.error||'options');
    var attResp=await SimpleWebAuthnBrowser.startRegistration({optionsJSON:d1.options});
    var r2=await fetch('/api/webauthn/register-verify',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({email:email,code:code,credential:attResp,deviceLabel:navigator.userAgent.slice(0,80)})});
    var d2=await r2.json();
