  .bankroll-view { display: flex; align-items: baseline; gap: 10px; margin-bottom: 4px; }
  .bankroll-amount { font-size: 34px; font-weight: 900; color: #10b981; }
  .edit-link { font-size: 12px; color: #6366f1; cursor: pointer; }

  /* Slider */
  .odds-value { font-size: 30px; font-weight: 900; color: #22d3ee; text-align: center; margin: 4px 0 14px; }
  input[type="range"] { width: 100%; accent-color: #6366f1; height: 6px; }
  .presets { display: flex; gap: 8px; margin-top: 14px; justify-content: center; flex-wrap: wrap; }
