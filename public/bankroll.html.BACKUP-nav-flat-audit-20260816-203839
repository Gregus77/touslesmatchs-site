<script>
  var userAuth = null;

  function euro(n) {
    return n.toLocaleString('fr-FR', { minimumFractionDigits: n < 10 ? 2 : 0, maximumFractionDigits: 2 }) + ' €';
  }

  // ── Auth ───────────────────────────────────────────────────────────────────
  function initAuth() {
    var email = localStorage.getItem('tlm_email');
    var code = localStorage.getItem('tlm_code');
    if (email && code) {
      userAuth = { email: email, code: code };
      showApp();
      loadBankroll();
    } else {
      // Visiteur gratuit : stratégies de mise accessibles à tous.
      // Le suivi personnel (paris sauvegardés) reste réservé aux connectés.
      document.getElementById('app').classList.remove('hidden');
      var suivi = document.getElementById('suivi-card');
      if (suivi) suivi.classList.add('hidden');
      var note = document.getElementById('guest-note');
      if (note) note.classList.remove('hidden');
      currentBankroll = Number(localStorage.getItem('tlm_guest_bankroll')) || 100;
      document.getElementById('bankroll-amount').textContent = euro(currentBankroll);
      recompute();
    }
  }

  function doLogin() {
    var email = document.getElementById('login-email').value.trim();
    var code = document.getElementById('login-code').value.trim();
    var errEl = document.getElementById('login-error');
    var btn = document.getElementById('login-btn');
    if (!email || !code) { errEl.textContent = 'Email et code requis.'; errEl.style.display = 'block'; return; }
    btn.disabled = true; btn.textContent = 'Vérification...';
    fetch('/api/verify-code', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email: email, code: code, login: true })
    }).then(function(r){ return r.json(); }).then(function(d) {
      if (d.valid) {
        userAuth = { email: email, code: code };
        localStorage.setItem('tlm_email', email);
        localStorage.setItem('tlm_code', code);
        localStorage.setItem('tlm_session', d.session_token || '');
        localStorage.setItem('tlm_plan', d.plan);
        document.getElementById('login-card').classList.add('hidden');
        var _navLogin = document.getElementById('nav-se-connecter');
        if (_navLogin) _navLogin.style.display = 'none';
        var _navCta = document.getElementById('nav-cta-top');
        if (_navCta) _navCta.style.display = 'none';
        showApp();
        loadBankroll();
      } else {
        errEl.textContent = d.error || 'Code invalide ou expiré.'; errEl.style.display = 'block';
      }
      btn.disabled = false; btn.textContent = 'Accéder →';
    }).catch(function() {
      errEl.textContent = 'Erreur de connexion.'; errEl.style.display = 'block';
      btn.disabled = false; btn.textContent = 'Accéder →';
    });
  }

  function showApp() {
    document.getElementById('app').classList.remove('hidden');
    if (userAuth) loadBets();
  }

  // ── Suivi gains / pertes ─────────────────────────────────────────────────────
  function escapeHtml(s) {
    return String(s).replace(/[&<>"']/g, function(c) {
      return { '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c];
    });
  }

  function loadBets() {
    fetch('/api/bankroll/bets/list', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email: userAuth.email, code: userAuth.code })
    }).then(function(r){ return r.json(); }).then(function(d) {
      if (d.ok) renderBets(d);
    }).catch(function(){});
  }

  function renderBets(d) {
    var t = d.totals;
    var solde = document.getElementById('t-solde');
    solde.textContent = (t.solde >= 0 ? '+' : '') + euro(t.solde);
    solde.className = 'tval ' + (t.solde >= 0 ? 'c-prudent' : 'c-risque');
    document.getElementById('t-gagne').textContent = euro(t.gagne);
    document.getElementById('t-perdu').textContent = euro(t.perdu);
    document.getElementById('t-winrate').textContent = t.winrate + '%';
    var list = document.getElementById('bets-list');
    if (!d.bets.length) {
      list.innerHTML = '<div class="empty">Aucune mise enregistrée. Ajoute ta première ci-dessus.</div>';
      return;
    }
    list.innerHTML = d.bets.map(function(b) {
      var pos = b.profit >= 0;
      return '<div class="bet-item">' +
        '<div class="bet-label">' + escapeHtml(b.label) +
        ' <span style="color:#949bc4">· ' + b.stake + '€ @ ' + b.odds + '</span></div>' +
        '<div class="bet-profit ' + (pos ? 'c-prudent' : 'c-risque') + '">' + (pos ? '+' : '') + euro(b.profit) + '</div>' +
        '<span class="bet-del" onclick="delBet(' + b.id + ')">🗑</span></div>';
    }).join('');
  }

  function addBet(result) {
    var label = document.getElementById('bet-label').value.trim();
    var stake = Number(document.getElementById('bet-stake').value);
    var odds = Number(document.getElementById('bet-odds').value);
    var err = document.getElementById('bet-error');
    if (!label) { err.textContent = 'Indique le match.'; err.style.display = 'block'; return; }
    if (!(stake > 0)) { err.textContent = 'Mise invalide.'; err.style.display = 'block'; return; }
    if (!(odds >= 1)) { err.textContent = 'Cote invalide.'; err.style.display = 'block'; return; }
    err.style.display = 'none';
    fetch('/api/bankroll/bets/add', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email: userAuth.email, code: userAuth.code, label: label, stake: stake, odds: odds, result: result })
    }).then(function(r){ return r.json(); }).then(function(d) {
      if (d.ok) {
        document.getElementById('bet-label').value = '';
        document.getElementById('bet-stake').value = '';
        document.getElementById('bet-odds').value = '';
        renderBets(d);
      } else {
        err.textContent = d.error || 'Erreur.'; err.style.display = 'block';
      }
    }).catch(function() {
      err.textContent = 'Erreur de connexion.'; err.style.display = 'block';
    });
  }

  function delBet(id) {
    fetch('/api/bankroll/bets/delete', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email: userAuth.email, code: userAuth.code, id: id })
    }).then(function(r){ return r.json(); }).then(function(d) {
      if (d.ok) renderBets(d);
    }).catch(function(){});
  }

  // ── Bankroll ───────────────────────────────────────────────────────────────
  var currentBankroll = null;

  function loadBankroll() {
    fetch('/api/bankroll/get', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email: userAuth.email, code: userAuth.code })
    }).then(function(r){ return r.json(); }).then(function(d) {
      if (d.ok && d.bankroll != null) {
        currentBankroll = d.bankroll;
        document.getElementById('bankroll-amount').textContent = euro(d.bankroll);
        recompute();
      } else {
        // Pas encore de bankroll → invite à la saisir
        showBankrollEdit();
      }
    }).catch(function(){ showBankrollEdit(); });
  }

  function showBankrollEdit() {
    document.getElementById('bankroll-display').classList.add('hidden');
    document.getElementById('bankroll-edit').classList.remove('hidden');
    if (currentBankroll != null) document.getElementById('bankroll-input').value = currentBankroll;
    document.getElementById('bankroll-input').focus();
  }
  function cancelBankrollEdit() {
    if (currentBankroll == null) return; // rien à annuler si pas encore défini
    document.getElementById('bankroll-edit').classList.add('hidden');
    document.getElementById('bankroll-display').classList.remove('hidden');
  }

  function saveBankroll() {
    var raw = Number(document.getElementById('bankroll-input').value);
    var errEl = document.getElementById('bankroll-error');
    var btn = document.getElementById('bankroll-save');
    if (!isFinite(raw) || raw < 0 || raw > 1000000) {
      errEl.textContent = 'Montant invalide.'; errEl.style.display = 'block'; return;
    }
    errEl.style.display = 'none';
    // Visiteur gratuit : capital sauvegardé localement (pas de compte requis)
    if (!userAuth) {
      currentBankroll = raw;
      try { localStorage.setItem('tlm_guest_bankroll', String(raw)); } catch(e) {}
      document.getElementById('bankroll-amount').textContent = euro(raw);
      document.getElementById('bankroll-edit').classList.add('hidden');
      document.getElementById('bankroll-display').classList.remove('hidden');
      recompute();
      return;
    }
    btn.disabled = true; btn.textContent = '...';
    fetch('/api/bankroll/set', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email: userAuth.email, code: userAuth.code, bankroll: raw })
    }).then(function(r){ return r.json(); }).then(function(d) {
      btn.disabled = false; btn.textContent = 'Enregistrer';
      if (d.ok) {
        currentBankroll = d.bankroll;
        document.getElementById('bankroll-amount').textContent = euro(d.bankroll);
        document.getElementById('bankroll-edit').classList.add('hidden');
        document.getElementById('bankroll-display').classList.remove('hidden');
        recompute();
      } else {
        errEl.textContent = d.error || 'Erreur.'; errEl.style.display = 'block';
      }
    }).catch(function() {
      btn.disabled = false; btn.textContent = 'Enregistrer';
      errEl.textContent = 'Erreur de connexion.'; errEl.style.display = 'block';
    });
  }

  // ── Cote + calcul des mises ────────────────────────────────────────────────
  var slider = document.getElementById('odds-slider');
  var oddsValueEl = document.getElementById('odds-value');

  function currentOdds() { return parseFloat(slider.value); }

  // % fixe par niveau, ajusté par la cote (plus la cote est haute, plus on réduit la mise).
  function computeStakes(bankroll, odds) {
    var factor = Math.max(0.2, Math.min(1.5, 2 / odds));
    var prudent = bankroll * 0.01 * factor;
    var normal  = bankroll * 0.03 * factor;
    var risque  = Math.min(bankroll * 0.07 * factor, bankroll * 0.10);
    return { prudent: prudent, normal: normal, risque: risque };
  }

  function recompute() {
    var odds = currentOdds();
    oddsValueEl.textContent = odds.toFixed(2);
    document.querySelectorAll('.chip').forEach(function(c) {
      c.classList.toggle('active', parseFloat(c.dataset.odds) === odds);
    });
    if (currentBankroll == null) return;
    var s = computeStakes(currentBankroll, odds);
    setStake('prudent', s.prudent, odds);
    setStake('normal', s.normal, odds);
    setStake('risque', s.risque, odds);
  }

  function setStake(key, amount, odds) {
    document.getElementById('s-' + key).textContent = euro(amount);
    var gain = amount * (odds - 1);
    document.getElementById('g-' + key).textContent = 'gain net : +' + euro(gain);
  }

  slider.addEventListener('input', recompute);

  // Presets de cote
  (function() {
    var presetEl = document.getElementById('presets');
    [1.5, 2, 3, 4, 5].forEach(function(o) {
      var chip = document.createElement('div');
      chip.className = 'chip'; chip.textContent = o.toFixed(1); chip.dataset.odds = o;
      chip.onclick = function() { slider.value = o; recompute(); };
      presetEl.appendChild(chip);
    });
  })();

  initAuth();
  recompute();
</script>
