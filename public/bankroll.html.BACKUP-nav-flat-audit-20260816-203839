  }
  .btn:disabled { opacity: .6; }
  .btn.secondary { background: transparent; border: 1px solid rgba(255,255,255,.15); color: #c4c9e6; }
  .row { display: flex; gap: 10px; }
  .err { color: #ef4444; font-size: 13px; margin-top: 10px; display: none; }
  .hidden { display: none; }

  /* Nav homogene avec le reste du site (accueil, Live IA, Performances, FAQ) */
  nav{position:fixed;top:0;left:0;right:0;z-index:200;display:flex;align-items:center;justify-content:space-between;padding:0 24px;height:56px;background:rgba(6,8,15,.9);border-bottom:1px solid rgba(255,255,255,.12);backdrop-filter:blur(16px)}
