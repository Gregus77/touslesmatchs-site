  .stake-info { flex: 1; }
  .stake-name { font-size: 15px; font-weight: 800; }
  .stake-desc { font-size: 12px; color: #949bc4; }
  .stake-amount { font-size: 20px; font-weight: 900; }
  .stake-gain { font-size: 11px; color: #949bc4; }
  .c-prudent { color: #10b981; } .c-normal { color: #f59e0b; } .c-risque { color: #ef4444; }

  /* Suivi gains/pertes */
  .totals { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; margin-bottom: 18px; }
  .ttile { background: #12152a; border: 1px solid rgba(255,255,255,.12); border-radius: 10px; padding: 11px 4px; text-align: center; }
  .tval { font-size: 16px; font-weight: 900; }
  .tlbl { font-size: 10px; color: #949bc4; text-transform: uppercase; letter-spacing: .05em; margin-top: 3px; }
  .bet-item { display: flex; align-items: center; gap: 10px; padding: 11px 0; border-bottom: 1px solid rgba(255,255,255,.11); font-size: 13px; }
  .bet-item:last-child { border-bottom: none; }
  .bet-label { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .bet-profit { font-weight: 800; white-space: nowrap; }
  .bet-del { color: #8a90b0; cursor: pointer; font-size: 15px; }
  .empty { color: #949bc4; font-size: 13px; text-align: center; padding: 16px 0; }

  .disclaimer {
    font-size: 11px; color: #8a90b0; line-height: 1.7; margin-top: 24px;
    padding: 16px; background: rgba(255,255,255,.02); border-radius: 12px; border: 1px solid rgba(255,255,255,.11);
  }
</style>
