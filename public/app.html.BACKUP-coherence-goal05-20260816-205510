  @keyframes pulse{0%,100%{opacity:1}50%{opacity:.35}}

  .btn{display:block;width:100%;text-align:center;padding:14px;border-radius:12px;font-weight:800;font-size:15px;border:none;margin-top:10px}
  .btn-p{background:linear-gradient(135deg,var(--indigo),var(--violet));color:#fff}
  .btn-g{background:linear-gradient(135deg,#059669,var(--green));color:#fff}
  .btn-o{background:transparent;color:var(--indigo2);border:1px solid var(--b2)}

  .state{text-align:center;padding:26px 14px;color:var(--muted2);font-size:13.5px}
