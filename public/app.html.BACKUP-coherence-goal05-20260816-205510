})();
</script>
<script id="tlm-goal05-home-live-js">
(function(){
  if(window.__tlmGoal05HomeLive)return; window.__tlmGoal05HomeLive=1;

  function esc(v){return String(v==null?"":v).replace(/[&<>"']/g,function(c){return {"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;","'":"&#39;"}[c];});}
  function token(){try{return localStorage.getItem("tlm_token")||localStorage.getItem("tlm_session")||"";}catch(e){return "";}}
  function plan(){try{return String(localStorage.getItem("tlm_plan")||"").toLowerCase();}catch(e){return "";}}
  function hasAccess(){return !!token() && /(standard|premium|elite|vip|founder|fondateur|beta|goal05|admin)/i.test(plan());}
  function country(comp){comp=String(comp||"");return comp.indexOf("·")>=0?comp.split("·").pop().trim():"Autres";}
  function allowed(m){
    var comp=String(m.competition||"").toLowerCase();
    var c=country(m.competition);
    var ok=["France","England","Spain","Germany","Italy","Portugal","Brazil","Argentina","USA","Australia","Japan","Korea","South Korea","Netherlands","Belgium","Scotland","Turkey"].indexOf(c)>=0;
    if((m.sport||"Football")!=="Football")return false;
    if(/cup|copa|coppa|coupe|serie c|u19|u20|u21|women|femmes|friendly|amical/i.test(comp))return false;
    return ok;
  }
  function decision(m){
    var sh=Number(m.score_home||0), sa=Number(m.score_away||0), min=Number(m.minute||0);
    var team=sh===0&&sa>0?m.home:sa===0&&sh>0?m.away:sh===0&&sa===0?m.home:null;
    var pct=52;
    if(m.analysable)pct+=8;
    if(m.h2h_markets&&m.h2h_markets.first_half_goal_pct)pct+=Math.round((Number(m.h2h_markets.first_half_goal_pct)-50)/4);
    if(min>=25&&min<=65)pct+=10;
    if(min>65&&min<=85)pct+=5;
    if(team&&((team===m.home&&sh<sa)||(team===m.away&&sa<sh)))pct+=8;
    pct=Math.max(35,Math.min(92,pct));
    return {play:allowed(m)&&team&&min>=25&&min<=85&&pct>=85,pct:pct,team:team};
  }
  function beep(){
    try{
      var ctx=new (window.AudioContext||window.webkitAudioContext)();
      var osc=ctx.createOscillator(), gain=ctx.createGain();
      osc.frequency.value=880; gain.gain.value=.08; osc.connect(gain); gain.connect(ctx.destination); osc.start();
      setTimeout(function(){osc.stop();ctx.close();},220);
    }catch(e){}
    try{ if(navigator.vibrate) navigator.vibrate([220,90,220]); }catch(e){}
  }
  function showAlert(best){
    try{
      var enabled=localStorage.getItem("tlm_signal_alerts")==="1";
      if(!enabled || !hasAccess())return;
      var m=best.m,d=best.d;
      var key="tlm_goal05_alert_"+(m.fixtureId||m.id||m.sourceId)+"_"+(m.score_home||0)+"_"+(m.score_away||0)+"_"+Math.floor(Number(m.minute||0)/5);
      if(localStorage.getItem(key)==="1")return;
      localStorage.setItem(key,"1");
      var box=document.getElementById("goal05-app-alert");
      if(!box){
        box=document.createElement("div");
        box.id="goal05-app-alert";
        box.className="goal05-app-alert";
        document.body.appendChild(box);
      }
      box.innerHTML="<b>Signal +0,5 détecté · "+esc(d.pct)+"%</b><span>"+esc(d.team)+" +0,5 but · "+esc(m.home)+" - "+esc(m.away)+" · "+esc(m.score_home)+"-"+esc(m.score_away)+" · "+esc(m.minute)+"'</span>";
      box.classList.add("on");
      beep();
      setTimeout(function(){box.classList.remove("on");},9000);
      if("Notification" in window && Notification.permission==="granted"){
        new Notification("Signal +0,5 détecté", { body:d.team+" +0,5 but · "+d.pct+"%", icon:"/logo192.png" });
      }
    }catch(e){}
  }
  function render(){
    var pick=document.getElementById("pick-box"); if(!pick)return;
    fetch("/api/live-matches?t="+Date.now(),{cache:"no-store"}).then(function(r){return r.json();}).then(function(data){
      var rows=((data&&(data.matches||data.live))||[]).filter(allowed).map(function(m){return {m:m,d:decision(m)};}).filter(function(x){return x.d.play;}).sort(function(a,b){return b.d.pct-a.d.pct;});
      var old=document.getElementById("goal05-live-main-card"); if(old)old.remove();
      if(!rows.length)return;
      var best=rows[0],m=best.m,d=best.d;
      var sh=m.score_home==null?"?":m.score_home,sa=m.score_away==null?"?":m.score_away;
      var locked=!hasAccess();
      var html='<div id="goal05-live-main-card" class="goal05-home-live-card '+(locked?'goal05-home-live-locked':'')+'">'
        + '<div class="goal05-home-live-head"><span class="goal05-home-live-badge">'+(locked?'SIGNAL LIVE DETECTE':'LIVE +0,5 · JOUER')+'</span><span class="goal05-home-live-pct">'+esc(d.pct)+'%</span></div>'
        + '<div class="goal05-home-live-team">'+(locked?'Connecte-toi pour voir le match':esc(d.team)+' +0,5 but')+'</div>'
        + '<div class="goal05-home-live-meta">'+(locked?'Un signal supérieur à 85% est disponible maintenant.':' '+esc(m.home)+' — '+esc(m.away)+' · '+esc(sh)+'-'+esc(sa)+' · '+esc(m.minute||0)+"'"+' · '+esc(m.competition||''))+'</div>'
        + '<div class="goal05-home-live-logos"><img src="'+esc(m.home_logo||"/logo192.png")+'" alt=""><img src="'+esc(m.away_logo||"/logo192.png")+'" alt=""><span>'+(locked?'Accès actif requis':'Aide à la décision +0,5 en direct')+'</span></div>'
        + '</div>';
      pick.insertAdjacentHTML("afterbegin",html);
      showAlert(best);
    }).catch(function(){});
  }
  window.tlmGoal05HomeLiveRefresh=render;
  if(document.readyState==="loading")document.addEventListener("DOMContentLoaded",render);else render();
  document.addEventListener("visibilitychange",function(){if(!document.hidden)render();});
  setInterval(render,15000);
})();
</script>
