      + '<div class="card app-auth-card"><div class="lbl">Nouveau sur TousLesMatchs ?</div><div class="app-auth-title">Entre dans la bêta</div>'
      + '<div class="app-auth-note">Laisse ton email : tu entres dans le tunnel TousLesMatchs/Brevo et tu reçois un code d’accès gratuit pour tester l’app.</div>'
      + '<input id="lead-mail" type="email" inputmode="email" autocomplete="email" placeholder="Ton email">'
      + '<label class="app-check"><input id="lead-adult" type="checkbox">Je confirme avoir au moins 18 ans et accepter de recevoir les emails TousLesMatchs.</label>'
      + '<button class="btn btn-g" id="btn-lead">Recevoir mon accès gratuit</button>'
      + '<div class="state" id="lead-msg" style="padding:9px 0 0"></div>'
      + '<div class="app-auth-note">Tu recevras ton code par email, puis les signaux +0,5 arriveront dans l’app et sur Telegram.</div></div></div>';

    $("btn-in").addEventListener("click", function () {
      var email = $("in-mail").value.trim().toLowerCase(), code = $("in-code").value.trim();
      var msg = $("log-msg");
      if (!email || !code) { msg.textContent = "Renseigne ton email et ton code."; return; }
