    div.innerHTML='<div class="tlm-paid-gate-card"><div class="tlm-paid-gate-badge">Analyse réservée</div><div class="tlm-paid-gate-title">Connexion requise</div><p class="tlm-paid-gate-text">Tu peux voir les matchs en direct. Pour ouvrir l’analyse, le pourcentage et la décision, il faut un accès actif TousLesMatchs.</p><div class="tlm-paid-gate-actions"><button class="tlm-paid-gate-login" type="button" id="tlm-gate-login">Se connecter</button><a class="tlm-paid-gate-pay" href="/#plans">Voir les abonnements</a></div><button type="button" id="tlm-gate-close" style="margin-top:10px;width:100%;background:transparent;border:none;color:#9ca3cf;font-weight:800">Fermer</button></div>';
    document.body.appendChild(div);
    document.getElementById("tlm-gate-close").onclick=function(){div.classList.remove("on");};
    document.getElementById("tlm-gate-login").onclick=function(){div.classList.remove("on");location.href="/app.html?tab=me";};
  }
  function showGate(){ensureModal();document.getElementById("tlm-paid-gate-modal").classList.add("on");}
  function target(el){return el&&el.closest&&el.closest("details.goal05-live-match,details[data-fixture],#live-box .item,#live-box details,.live-match,.match-card,.analysis-card,.prediction-card,[data-analysis],[data-signal],[data-match-id]");}
  document.addEventListener("click",function(e){
    var t=target(e.target);
    if(!t||hasAccess()||t.closest("#tlm-paid-gate-modal"))return;
