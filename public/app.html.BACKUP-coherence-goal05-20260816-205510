      html += '<div class="item"><div class="mid">'
        + '<div class="t">' + esc(a.home || a.match || 'Signal +0,5') + (a.away ? ' — ' + esc(a.away) : '') + '</div>'
        + '<div class="m">' + esc((a.analysed_at || a.date || "").slice(0, 10)) + ' · ' + esc(a.competition || "") + odd + '</div>'
        + '</div>' + b + '</div>';
    });
    $("perf-list").innerHTML = html;
  }
  function kpi(v, l, c) {
    return '<div class="kpi"><div class="v ' + (c || "") + '">' + esc(v) + '</div><div class="l">' + esc(l) + '</div></div>';
  }
  // â”€â”€ Compte â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  function renderMe() {
