<script id="tlm-goal05-live-pro-js">
(function(){
  function esc(v){return String(v == null ? "" : v).replace(/[&<>"']/g,function(c){return {"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;","'":"&#39;"}[c];});}
  function get(u){return fetch(u,{cache:"no-store"}).then(function(r){return r.json();});}
  function country(comp){comp=String(comp||"");return comp.indexOf("·")>=0?comp.split("·").pop().trim():"Autres";}
  function league(comp){comp=String(comp||"");return comp.indexOf("·")>=0?comp.split("·")[0].trim():comp;}
  function flag(c){return ({France:"🇫🇷",England:"🏴",Spain:"🇪🇸",Germany:"🇩🇪",Italy:"🇮🇹",Portugal:"🇵🇹",Brazil:"🇧🇷",Argentina:"🇦🇷",USA:"🇺🇸",Australia:"🇦🇺",Japan:"🇯🇵",Korea:"🇰🇷","South Korea":"🇰🇷",Netherlands:"🇳🇱",Belgium:"🇧🇪",Scotland:"🏴",Turkey:"🇹🇷"})[c]||"🌍";}
  function allowed(m){
    var comp=String(m.competition||"").toLowerCase();
    var c=country(m.competition);
    var ok=["France","England","Spain","Germany","Italy","Portugal","Brazil","Argentina","USA","Australia","Japan","Korea","South Korea","Netherlands","Belgium","Scotland","Turkey"].indexOf(c)>=0;
    if((m.sport||"Football")!=="Football") return false;
    if(/cup|copa|coppa|coupe|serie c|u19|u20|u21|women|femmes|friendly|amical/i.test(comp)) return false;
    return ok;
  }
  function time(m){try{return new Date(m.utcDate).toLocaleTimeString("fr-FR",{hour:"2-digit",minute:"2-digit"});}catch(e){return "";}}
  function decision(m){
    var sh=Number(m.score_home||0), sa=Number(m.score_away||0), min=Number(m.minute||0);
    var team=sh===0&&sa>0?m.home:sa===0&&sh>0?m.away:sh===0&&sa===0?m.home:null;
    var pct=52;
    if(m.analysable)pct+=8;
    if(m.h2h_markets&&m.h2h_markets.first_half_goal_pct)pct+=Math.round((Number(m.h2h_markets.first_half_goal_pct)-50)/4);
    if(min>=25&&min<=65)pct+=10;
    if(min>65&&min<=85)pct+=5;
    if(team&&((team===m.home&&sh<sa)||(team===m.away&&sa<sh)))pct+=8;
    pct=Math.max(35,Math.min(92,pct));
    var reasons=[];
    if(!allowed(m))reasons.push("Championnat non retenu pour le moteur +0,5.");
    if(!team)reasons.push("Le +0,5 équipe est déjà validé ou non pertinent.");
    if(min<25)reasons.push("Trop tôt, on attend une vraie lecture live.");
    if(min>85)reasons.push("Trop tard hors exception top contre bas de tableau.");
    if(!reasons.length)reasons.push("Fenêtre live correcte, équipe ciblée sans but, match surveillable.");
    var play=allowed(m)&&team&&min>=25&&min<=85&&pct>=68;
    return {play:play,pct:pct,team:team||"Aucune équipe",text:reasons.join(" ")};
  }
  function renderLivePick(best){
    var pick=document.getElementById("pick-box"); if(!pick)return;
    var old=document.getElementById("goal05-live-main-card"); if(old)old.remove();
    if(!best||!best.m||!best.d||!best.d.play)return;
    var m=best.m,d=best.d;
    var sh=m.score_home==null?"?":m.score_home, sa=m.score_away==null?"?":m.score_away;
    var html='<div id="goal05-live-main-card" class="goal05-main-live-card">'
      + '<div class="goal05-main-live-head"><span class="goal05-main-live-badge">LIVE +0,5 · JOUER</span><span class="goal05-main-live-pct">'+esc(d.pct)+'%</span></div>'
      + '<div class="goal05-main-live-team">'+esc(d.team)+' +0,5 but</div>'
      + '<div class="goal05-main-live-meta">'+esc(m.home)+' — '+esc(m.away)+' · '+esc(sh)+'-'+esc(sa)+' · '+esc(m.minute||0)+"'"+' · '+esc(m.competition||'')+'</div>'
      + '<div class="goal05-main-live-teams"><img src="'+esc(m.home_logo||"/logo192.png")+'" alt=""><img src="'+esc(m.away_logo||"/logo192.png")+'" alt=""><span>'+esc(d.text)+'</span></div>'
      + '</div>';
    pick.insertAdjacentHTML("afterbegin",html);
  }
  function renderLive(){
    var box=document.getElementById("live-box"); if(!box)return;
    get("/api/live-matches").then(function(d){
      var list=((d&&(d.matches||d.live))||[]).filter(allowed);
      if(!list.length){box.innerHTML='<div class="card"><div class="state">Aucun match +0,5 éligible en direct pour le moment.</div></div>';return;}
      list.sort(function(a,b){return (country(a.competition)+league(a.competition)+(a.utcDate||"")).localeCompare(country(b.competition)+league(b.competition)+(b.utcDate||""));});
      var html='<div class="card">', cc='', ll='';
      list.slice(0,60).forEach(function(m){
        var c=country(m.competition), l=league(m.competition), d=decision(m), sh=m.score_home==null?"?":m.score_home, sa=m.score_away==null?"?":m.score_away;
        if(c!==cc){cc=c;ll='';html+='<div class="goal05-live-country">'+flag(c)+' '+esc(c)+'</div>';}
        if(l!==ll){ll=l;html+='<div class="goal05-live-league">'+esc(l)+'</div>';}
        html+='<details class="goal05-live-match" data-fixture="'+esc(m.fixtureId||m.id||m.sourceId||((m.home||"")+"_"+(m.away||"")))+'"><summary><div class="goal05-live-logos"><img src="'+esc(m.home_logo||"/logo192.png")+'" alt=""><img src="'+esc(m.away_logo||"/logo192.png")+'" alt=""></div><div><div class="goal05-live-title">'+esc(m.home)+' — '+esc(m.away)+'</div><div class="goal05-live-meta">'+esc(time(m))+' · '+esc(m.minute||0)+"' · "+esc(l)+'</div></div><div class="goal05-live-score">'+esc(sh)+'-'+esc(sa)+'</div></summary><div class="goal05-live-detail"><div class="goal05-decision '+(d.play?'play':'no')+'"><div><strong>'+(d.play?'JOUER':'NE PAS JOUER')+'</strong><small>'+esc(d.team)+' +0,5 but · '+esc(d.text)+'</small></div><div class="goal05-pct">'+esc(d.pct)+'%</div></div></div></details>';
      });
      var openIds=[].map.call(box.querySelectorAll("details.goal05-live-match[open]"),function(el){return el.getAttribute("data-fixture");});
      var best=list.map(function(x){return {m:x,d:decision(x)};}).filter(function(x){return x.d.play;}).sort(function(a,b){return b.d.pct-a.d.pct;})[0];
      renderLivePick(best);
      box.innerHTML=html+'</div>';
      [].forEach.call(box.querySelectorAll("details.goal05-live-match"),function(el){if(openIds.indexOf(el.getAttribute("data-fixture"))>=0)el.open=true;});
    }).catch(function(){box.innerHTML='<div class="card"><div class="state">Direct +0,5 indisponible.</div></div>';});
  }
  function is05(a){var t=[a.bet,a.best_bet,a.market,a.selection,a.signal,a.reason,a.raison,a.notes,a.type].join(" ").toLowerCase();return t.indexOf("+0,5")>=0||t.indexOf("0,5")>=0||t.indexOf("0.5")>=0||t.indexOf("goal05")>=0;}
  function norm(s){if(!s)return null;return {home:s.home||s.team||"Signal +0,5",away:s.away||s.opponent||"",competition:s.competition||s.meta||"",bet:s.bet||"+0,5 but",outcome:s.outcome||s.result||null,real_odd:s.odd||s.cote||null,analysed_at:s.sentAt||s.created_at||s.date||""};}
  function kpi(v,l,c){return '<div class="kpi"><div class="v '+(c||"")+'">'+esc(v)+'</div><div class="l">'+esc(l)+'</div></div>';}
  function renderPerf(){
    var kp=document.getElementById("perf-kpis"), list=document.getElementById("perf-list"); if(!kp||!list)return;
    Promise.all([get("/api/analysis-history?limit=300").catch(function(){return {analyses:[]};}),get("/api/goal05/latest").catch(function(){return {};})]).then(function(all){
      var rows=((all[0].analyses)||[]).filter(is05);
      [all[1].signal,all[1].lastSignal].forEach(function(s){var r=norm(s);if(r)rows.unshift(r);});
      var done=rows.filter(function(a){return a.outcome==="win"||a.outcome==="loss";});
      var wins=done.filter(function(a){return a.outcome==="win";}).length;
      var wr=done.length?Math.round(wins/done.length*100):0;
      kp.innerHTML=kpi(String(rows.length),"Signaux envoyés","c-cyan")+kpi(String(done.length),"Signaux terminés","")+kpi(done.length?wr+"%":"—","Réussite +0,5",wr>=60?"c-green":"");
      if(!rows.length){list.innerHTML='<div class="state"><strong>Bilan +0,5 en attente</strong><br>Aucun signal +0,5 envoyé trouvé.</div>';return;}
      list.innerHTML=rows.slice(0,50).map(function(a){var b=a.outcome==="win"?'<span class="badge b-win">Gagné</span>':a.outcome==="loss"?'<span class="badge b-loss">Perdu</span>':'<span class="badge b-wait">Envoyé / en attente</span>';return '<div class="item"><div class="mid"><div class="t">'+esc(a.home||"Signal +0,5")+(a.away?' — '+esc(a.away):'')+'</div><div class="m">'+esc((a.analysed_at||a.date||a.created_at||"").slice(0,10))+' · '+esc(a.competition||"")+'</div></div>'+b+'</div>';}).join("");
    });
  }
  function run(){renderLive();renderPerf();}
  if(document.readyState==="loading")document.addEventListener("DOMContentLoaded",run);else run();
  setInterval(run,60000);
})();
</script>
<script id="tlm-paid-analysis-gate-js">
(function(){
  if(window.__tlmPaidAnalysisGate)return; window.__tlmPaidAnalysisGate=1;
  function plan(){try{return String(localStorage.getItem("tlm_plan")||"").toLowerCase();}catch(e){return "";}}
  function token(){try{return localStorage.getItem("tlm_token")||localStorage.getItem("tlm_session")||"";}catch(e){return "";}}
  function hasAccess(){var p=plan();return !!token() && /(standard|premium|elite|vip|founder|fondateur|beta|goal05|admin)/i.test(p);}
  function ensureModal(){
    if(document.getElementById("tlm-paid-gate-modal"))return;
