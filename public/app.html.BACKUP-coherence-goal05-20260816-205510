<script>
(function () {
  "use strict";

  // â”€â”€ Utilitaires â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  var $ = function (id) { return document.getElementById(id); };
  var esc = function (s) {
    return String(s == null ? "" : s).replace(/[&<>"']/g, function (c) {
      return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
    });
  };
  var num = function (v) { var n = Number(v); return isFinite(n) ? n : 0; };
  var eur = function (v) { return (v >= 0 ? "+" : "") + Math.round(v) + "€"; };

  function get(path) {
    return fetch(path, { headers: { "Accept": "application/json" } })
      .then(function (r) { return r.json(); })
      .catch(function () { return { ok: false, offline: true }; });
  }
  function flagOffline(d) {
    if (d && d.offline) $("offline-note").style.display = "block";
    return d;
  }

  // â”€â”€ Session (mêmes clés que le site : une seule connexion pour les deux) â”€â”€â”€
  function plan() { try { return localStorage.getItem("tlm_plan") || "free"; } catch (e) { return "free"; } }
  function token() { try { return localStorage.getItem("tlm_token") || ""; } catch (e) { return ""; } }
  function isPaid() { var p = plan(); return !!p && p !== "free"; }

  function renderChip() {
    var c = $("chip"), p = plan();
    var connected = !!token();
    c.textContent = "Football IA";
    c.className = "plan-chip" + (connected ? " paid" : "");
  }

  // â”€â”€ Onglets â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  var loaded = {};
  function show(tab) {
    ["pick", "live", "perf", "me"].forEach(function (t) {
      $("s-" + t).classList.toggle("on", t === tab);
    });
    Array.prototype.forEach.call(document.querySelectorAll("nav button"), function (b) {
      b.classList.toggle("on", b.getAttribute("data-tab") === tab);
    });
    try { history.replaceState(null, "", "?tab=" + tab); } catch (e) {}
    if (!loaded[tab]) { loaded[tab] = true; load(tab); }
  }
  Array.prototype.forEach.call(document.querySelectorAll("nav button"), function (b) {
    b.addEventListener("click", function () { show(b.getAttribute("data-tab")); });
  });

  function load(tab) {
    if (tab === "pick") loadPick();
    if (tab === "live") loadLive();
    if (tab === "perf") loadPerf();
    if (tab === "me") renderMe();
  }

  // â”€â”€ Analyse du jour â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€


  var BOOKMAKERS = [
    { name: "Winamax", cls: "winamax", url: "https://www.winamax.fr/parrain?code=77953728" },
    { name: "Unibet", cls: "unibet", url: "https://www.unibet.fr/inscription/?campaign=210726&parrain=5EBF919DF1008254" },
    { name: "PMU", cls: "pmu", url: "https://www.pmu.fr/turf/static/offre-parrainage/?codeParrainage=779753728" }
  ];

  function bookmakerButtons() {
    return '<div class="bookmakers"><div class="bookmakers-title">Ouvrir un bookmaker partenaire</div><div class="bookmaker-grid">'
      + BOOKMAKERS.map(function (b) { return '<a class="bookmaker-btn ' + b.cls + '" href="' + b.url + '" target="_blank" rel="noopener sponsored">' + esc(b.name) + '</a>'; }).join('')
      + '</div><div class="bookmaker-note">18+ · Jouer comporte des risques. Liens partenaires/affiliation TousLesMatchs.</div></div>';
  }

  function signalKey(p) {
    return [p.id || p.fixture_id || '', p.home || (p.teamA && p.teamA.name) || '', p.away || (p.teamB && p.teamB.name) || '', p.bet || p.best_bet || '', p.time || ''].join('|');
  }

  function updateAlertToggle() {
    var btn = $('signal-alert-toggle');
    if (!btn) return;
    var on = false;
    try { on = localStorage.getItem('tlm_signal_alerts') === '1'; } catch (e) {}
    btn.classList.toggle('on', on);
    btn.textContent = on ? '🔔 Alertes popup + son activées' : '🔔 Activer popup + son quand un pari est prêt';
  }

  function enableSignalAlerts() {
    try { localStorage.setItem('tlm_signal_alerts', '1'); } catch (e) {}
    updateAlertToggle();
    playSignalTone(true);
    try { loadPick(); } catch (e) {}
  }

  function playSignalTone(force) {
    var enabled = force;
    try { enabled = enabled || localStorage.getItem('tlm_signal_alerts') === '1'; } catch (e) {}
    if (!enabled) return;
    try {
      var Ctx = window.AudioContext || window.webkitAudioContext;
      if (!Ctx) return;
      var ctx = new Ctx();
      var gain = ctx.createGain();
      var osc = ctx.createOscillator();
      osc.type = 'sine';
      osc.frequency.value = 880;
      gain.gain.setValueAtTime(0.001, ctx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.18, ctx.currentTime + 0.03);
      gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.55);
      osc.connect(gain);
      gain.connect(ctx.destination);
      osc.start();
      osc.stop(ctx.currentTime + 0.6);
    } catch (e) {}
  }

  function showSignalPopup(p) {
    var key = signalKey(p);
    try {
      if (localStorage.getItem('tlm_last_signal_popup') === key) return;
      localStorage.setItem('tlm_last_signal_popup', key);
    } catch (e) {}
    var pop = $('tlm-signal-popup');
    if (!pop) return;
    var a = (p.teamA && p.teamA.name) || p.home || 'Match';
    var b = (p.teamB && p.teamB.name) || p.away || '';
    $('signal-popup-title').textContent = 'Pari prêt : ' + a + (b ? ' — ' + b : '');
    $('signal-popup-text').textContent = (p.bet || p.best_bet || 'Sélection validée') + (p.cote ? ' · cote @' + p.cote : '') + (p.competition ? ' · ' + p.competition : '');
    $('signal-popup-bookmakers').innerHTML = bookmakerButtons();
    pop.classList.add('on');
    pop.setAttribute('aria-hidden', 'false');
    playSignalTone(false);
  }

  function closeSignalPopup() {
    var pop = $('tlm-signal-popup');
    if (!pop) return;
    pop.classList.remove('on');
    pop.setAttribute('aria-hidden', 'true');
  }

  window.enableSignalAlerts = enableSignalAlerts;

  function urlBase64ToUint8Array(base64String) {
    var padding = '='.repeat((4 - base64String.length % 4) % 4);
    var base64 = (base64String + padding).replace(/-/g, '+').replace(/_/g, '/');
    var rawData = atob(base64);
    var outputArray = new Uint8Array(rawData.length);
    for (var i = 0; i < rawData.length; ++i) outputArray[i] = rawData.charCodeAt(i);
    return outputArray;
  }

  function pushFeedback(msg, ok) {
    var box = document.getElementById('pick-box');
    if (!box) return;
    var el = document.getElementById('push-feedback-msg');
    if (!el) {
      el = document.createElement('div');
      el.id = 'push-feedback-msg';
      el.style.marginTop = '8px';
      el.style.fontSize = '12px';
      el.style.padding = '8px 10px';
      el.style.borderRadius = '8px';
      box.appendChild(el);
    }
    el.style.background = ok ? 'rgba(34,197,94,.12)' : 'rgba(239,68,68,.12)';
    el.style.color = ok ? '#22c55e' : '#ef4444';
    el.style.border = '1px solid ' + (ok ? 'rgba(34,197,94,.3)' : 'rgba(239,68,68,.3)');
    el.textContent = msg;
  }
  function enablePushNotifications() {
    if (!('serviceWorker' in navigator) || !('PushManager' in window)) {
      pushFeedback('Notifications non supportées sur ce navigateur/app (iOS Safari : ajoute le site à l\'écran d\'accueil d\'abord).', false);
      return;
    }
    pushFeedback('Activation en cours...', true);
    navigator.serviceWorker.register('/sw.js').then(function (reg) {
      return Notification.requestPermission().then(function (perm) {
        if (perm !== 'granted') { pushFeedback('Notifications refusées (permission navigateur non accordée).', false); return; }
        return get('/api/push/vapid-public-key').then(function (d) {
          if (!d || !d.key) { pushFeedback('Erreur config serveur : clé VAPID manquante.', false); throw new Error('no vapid key'); }
          return reg.pushManager.subscribe({ userVisibleOnly: true, applicationServerKey: urlBase64ToUint8Array(d.key) });
        }).then(function (sub) {
          return fetch('/api/push/subscribe', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(sub) });
        }).then(function () { try { localStorage.setItem('tlm_push_enabled', '1'); } catch (e) {} pushFeedback('Notifications activées, même app fermée.', true); try { loadPick(); } catch (e) {} });
      });
    }).catch(function (e) { console.error(e); pushFeedback('Erreur : ' + e.message, false); });
  }
  window.enablePushNotifications = enablePushNotifications;


  function goal05VerdictCard(signal) {
    var hasSignal = !!signal;
    var badge = hasSignal ? 'SIGNAL VALIDÉ' : 'SIGNAL EN ATTENTE';
    var badgeClass = hasSignal ? 'goal05-verdict-badge ok' : 'goal05-verdict-badge';
    var odd = hasSignal && signal.odd ? '@' + esc(signal.odd) : '@—';
    var team = hasSignal ? esc(signal.team || 'Équipe sélectionnée +0,5') : 'Aucun match validé +0,5';
    var meta = hasSignal ? esc(signal.meta || 'Analyse football uniquement') : 'Football uniquement · moteur en surveillance';
    var checks = hasSignal && signal.checks ? signal.checks : [
      { ok:false, text:'Écart historique favorable' },
      { ok:false, text:'Enjeu réel au classement' },
      { ok:false, text:'Adversaire encaisse régulièrement' },
      { ok:false, text:'Aucun signal envoyé si un critère dur manque' }
    ];
    return '<div class="goal05-verdict-card">'
      + '<div class="goal05-verdict-head"><span class="' + badgeClass + '">' + badge + '</span><span class="goal05-verdict-odd">' + odd + '</span></div>'
      + '<div class="goal05-verdict-team">' + team + '</div>'
      + '<div class="goal05-verdict-meta">' + meta + '</div>'
      + '<div class="goal05-verdict-list">'
      + checks.map(function(c){ return '<div><b' + (c.ok ? '' : ' class="wait"') + '>' + (c.ok ? '&#10003;' : '—') + '</b>' + esc(c.text) + '</div>'; }).join('')
      + '</div>'
      + '</div>';
  }

  function goal05BetaRow() {
    return '<div class="offer-stack" aria-label="Accès Goal plus 0,5"><a class="offer-row hot" href="/#goal05-founder-card"><div><div class="offer-name">+0,5 but — bêta privée</div><div class="offer-desc">20 places fondatrices, football uniquement</div></div><div class="offer-price">0€</div></a></div>';
  }

  function renderGoal05Pick(signal) {
    var box = $("pick-box");
    var locked = !token();
