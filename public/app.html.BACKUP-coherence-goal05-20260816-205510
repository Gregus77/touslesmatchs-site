      fetch("/api/verify-code", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ email: email, code: code, login: true }) })
        .then(function (r) { return r.json(); }).then(function (d) {
          if (d && (d.valid || d.ok)) {
            try {
              localStorage.setItem("tlm_email", email);
              localStorage.setItem("tlm_code", code.toUpperCase());
              if (d.session_token) localStorage.setItem("tlm_session", d.session_token);
              if (d.session_token) localStorage.setItem("tlm_token", d.session_token);
              else if (d.token) localStorage.setItem("tlm_token", d.token);
              else localStorage.setItem("tlm_token", "code:" + code.toUpperCase());
              localStorage.setItem("tlm_plan", d.plan || d.status || "free");
            } catch (e) {}
            msg.textContent = "Connexion réussie.";
            renderChip(); loaded.pick = false; renderMe(); show("pick");
          } else msg.textContent = (d && d.error) || "Code invalide ou expiré.";
        }).catch(function () { msg.textContent = "Connexion impossible. Réessaie."; });
    });

    $("btn-forgot").addEventListener("click", function () {
      var email = $("in-mail").value.trim().toLowerCase();
      var msg = $("log-msg");
      if (!email) { msg.textContent = "Entre ton email d’abonnement."; return; }
      msg.textContent = "Envoi du code…";
      fetch("/api/forgot-code", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ email: email }) })
        .then(function(){ msg.textContent = "Si un compte existe, le code vient d’être envoyé par email."; })
        .catch(function(){ msg.textContent = "Envoi impossible. Réessaie."; });
    });

    $("btn-lead").addEventListener("click", function () {
      var email = $("lead-mail").value.trim().toLowerCase();
      var adult = $("lead-adult").checked;
      var msg = $("lead-msg");
      if (!email || email.indexOf("@") < 0) { msg.textContent = "Entre une adresse email valide."; return; }
      if (!adult) { msg.textContent = "Confirmation +18 requise."; return; }
      msg.textContent = "Création de ton accès…";
      fetch("/api/app-access/start", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ email: email, adultConfirmed: true, marketingConsent: true, source: "android_app" }) })
        .then(function(r){ return r.json(); }).then(function(d){
          if (d && d.ok) msg.textContent = "Email envoyé. Ouvre ta boîte mail : ton code d’accès arrive.";
          else msg.textContent = (d && d.error) || "Impossible de créer l’accès maintenant.";
