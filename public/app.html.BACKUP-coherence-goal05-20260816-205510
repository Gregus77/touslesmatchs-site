<script id="tlm-history-backfill-js">
(function(){
  var months={'01':'janvier','02':'février','03':'mars','04':'avril','05':'mai','06':'juin','07':'juillet','08':'août','09':'septembre','10':'octobre','11':'novembre','12':'décembre'};
  var days=['dimanche','lundi','mardi','mercredi','jeudi','vendredi','samedi'];
  function label(iso){
    var d=new Date(iso+'T12:00:00');
    return days[d.getDay()]+' '+Number(iso.slice(8,10))+' '+months[iso.slice(5,7)];
  }
  function root(){
    var h=[].slice.call(document.querySelectorAll('h1,h2,h3,div,strong')).find(function(x){return /Derniers verdicts du Concile/i.test(x.textContent||'');});
    return h ? (h.parentElement || h) : null;
  }
  function apply(){
    fetch('/api/public-analysis-stats?t='+Date.now(),{cache:'no-store'}).then(function(r){return r.json();}).then(function(d){
      var rows=(d.daily_concile||[]).filter(function(r){return r.jour>='2026-07-25'&&r.jour<='2026-08-08';});
      var map={}; rows.forEach(function(r){map[r.jour]=r;});
      document.querySelectorAll('details,div').forEach(function(el){
        var txt=(el.textContent||'').toLowerCase();
        Object.keys(map).forEach(function(iso){
          var lab=label(iso).toLowerCase();
          if(txt.indexOf(lab)>=0 && /0\s+s[ée]lection retenue/i.test(el.innerHTML||'')){
            el.innerHTML=el.innerHTML.replace(/0\s+s[ée]lection retenue/gi, map[iso].analyses+' analyses · '+map[iso].resolved+' résolues');
          }
        });
      });
      var box=root(); if(!box)return;
      rows.forEach(function(r){
        var lab=label(r.jour);
        if((document.body.textContent||'').toLowerCase().indexOf(lab.toLowerCase())>=0)return;
        var row=document.createElement('div');
        row.className='tlm-history-backfill-row';
        row.setAttribute('data-tlm-history-day',r.jour);
        row.innerHTML='<span>▶ '+lab+'</span><span>'+r.analyses+' analyses · '+r.resolved+' résolues</span>';
        box.appendChild(row);
      });
    }).catch(function(){});
  }
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',apply);else apply();
  setTimeout(apply,1200);
  setInterval(apply,30000);
})();
</script>
