      + '<input id="in-code" type="text" autocomplete="one-time-code" placeholder="Code d’accès">'
      + '<button class="btn btn-p" id="btn-in">Me connecter</button>'
      + '<button class="btn btn-o" id="btn-forgot">Recevoir mon code par email</button>'
