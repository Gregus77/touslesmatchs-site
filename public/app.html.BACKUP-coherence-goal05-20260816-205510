  input{width:100%;padding:13px;border-radius:11px;border:1px solid var(--b2);background:var(--bg2);color:var(--text);font-size:15px;margin-bottom:9px}
  input::placeholder{color:var(--muted2)}
  .app-auth-split{display:grid;gap:12px}
  .app-auth-card{border-color:rgba(34,211,238,.25)}
  .app-auth-title{font-size:20px;font-weight:1000;letter-spacing:-.04em;margin-bottom:5px}
  .app-auth-note{font-size:12px;color:var(--muted2);line-height:1.55;margin:8px 0 12px}
  .app-check{display:flex;gap:8px;align-items:flex-start;color:var(--muted2);font-size:11px;line-height:1.45;margin:6px 0 8px}
  .app-check input{width:auto;margin:2px 0 0;accent-color:var(--green)}

  nav{
    position:fixed;bottom:0;left:0;right:0;z-index:30;
    background:rgba(11,10,20,.96);backdrop-filter:blur(14px);
    border-top:1px solid var(--b1);
    display:grid;grid-template-columns:repeat(4,1fr);
    padding-bottom:var(--safe-b);
  }
  nav button{background:none;border:none;color:var(--muted2);padding:9px 4px 8px;font-size:10.5px;font-weight:700;display:flex;flex-direction:column;align-items:center;gap:3px}
