CSS=':root{--b:#090d21;--p:#111733;--t:#f8f9ff;--m:#b3bddc;--l:rgba(255,255,255,.12);--c:#36d7ff;--v:#8b6bff}*{box-sizing:border-box}body{margin:0;background:linear-gradient(135deg,#090d21,#11163a,#1b1040);color:var(--t);font:16px/1.6 system-ui,-apple-system,Segoe UI,Arial}.w{width:min(1120px,calc(100% - 30px));margin:auto}a{color:inherit}.top{position:sticky;top:0;background:#080c20ee;border-bottom:1px solid var(--l);z-index:5}.ti{padding:12px 0;display:flex;gap:14px;justify-content:space-between;align-items:center}.brand{text-decoration:none;font-weight:900}.brand b{color:var(--v)}.langs,.nav{display:flex;gap:7px;flex-wrap:wrap}.langs a,.nav a{font-size:12px;text-decoration:none;border:1px solid var(--l);border-radius:9px;padding:6px 9px;color:var(--m)}.hero{padding:52px 0 24px}.hero h1{font-size:clamp(34px,6vw,62px);line-height:1.04;letter-spacing:-.05em;margin:8px 0 16px}.lead{max-width:900px;font-size:18px}.muted{color:var(--m)}.panel{background:#0d1330dd;border:1px solid var(--l);border-radius:17px;padding:20px;margin:18px 0}.panel h2{margin:0 0 10px}.tw{overflow:auto;border:1px solid var(--l);border-radius:12px}table{width:100%;min-width:760px;border-collapse:collapse}th,td{padding:11px;border-bottom:1px solid var(--l);text-align:left;font-size:13px}.faq details{border:1px solid var(--l);border-radius:10px;padding:12px;margin:8px 0}.links{display:grid;grid-template-columns:repeat(2,1fr);gap:8px}.links a{border:1px solid var(--l);border-radius:10px;padding:11px;text-decoration:none}footer{border-top:1px solid var(--l);margin-top:36px;padding:26px 0 40px;color:var(--m);font-size:13px}@media(max-width:700px){.ti{align-items:flex-start;flex-direction:column}.lead{font-size:16px}.links{grid-template-columns:1fr}}'
(R/'seo/seo.css').write_text(CSS+'\n')
JS=r'''(function(){var b=document.getElementById('rows'),note=document.getElementById('note');if(!b)return;function n(v){return String(v||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().replace(/,/g,'.')}function ok(m){var s=n(m.sport),t=n([m.competition,m.league,m.category,m.home,m.away].join(' '));return !/\b(nfl|american football|gridiron|super bowl|ncaa football)\b/.test(t)&&(!s||s==='football'||s==='soccer')}function esc(v){return String(v==null?'':v).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})}function mk(m){var x=String(m.bet||m.best_bet||m.selection||m.market||'');return /\b(over|under)\s*2[,.]5\b/i.test(x)?x:''}function cf(m){for(var a=[m.confidence,m.score,m.ai_confidence],i=0;i<a.length;i++){var x=Number(a[i]);if(isFinite(x)&&x>=0&&x<=100)return Math.round(x)+'%'}return '—'}function ct(m){if(m.country)return m.country;var p=String(m.competition||'').split(/\s*[·•]\s*/);return p.length>1?p[p.length-1]:''}function vt(m){var v=m.ou25&&Array.isArray(m.ou25.votes)?m.ou25.votes:[],z=v.filter(function(x){return x&&x.status==='voted'}).length;return z?z+'/5 IA':(m.analysis_verified?'AI':'—')}fetch('/api/homepage-fixtures?t='+Date.now(),{cache:'no-store'}).then(function(r){return r.json()}).then(function(d){var a=[],seen={};(d.live||[]).forEach(function(m){if(ok(m)){var k=m.id||m.fixtureId||m.home+'|'+m.away;if(!seen[k]){seen[k]=1;a.push([m,1])}}});(d.upcoming||[]).forEach(function(m){if(ok(m)){var k=m.id||m.fixtureId||m.home+'|'+m.away;if(!seen[k]){seen[k]=1;a.push([m,0])}}});var want=n(document.body.dataset.market||''),f=want?a.filter(function(x){return n(mk(x[0])).indexOf(want)>=0}):a;if(want&&!f.length){note.textContent=note.dataset.nomark