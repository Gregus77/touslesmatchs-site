[Unit]
Description=TousLesMatchs Owner Telegram Remote
After=network-online.target tlm-hermes-guardian.service
Wants=network-online.target
Requires=tlm-hermes-guardian.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/tlm-hermes-control
Environment=TLM_ROOT=/opt/touslesmatchs
ExecStart=/usr/bin/python3 /opt/tlm-hermes-control/tlm_owner_remote.py
Restart=always
RestartSec=10
UMask=0077

[Install]
WantedBy=multi-user.target
