[Unit]
Description=TousLesMatchs autonomous production director
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/touslesmatchs
StateDirectory=tlm-autodirector
StateDirectoryMode=0700
RuntimeDirectory=tlm-autodirector
RuntimeDirectoryMode=0755
ExecStart=/usr/bin/flock -n /run/tlm-autodirector/director.lock /usr/bin/python3 /usr/local/sbin/tlm-autodirector.py
TimeoutStartSec=240
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/tlm-autodirector /run/tlm-autodirector

[Install]
WantedBy=multi-user.target
