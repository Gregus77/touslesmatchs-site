FROM node:20-alpine
WORKDIR /app

RUN apk add --no-cache python3 make g++

# Versions verrouillees (audit securite du 05/08/2026, point #9). Avant, un
# simple `npm install` sans version rejouait les DERNIERES versions publiees a
# chaque reconstruction : une dependance compromise en amont entrait en
# production sans qu'aucun commit ne change ici. Le `~` autorise uniquement les
# correctifs de securite (x.y.Z), jamais un changement de comportement.
RUN npm install --save --no-audit --no-fund \
  express@~5.2.1 \
  cors@~2.8.6 \
  bcryptjs@~3.0.3 \
  jsonwebtoken@~9.0.3 \
  better-sqlite3@~13.0.2 \
  stripe@~22.4.0 \
  @simplewebauthn/server@~13.3.2 \
  imapflow@~1.6.5 \
  mailparser@~3.9.14 \
  nodemailer@~9.0.4

RUN mkdir -p /data

COPY scripts/api_server.js ./server.js
COPY scripts/bookmakers.config.js ./bookmakers.config.js
COPY scripts/analysis_engine.js ./analysis_engine.js
COPY scripts/ai_budget_guard.js ./ai_budget_guard.js
COPY scripts/ai_models.config.js ./ai_models.config.js
COPY scripts/hermes_mail_bot.js ./hermes_mail_bot.js

EXPOSE 3001
CMD ["node", "server.js"]
