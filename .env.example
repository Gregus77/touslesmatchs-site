# ═══ API-Football Pro (analyse des matchs) ═══
# Ta clé API-Football Pro — utilisée pour récupérer matchs, cotes, H2H, forme, stats
API_FOOTBALL_KEY=ta_cle_api_football_pro

# ═══ IAs du Concile (4 agents + 1 chef) ═══
DEEPSEEK_API_KEY=ta_cle_deepseek
GROQ_API_KEY=ta_cle_groq
GOOGLE_API_KEY=ta_cle_google_gemini
MISTRAL_API_KEY=ta_cle_mistral

# Claude (chef) — utilise la clé Anthropic
ANTHROPIC_API_KEY=ta_cle_anthropic

# IMPORTANT — sans PERPLEXITY_API_KEY et COHERE_API_KEY, les agents "Perplexity-Web"
# et "Cohere-Command" retombent SILENCIEUSEMENT sur llama-3.3-70b (Groq), c'est-à-dire
# le même modèle que Claude Chief : le Concile perd sa diversité réelle.
PERPLEXITY_API_KEY=ta_cle_perplexity
COHERE_API_KEY=ta_cle_cohere

# ═══ Banc d'essai (shadow) — test à blanc, aucun impact sur les picks ═══
OPENROUTER_API_KEY=ta_cle_openrouter
CEREBRAS_API_KEY=ta_cle_cerebras
TOGETHER_API_KEY=ta_cle_together
# Identifiants de modèles surchargeables : à corriger ici si OpenRouter renomme
# un modèle ou si l'identifiant par défaut est invalide (visible dans les logs).
OR_QWEN_MODEL=qwen/qwen3.7-max
OR_KIMI_MODEL=moonshotai/kimi-k3

# ═══ Telegram ═══
TELEGRAM_BOT_TOKEN=ton_bot_token
# ── Canaux clients (1 seul bot suffit — mettre les CHAT_ID, pas de token par canal) ──
TELEGRAM_CHANNEL_ID=ton_channel_gratuit_id           # Gratuit (vitrine)
# 🟢 Standard 4.90€ : conf ≥ 88, foot, cote réelle ARJEL ≥ 1.50, max 3/jour
# Le bot doit être ADMINISTRATEUR du canal, avec le droit d'inviter (lien d'accès abonnés).
TELEGRAM_STANDARD_CHANNEL_ID=ton_standard_channel_id
# 🟣 Premium 9.90€ : conf ≥ 90, foot, cote réelle ARJEL ≥ 1.50, max 10/jour
TELEGRAM_PREMIUM_CHANNEL_ID=ton_premium_channel_id
# 🟠 Elite 19.90€ : conf ≥ 90, foot/hockey/baseball/basket, cote ≥ 1.50, max 30/jour
# Standard et Elite : laisser vide = repli automatique sur Premium (rien ne casse).
TELEGRAM_ELITE_CHANNEL_ID=ton_elite_channel_id
TELEGRAM_ADMIN_CHAT_ID=ton_admin_chat_id             # Hermès (admin)
HERMES_ADMIN_TLM_BOT=ton_hermes_admin_bot

# ═══ Stripe (paiements) ═══
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_PRICE_ID_STANDARD=price_xxx
STRIPE_PRICE_ID_PREMIUM=price_xxx
STRIPE_PRICE_ID_VIP=price_xxx
STRIPE_PRICE_ID_ELITE=price_xxx

# ═══ Ancien (plus utilisé, remplacé par API-Football) ═══
# OPENAI_API_KEY=plus_necessaire_remplace_par_deepseek
# FOOTBALL_DATA_KEY=plus_necessaire_remplace_par_api_football
# SPORTS_API_KEY=plus_necessaire_remplace_par_api_football_key

# ═══ Accès testeur offert (Elite gratuit, durée limitée) ═══
# Permet de sortir l'email du code source et de fixer la fin d'accès.
TESTER_GRANT_EMAIL=email_du_testeur
TESTER_GRANT_EXPIRES=2026-09-22

# Analyse des sports hors football par le Concile. Laisser vide/0 : les marches
# disponibles (Over/Under 2.5 buts, BTTS, Match nul) ne correspondent pas au basket,
# au hockey ni au baseball, et produisent des analyses incoherentes. Mettre 1
# uniquement quand des marches par sport auront ete implementes.
AUTO_CONCILE_MULTISPORT=0

# Plafond journalier des tests a blanc (budget OpenRouter). 20 suffit : la promotion
# d'un challenger exige 50 picks resolus, soit moins de 3 jours d'echantillon.
SHADOW_DAILY_CAP=20
